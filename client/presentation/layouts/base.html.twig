<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}SportAdmin - Gestion Educativa{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/client/css/styles.css" rel="stylesheet">
  {% block head %}{% endblock %}
</head>
<body>
<script src="/client/js/config.js?v=20260610"></script>
<script src="/client/js/api.js?v=20260610"></script>
<!-- app.js: autenticación, fetch de perfil, institución y menú dinámico -->
<script src="/client/js/app.js?v=20260610"></script>

<!-- Overlay para móviles -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<!-- Sidebar (partial reutilizable) -->
{% include 'partials/sidebar.html.twig' %}

<!-- ===== MAIN CONTENT ===== -->
<div class="main-content">

  <!-- Topbar -->
  <div class="topbar d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3 min-w-0 flex-grow-1">
      <button class="btn btn-sm btn-outline-secondary d-lg-none flex-shrink-0" type="button" onclick="toggleSidebar()" aria-label="Abrir menú">
        <i class="bi bi-list fs-5"></i>
      </button>
      <div class="page-heading min-w-0">
        <h5 class="page-heading-title mb-0 fw-bold">{% block page_title %}Panel{% endblock %}</h5>
      </div>
      <!-- Nombre/logo de institución se carga vía JS fetch a ?api=institucion -->
      <div class="institution-chip d-flex align-items-center gap-2 flex-shrink-0">
        <img src="/assets/logo/logotipo.jpg" class="institution-chip-logo" id="topbar-institucion-logo" alt="Logo de la institución" onerror="this.onerror=null;this.src='/assets/logo/logotipo.jpg';">
        <span class="badge rounded-pill institution-chip-name d-none d-sm-inline" id="topbar-institucion-badge"></span>
      </div>
    </div>
    <div class="topbar-actions d-flex align-items-center gap-2 ms-auto">
      <!-- Botón toggle de tema -->
      <button class="btn btn-sm btn-outline-secondary" type="button" onclick="toggleTheme()" title="Cambiar tema" aria-label="Cambiar tema">
        <i class="bi bi-moon-fill" id="theme-icon"></i>
      </button>
      <!-- Notificaciones: cumpleaños del mes -->
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary position-relative" type="button"
                id="notif-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                title="Cumpleaños del mes" aria-label="Cumpleaños">
          <i class="bi bi-bell-fill"></i>
          <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill d-none"
                style="font-size:.55rem;padding:.25em .45em;min-width:1.1em;"></span>
        </button>
        <div class="dropdown-menu dropdown-menu-end p-0 shadow-lg"
             style="width:315px;max-width:95vw;border:1px solid var(--app-border);background:var(--card-bg);border-radius:.75rem;overflow:hidden;">
          <div class="d-flex align-items-center justify-content-between px-3 py-2"
               style="background:var(--app-surface);border-bottom:1px solid var(--app-border);">
            <span class="fw-semibold small" style="color:var(--app-text);">
              <i class="bi bi-cake2-fill me-1" style="color:var(--brand-color);"></i>Cumpleaños
            </span>
            <span id="notif-mes" class="badge" style="background:var(--brand-color);color:var(--brand-text);font-size:.62rem;"></span>
          </div>
          <div id="notif-list" style="max-height:370px;overflow-y:auto;"></div>
        </div>
      </div>
      <!-- Dropdown de usuario (nombre cargado via JS fetch a ?api=profile) -->
      <div class="dropdown">
        <button class="btn d-flex align-items-center gap-2 p-1" type="button" data-bs-toggle="dropdown">
          <div class="avatar-circle" id="topbar-avatar">U</div>
          <span class="d-none d-md-inline fw-semibold small" id="topbar-username">Cargando...</span>
          <i class="bi bi-chevron-down small"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><a class="dropdown-item" href="/configuracion"><i class="bi bi-person me-2"></i>Mi perfil</a></li>
          <li><a class="dropdown-item" href="/configuracion"><i class="bi bi-gear me-2"></i>Configuración</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="bi bi-box-arrow-left me-2"></i>Cerrar sesión</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Contenido de la página -->
  <div class="container-fluid px-3 px-lg-4 py-3 py-lg-4">
    {% block content %}{% endblock %}
  </div>

</div><!-- /main-content -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
/* Helper global — usa el tema activo de la app */
window.swConfirm = function (title, text, confirmText) {
  var st = getComputedStyle(document.documentElement);
  var get = function (v) { return st.getPropertyValue(v).trim(); };
  return Swal.fire({
    title: title || '¿Estás seguro?',
    text: text || '',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: confirmText || 'Sí, continuar',
    cancelButtonText: 'Cancelar',
    reverseButtons: true,
    focusCancel: true,
    background: get('--card-bg'),
    color: get('--app-text'),
    confirmButtonColor: get('--brand-color'),
    cancelButtonColor: get('--app-surface-hover'),
  });
};
</script>
<script src="/client/js/theme.js"></script>
<script>
(function () {
  var MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  document.getElementById('notif-mes').textContent = MESES[new Date().getMonth()];

  var loaded = false;

  function initials(nombre) {
    var p = (nombre || '').trim().split(/\s+/);
    return ((p[0] || '')[0] || '') + ((p[1] || '')[0] || '');
  }

  function hashColor(str) {
    var palette = ['#e8b84b','#3b82f6','#10b981','#8b5cf6','#f97316','#06b6d4','#ec4899'];
    var h = 0;
    for (var i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) & 0xffff;
    return palette[h % palette.length];
  }

  function fmtFecha(fn) {
    if (!fn) return '';
    var p = fn.split('-');
    return p.length < 3 ? fn : (parseInt(p[2], 10) + ' ' + MESES[parseInt(p[1], 10) - 1]);
  }

  function buildCard(p) {
    var ini  = initials(p.nombre).toUpperCase();
    var col  = hashColor(p.nombre);
    var est  = p.tipo_nemonico === 'TIPO_EST';
    var dias = p.es_hoy
      ? '<strong style="color:var(--brand-color);">Hoy 🎂</strong>'
      : p.dias_para_cumple === 1
        ? '<span style="color:var(--warning-text);">Mañana</span>'
        : '<span style="color:var(--app-text-muted);">En ' + p.dias_para_cumple + ' días</span>';
    return '<div class="d-flex align-items-center gap-2 px-3 py-2" style="border-bottom:1px solid var(--app-border);">'
      + '<div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle fw-bold"'
      + ' style="width:32px;height:32px;font-size:.72rem;background:' + col + '22;color:' + col + ';border:1.5px solid ' + col + '55;">' + ini + '</div>'
      + '<div class="flex-grow-1 min-w-0">'
      +   '<div class="fw-semibold text-truncate" style="font-size:.81rem;color:var(--app-text);">' + p.nombre + '</div>'
      +   '<div style="font-size:.7rem;color:var(--app-text-muted);">'
      +     '<span class="badge me-1" style="font-size:.58rem;background:' + (est ? 'var(--info-bg)' : 'var(--success-bg)') + ';color:' + (est ? 'var(--info-text)' : 'var(--success-text)') + ';">' + (p.tipo || 'Persona') + '</span>'
      +     fmtFecha(p.fecha_nacimiento)
      +   '</div>'
      + '</div>'
      + '<div class="flex-shrink-0 text-end" style="font-size:.7rem;">' + dias + '</div>'
      + '</div>';
  }

  function section(titulo, arr) {
    if (!arr.length) return '';
    return '<div class="px-3 pt-2 pb-1" style="font-size:.64rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--app-text-faint);">'
      + titulo + '</div>' + arr.map(buildCard).join('');
  }

  function render(items) {
    var badge = document.getElementById('notif-badge');
    var list  = document.getElementById('notif-list');
    if (!items.length) {
      badge.classList.add('d-none');
      list.innerHTML = '<div class="text-center py-4" style="color:var(--app-text-muted);font-size:.82rem;">'
        + '<i class="bi bi-emoji-smile-fill fs-4 d-block mb-1" style="color:var(--app-text-faint);"></i>'
        + 'Sin cumpleaños pendientes<br>en el resto del mes</div>';
      return;
    }
    var hoy = items.filter(function(p){ return p.es_hoy; });
    var sem = items.filter(function(p){ return p.es_semana; });
    var res = items.filter(function(p){ return !p.es_hoy && !p.es_semana; });
    if (hoy.length) {
      badge.textContent = hoy.length;
      badge.style.background = '#ef4444';
      badge.style.color = '#fff';
    } else {
      badge.textContent = items.length;
      badge.style.background = '#64748b';
      badge.style.color = '#fff';
    }
    badge.classList.remove('d-none');
    list.innerHTML = section('Hoy', hoy) + section('Esta semana', sem) + section('Resto del mes', res);
  }

  document.getElementById('notif-btn').addEventListener('click', function () {
    if (loaded) return;
    loaded = true;
    document.getElementById('notif-list').innerHTML =
      '<div class="text-center py-4" style="color:var(--app-text-muted);font-size:.82rem;">'
      + '<div class="spinner-border spinner-border-sm mb-2"></div><br>Cargando...</div>';
    Cuspide.api.call('GET', CONFIG.ENDPOINTS.personas, 'cumpleanos')
      .then(function(data) { render(Array.isArray(data) ? data : []); })
      .catch(function() {
        document.getElementById('notif-list').innerHTML =
          '<div class="text-center py-3" style="color:var(--danger-text);font-size:.82rem;">'
          + '<i class="bi bi-exclamation-circle me-1"></i>Error al cargar</div>';
      });
  });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
