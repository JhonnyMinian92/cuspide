<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Huaquillas F.C. — Iniciar Sesión</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
		<link href="/client/css/styles.css" rel="stylesheet">
		<style>
			body {
				background: linear-gradient(135deg, #1a2235 0%, #243050 100%);
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.login-card {
				width: 100%;
				max-width: 420px;
				border-radius: 16px;
				border: none;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
			}
			.login-logo {
				width: 72px;
				height: 72px;
				background: #1a2235;
				border-radius: 16px;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 16px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
			}
			.login-logo span {
				font-size: 1.4rem;
				font-weight: 800;
				color: #e8b84b;
				letter-spacing: 1px;
			}
		</style>
	</head>
	<body>
		<div class="container px-3">
			<div class="card login-card mx-auto">
				<div
					class="card-body p-5">

					<!-- Logo -->
					<div class="text-center mb-2">
						<img src="/assets/logo/huaquillasfc.jpg" width="80" height="80" alt="Huaquillas F.C." style="border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.2);">
					</div>

					<!-- Alerta de error (oculta por defecto) -->
					<div class="alert alert-danger d-flex align-items-center d-none" id="login-alert" role="alert">
						<i class="bi bi-exclamation-triangle-fill me-2"></i>
						<span id="login-alert-msg">Credenciales inválidas. Inténtalo de nuevo.</span>
						<button type="button" class="btn-close ms-auto" onclick="document.getElementById('login-alert').classList.add('d-none')"></button>
					</div>

					<!-- Formulario de login -->
					<form id="login-form" onsubmit="handleLogin(event)">
						<div class="mb-3">
							<label for="username" class="form-label fw-semibold">Usuario</label>
							<div class="input-group">
								<span class="input-group-text">
									<i class="bi bi-person-fill"></i>
								</span>
								<input type="text" class="form-control" id="username" placeholder="usuario" required autocomplete="username">
							</div>
						</div>

						<div class="mb-3">
							<label for="password" class="form-label fw-semibold">Contraseña</label>
							<div class="input-group">
								<span class="input-group-text">
									<i class="bi bi-lock-fill"></i>
								</span>
								<input type="password" class="form-control" id="password" placeholder="••••••••" required autocomplete="current-password">
								<button class="btn btn-outline-secondary" type="button" id="togglePassword" onclick="togglePasswordVisibility()">
									<i class="bi bi-eye" id="pwdIcon"></i>
								</button>
							</div>
						</div>

						<div class="d-flex justify-content-end mb-4">
							<a href="#" class="text-decoration-none small" style="color: var(--brand-color);">¿Olvidaste tu contraseña?</a>
						</div>

						<button type="submit" class="btn btn-brand w-100 py-2 fw-semibold" id="btn-login">
							<i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
						</button>
					</form>

				</div>
			</div>
		</div>

		 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<!-- cifrar.js: cifrado RSA del payload de login -->
		 <script src="/client/js/cifrar.js"></script>
		 <script>
		    // Si ya hay token válido, redirigir al dashboard
		    if (localStorage.getItem('token')) {
		      window.location.href = '/dashboard';
		    }
		
		    function togglePasswordVisibility() {
		      var pwd = document.getElementById('password');
		      var icon = document.getElementById('pwdIcon');
		      if (pwd.type === 'password') {
		        pwd.type = 'text';
		        icon.className = 'bi bi-eye-slash';
		      } else {
		        pwd.type = 'password';
		        icon.className = 'bi bi-eye';
		      }
		    }
		
		    /**
		     * handleLogin: captura el evento submit del formulario, cifra las credenciales
		     * con cifrar.js (RSA-OAEP) y hace POST a /app/controllers/api/auth/index.php.
		     * Si el servidor devuelve un token, lo guarda en localStorage y redirige a /dashboard.
		     */
		    async function handleLogin(event) {
		      event.preventDefault();
		
		      const username = document.getElementById('username').value.trim();
		      const password = document.getElementById('password').value;
		      const btn = document.getElementById('btn-login');
		      const alert = document.getElementById('login-alert');
		
		      // Ocultar alerta previa y deshabilitar botón mientras procesa
		      alert.classList.add('d-none');
		      btn.disabled = true;
		      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Verificando...';
		
		      try {
		        // Cifrar el payload con cifrar.js (RSA-OAEP con llave pública CUSPIDE_PUBLIC_KEY)
		        const encryptedPayload = await cifrarLogin(username, password);
		
            console.log("Cifrado:",encryptedPayload);
		        // POST al endpoint de autenticación con el cuerpo cifrado
		        const response = await fetch('/app/controllers/api/auth/index.php', {
		          method: 'POST',
		          headers: { 'Content-Type': 'application/json' },
		          body: JSON.stringify(encryptedPayload),
		        });
		        console.log("Res:",response);
		
		        const result = await response.json();
		
		        if (result.status === 'success' && result.data && result.data.token) {
		          // Guardar token JWT en localStorage para peticiones posteriores
		          localStorage.setItem('token', result.data.token);
		          window.location.href = '/dashboard';
		        } else {
		          showLoginError(result.message || 'Credenciales inválidas. Inténtalo de nuevo.');
		        }
		      } catch (err) {
		        showLoginError('Error de conexión. Por favor inténtalo más tarde.');
		      } finally {
		        btn.disabled = false;
		        btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión';
		      }
		    }
		
		    function showLoginError(msg) {
		      const alertEl = document.getElementById('login-alert');
		      document.getElementById('login-alert-msg').textContent = msg;
		      alertEl.classList.remove('d-none');
		    }
		  </script>
	</body>
</html>
