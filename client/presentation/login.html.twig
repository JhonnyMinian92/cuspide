<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>SportAdmin — Acceso</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
		<link href="/client/css/styles.css" rel="stylesheet">
		<style>
			body {
				background: linear-gradient(135deg, #0f1624 0%, #1a2235 50%, #243050 100%);
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.login-wrapper {
				width: 100%;
				max-width: 440px;
				padding: 1rem;
			}
			.login-card {
				border-radius: 20px;
				border: none;
				box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
				overflow: hidden;
			}
			.login-card-header {
				background: linear-gradient(135deg, #1a2235 0%, #243050 100%);
				padding: 2.5rem 2rem 1.5rem;
				text-align: center;
				border-bottom: 1px solid rgba(232,184,75,.15);
			}
			.login-logo {
				width: 84px;
				height: 84px;
				background: rgba(232,184,75,.12);
				border: 2px solid rgba(232,184,75,.3);
				border-radius: 20px;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 1rem;
				box-shadow: 0 8px 24px rgba(232,184,75,.2);
			}
			.login-logo-icon {
				font-size: 2.2rem;
				color: #e8b84b;
			}
			.login-brand-name {
				font-size: 1.75rem;
				font-weight: 800;
				color: #e8b84b;
				letter-spacing: 2px;
				text-transform: uppercase;
				margin-bottom: .2rem;
			}
			.login-brand-sub {
				font-size: .8rem;
				color: rgba(255,255,255,.45);
				letter-spacing: 3px;
				text-transform: uppercase;
			}
			.login-card-body {
				background: var(--app-bg, #fff);
				padding: 2rem;
			}
			.form-label {
				font-size: .85rem;
				font-weight: 600;
				margin-bottom: .3rem;
			}
		</style>
	</head>
	<body>
		<div class="login-wrapper">
			<div class="card login-card">

				<!-- Header con marca -->
				<div class="login-card-header">
					<div class="login-logo">
						<img src="/assets/logo/isotipo.png" alt="SportAdmin" style="height: 75px; width: 75px; border-radius: 20px;" class="login-logo-icon">
					</div>
					<div class="login-brand-name">SportAdmin</div>
					<div class="login-brand-sub">Sistema de Gestión Deportiva</div>
				</div>

				<!-- Cuerpo del formulario -->
				<div class="login-card-body">

					<!-- Alerta de error -->
					<div class="alert alert-danger d-flex align-items-center d-none mb-3" id="login-alert" role="alert">
						<i class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0"></i>
						<span id="login-alert-msg">Credenciales inválidas. Inténtalo de nuevo.</span>
						<button type="button" class="btn-close ms-auto" id="login-alert-close" aria-label="Cerrar alerta"></button>
					</div>

					<form id="login-form">
						<div class="mb-3">
							<label for="username" class="form-label">Usuario</label>
							<div class="input-group">
								<span class="input-group-text">
									<i class="bi bi-person-fill"></i>
								</span>
								<input type="text" class="form-control" id="username" placeholder="usuario" required autocomplete="username">
							</div>
						</div>

						<div class="mb-4">
							<label for="password" class="form-label">Contraseña</label>
							<div class="input-group">
								<span class="input-group-text">
									<i class="bi bi-lock-fill"></i>
								</span>
								<input type="password" class="form-control" id="password" placeholder="••••••••" required autocomplete="current-password">
								<button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="Mostrar u ocultar contraseña">
									<i class="bi bi-eye" id="pwdIcon"></i>
								</button>
							</div>
						</div>

						<button type="submit" class="btn btn-brand w-100 py-2 fw-bold" id="btn-login">
							<i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
						</button>
					</form>

					<div class="text-center mt-3">
						<small class="text-muted">SportAdmin &copy; 2025 · Gestión Deportiva Profesional</small>
					</div>

				</div>
			</div>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<script src="/client/js/config.js"></script>
		<script src="/client/js/cifrar.js"></script>
		<script src="/client/js/api.js"></script>
		<script src="/client/js/login.js"></script>
	</body>
</html>
