<!-- ===== SIDEBAR =====
     El sidebar muestra la marca/logo de institución (cargado via JS fetch a ?api=institucion),
     el menú dinámico (via JS fetch a ?api=menu) y el perfil del usuario (via JS fetch a ?api=profile).
-->
<nav class="sidebar" id="sidebar">

  <!-- Marca / Logo de institución -->
  <div class="sidebar-brand d-flex align-items-center gap-3">
    <div class="sidebar-logo-box flex-shrink-0" id="sidebar-logo-box">
      <img src="/assets/logo/huaquillasfc.jpg" class="img-fluid w-100 h-100 object-fit-cover" id="sidebar-logo-img" alt="Huaquillas F.C." onerror="this.onerror=null;this.src='/assets/logo/huaquillasfc.jpg';">
    </div>
    <!-- Nombre de la institución; se actualiza via loadInstitucion() en app.js -->
    <div class="brand-name" id="sidebar-institucion-nombre">Huaquillas<br>Fútbol Club</div>
  </div>

  <!-- Navegación dinámica: se renderiza via loadMenu() en app.js -->
  <ul class="nav flex-column py-2 flex-grow-1" id="sidebar-menu">
    <!-- Menú estático de respaldo; será reemplazado por app.js -->
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'dashboard' %}active{% endif %}" href="/dashboard">
        <i class="bi bi-house-fill me-2"></i>Dashboard
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'personas' %}active{% endif %}" href="/personas">
        <i class="bi bi-person-lines-fill me-2"></i>Personas
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'matriculas' %}active{% endif %}" href="/matriculas">
        <i class="bi bi-journal-check me-2"></i>Matrículas
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'pagos' %}active{% endif %}" href="/pagos">
        <i class="bi bi-cash-coin me-2"></i>Pagos
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'facturas' %}active{% endif %}" href="/facturas">
        <i class="bi bi-receipt me-2"></i>Facturas
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'cuentascobrar' %}active{% endif %}" href="/cuentascobrar">
        <i class="bi bi-currency-dollar me-2"></i>Cuentas x Cobrar
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'asignaturas' %}active{% endif %}" href="/asignaturas">
        <i class="bi bi-book-fill me-2"></i>Asignaturas
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'actividades' %}active{% endif %}" href="/actividades">
        <i class="bi bi-trophy-fill me-2"></i>Actividades
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'horarios' %}active{% endif %}" href="/horarios">
        <i class="bi bi-calendar3-fill me-2"></i>Horarios
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'productos' %}active{% endif %}" href="/productos">
        <i class="bi bi-bag-fill me-2"></i>Productos
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'ventas' %}active{% endif %}" href="/ventas">
        <i class="bi bi-cart-fill me-2"></i>Ventas
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link {% if currentPage == 'instituciones' %}active{% endif %}" href="/instituciones">
        <i class="bi bi-building-fill me-2"></i>Instituciones
      </a>
    </li>
    <li class="nav-item">
