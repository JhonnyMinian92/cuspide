<!-- ===== SIDEBAR ===== -->
<nav class="sidebar" id="sidebar">

  <!-- Marca / Logo de institución -->
  <div class="sidebar-brand d-flex align-items-center gap-3">
    <div class="sidebar-logo-box flex-shrink-0" id="sidebar-logo-box">
      <img src="/assets/logo/logotipo.jpg" class="img-fluid w-100 h-100 object-fit-cover" id="sidebar-logo-img" alt="Logo de la institución" onerror="this.onerror=null;this.src='/assets/logo/logotipo.jpg';">
    </div>
    <div class="brand-name" id="sidebar-institucion-nombre"></div>
  </div>

  <!-- Navegación dinámica: renderizada via loadMenu() en app.js -->
  <ul class="nav flex-column py-2 flex-grow-1 sidebar-menu-loading" id="sidebar-menu" aria-busy="true">
    {% for i in 1..8 %}
    <li class="nav-item sidebar-skeleton-item" aria-hidden="true">
      <span class="sidebar-skeleton-icon"></span>
      <span class="sidebar-skeleton-text"></span>
    </li>
    {% endfor %}
  </ul>

  <!-- Footer: avatar + nombre + collapse toggle -->
  <div class="sidebar-footer">
    <div class="d-flex align-items-center gap-2 px-2 mb-2 user-info-row">
      <div class="avatar-circle flex-shrink-0" id="sidebar-avatar">U</div>
      <span class="flex-grow-1 text-truncate" style="color:var(--sidebar-text);font-size:0.85rem;" id="sidebar-username">Cargando...</span>
      <button type="button" id="btn-sidebar-collapse"
        class="btn btn-sm flex-shrink-0"
        style="color:var(--sidebar-text);background:transparent;border:1px solid var(--sidebar-border);padding:3px 6px;border-radius:6px;"
        title="Colapsar menú" aria-label="Colapsar menú">
        <i class="bi bi-layout-sidebar-reverse" id="collapse-icon"></i>
      </button>
    </div>
    <a href="#" onclick="logout()" class="nav-link text-danger d-flex align-items-center gap-2 px-2 salir-link">
      <i class="bi bi-box-arrow-left"></i><span class="salir-text">Salir</span>
    </a>
  </div>

</nav>

<script>
(function () {
  var STORAGE_KEY = 'sidebar_collapsed';
  var body        = document.body;
  var btn         = document.getElementById('btn-sidebar-collapse');
  var icon        = document.getElementById('collapse-icon');

  function applyCollapsed(collapsed) {
    if (collapsed) {
      body.classList.add('sidebar-collapsed');
      icon.className = 'bi bi-layout-sidebar';
      btn.title = 'Expandir menú';
    } else {
      body.classList.remove('sidebar-collapsed');
      icon.className = 'bi bi-layout-sidebar-reverse';
      btn.title = 'Colapsar menú';
    }
  }

  // Restore from localStorage
  applyCollapsed(localStorage.getItem(STORAGE_KEY) === '1');

  btn.addEventListener('click', function () {
    var nowCollapsed = body.classList.contains('sidebar-collapsed');
    localStorage.setItem(STORAGE_KEY, nowCollapsed ? '0' : '1');
    applyCollapsed(!nowCollapsed);
  });
})();
</script>
