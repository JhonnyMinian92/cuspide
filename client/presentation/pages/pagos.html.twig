    +'<div class="center"><div class="title">'+e2(instNombre)+'</div><div class="sub">VENTA EXTERNA</div></div>'
    +'<hr class="div">'
    +'<div class="row2"><span><b>N°:</b></span><span>'+e2(v.numero)+'</span></div>'
    +'<div class="row2"><span><b>Fecha:</b></span><span>'+e2(new Date(v.fecha).toLocaleDateString())+'</span></div>'
    +'<div class="row2"><span><b>Cliente:</b></span><span>'+e2(c.nombre||'Anónimo')+'</span></div>'
    +(c.identificacion&&c.identificacion!=='—'?'<div class="row2"><span><b>CI:</b></span><span>'+e2(c.identificacion)+'</span></div>':'')
    +'<hr class="div">'
    +'<div class="row2"><span><b>Forma de Pago:</b></span><span>'+e2(v.forma_pago||'—')+'</span></div>'
    +(v.referencia?'<div class="row2"><span><b>Referencia:</b></span><span>'+e2(v.referencia)+'</span></div>':'')
    +'<hr class="div">'
    +'<table><tbody>'+detRows+'</tbody></table>'
    +'<hr class="div">'
    +'<table><tbody>'
    +(v.descuento>0?'<tr><td>Descuento</td><td style="text-align:right;">-'+m2(v.descuento)+'</td></tr>':'')
    +(v.impuesto>0?'<tr><td>Impuesto</td><td style="text-align:right;">'+m2(v.impuesto)+'</td></tr>':'')
    +'<tr class="total-row"><td>TOTAL</td><td style="text-align:right;">'+m2(v.total)+'</td></tr>'
    +'</tbody></table>'
    +'<div class="footer">&#9474; ¡Gracias por su compra! &#9474;</div>'
    +'</div></body></html>';
}

function imprimirTicketPago() {
  var html;
  if (currentVentaExtDetalle) {
    html = buildVentaExtTicketHTML(currentVentaExtDetalle, false);
  } else if (currentPagoDetalle) {
    html = buildPagoTicketHTML(currentPagoDetalle, false);
  } else { return; }
  var win = window.open('', '_blank', 'width=620,height=900,scrollbars=yes');
  win.document.write(html);
  win.document.close();
  win.focus();
  setTimeout(function() { win.print(); }, 350);
}

function descargarPDFPago() {
  var html;
  if (currentVentaExtDetalle) {
    html = buildVentaExtTicketHTML(currentVentaExtDetalle, true);
  } else if (currentPagoDetalle) {
    html = buildPagoTicketHTML(currentPagoDetalle, true);
  } else { return; }
  var win = window.open('', '_blank', 'width=700,height=900,scrollbars=yes');
  win.document.write(html);
  win.document.close();
  win.focus();
  setTimeout(function() { win.print(); }, 350);
}

/* ════════════════════════════════════════
   ÚLTIMOS 20 COBROS
═══════════════════════════════════════ */
function loadRecentPagos() {
  document.getElementById('recent-loading').classList.remove('d-none');
  document.getElementById('recent-container').classList.add('d-none');
  document.getElementById('recent-empty').classList.add('d-none');

  apiGet(CONFIG.ENDPOINTS.pagos, 'recent', { institucion: instId })
    .then(function(data) {
      renderRecentPagos(Array.isArray(data) ? data : []);
    })
    .catch(function(err) {
      var el = document.getElementById('recent-loading');
      el.innerHTML = '<div class="text-danger small">' + esc(err.message || 'Error al cargar cobros.') + '</div>';
      el.classList.remove('d-none');
    })
    .finally(function() {
      document.getElementById('recent-loading').classList.add('d-none');
    });
}

function renderRecentPagos(items) {
  if (!items.length) {
    document.getElementById('recent-empty').classList.remove('d-none');
    return;
  }
  var tbody = document.getElementById('recent-tbody');
  tbody.innerHTML = items.map(function(p) {
    var esAnulado   = parseInt(p.estado_id || 1) === 4;
    var esExterna   = p.tipo_origen === 'externa';
    var estadoBadge = esAnulado
      ? '<span class="badge bg-danger rounded-pill" style="font-size:.7rem;">Anulado</span>'
      : '<span class="badge bg-success rounded-pill" style="font-size:.7rem;">Activo</span>';
    var extBadge = esExterna
      ? ' <span class="badge rounded-pill" style="font-size:.65rem;background:var(--app-border);color:var(--app-text-muted);">Ext</span>'
      : '';
    var verBtn = esExterna
      ? '<button type="button" class="btn btn-sm btn-outline-secondary" title="Ver detalle" '
          + 'onclick="verDetalleVentaExt(' + p.id + ')">'
          + '<i class="bi bi-eye"></i>'
          + '</button>'
      : '<button type="button" class="btn btn-sm btn-outline-secondary" title="Ver comprobante" '
          + 'onclick="verDetallePagoFromRecent(' + p.id + ',\'' + esc(p.nombre_cliente) + '\',\'' + esc(p.identificacion) + '\')">'
          + '<i class="bi bi-eye"></i>'
          + '</button>';
    return '<tr>'
      + '<td style="font-size:.8rem;white-space:nowrap;">' + esc(p.fecha) + '</td>'
      + '<td><code style="font-size:.78rem;">' + esc(p.numero) + '</code>' + extBadge + '</td>'
      + '<td>'
      +   '<div class="fw-semibold" style="font-size:.82rem;">' + esc(p.nombre_cliente) + '</div>'
      +   '<code style="font-size:.7rem;">' + esc(p.identificacion) + '</code>'
      + '</td>'
      + '<td class="text-end fw-bold">' + fmt(p.monto) + '</td>'
      + '<td>' + estadoBadge + '</td>'
      + '<td>' + verBtn + '</td>'
      + '</tr>';
  }).join('');
  document.getElementById('recent-container').classList.remove('d-none');
}

function verDetalleVentaExt(id) {
  var modalEl = document.getElementById('modal-pago-detalle');
  var body    = document.getElementById('modal-pago-detalle-body');
  var lbl     = document.getElementById('modal-pago-detalle-label');

  currentPagoDetalle     = null;
  currentVentaExtDetalle = null;
  document.getElementById('btn-imprimir-pago').disabled = true;
  document.getElementById('btn-descargar-pago-pdf').disabled = true;
  body.innerHTML = '<div class="text-center py-5"><span class="spinner-border text-primary"></span>'
    + '<p class="mt-2 text-muted">Cargando detalle...</p></div>';

  bootstrap.Modal.getOrCreateInstance(modalEl).show();

  apiGet(CONFIG.ENDPOINTS.ventas, 'detail_externa', { id: id })
    .then(function(det) {
      lbl.innerHTML = 'Venta Externa: <code>' + esc(det.venta.numero) + '</code>';
      currentVentaExtDetalle = det;
      body.innerHTML = buildVentaExtDetalleHTML(det);
      document.getElementById('btn-imprimir-pago').disabled = false;
      document.getElementById('btn-descargar-pago-pdf').disabled = false;
    })
    .catch(function(err) {
      body.innerHTML = '<div class="alert alert-danger">' + esc(err.message || 'Error al cargar el detalle.') + '</div>';
    });
}

function verDetallePagoFromRecent(pagoId, nombre, cedula) {
  pagoCliente = { id: null, nombre: nombre, cedula: cedula, tipo: '' };
  verDetallePagoModal(pagoId);
}

document.getElementById('btn-refresh-recent').addEventListener('click', function() {
  loadRecentPagos();
});

/* ════════════════════════════════════════
   TAB PENDIENTES — Búsqueda por persona
═══════════════════════════════════════ */
var doPendientesPersonaSearch = debounce(function(q) {
  if (q.length < 2) {
    document.getElementById('pendientes-persona-results').classList.add('d-none');
    return;
  }
  document.getElementById('pendientes-persona-spinner').classList.remove('d-none');
  apiGet(CONFIG.ENDPOINTS.personas, 'search', { q: q, institucion: instId })
    .then(function(data) { renderPendientesPersonaList(Array.isArray(data) ? data : []); })
    .catch(function() { document.getElementById('pendientes-persona-results').classList.add('d-none'); })
    .finally(function() { document.getElementById('pendientes-persona-spinner').classList.add('d-none'); });
}, 300);

function renderPendientesPersonaList(items) {
  var wrap = document.getElementById('pendientes-persona-results');
  var list = document.getElementById('pendientes-persona-list');
  if (!items.length) { wrap.classList.add('d-none'); return; }
  wrap.classList.remove('d-none');
  list.innerHTML = items.map(function(p) {
    return '<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2" '
      + 'onclick="selectPersonaPendienteFiltro(\'' + esc(p.identificacion) + '\',\'' + esc(p.nombre_completo) + '\')">'
      + '<div><div class="fw-semibold small">' + esc(p.nombre_completo) + '</div><code class="small">' + esc(p.identificacion) + '</code></div>'
      + '<span class="badge bg-secondary rounded-pill">' + esc(p.tipo) + '</span>'
      + '</button>';
  }).join('');
}

function selectPersonaPendienteFiltro(identificacion, nombre) {
  personaFiltroIdentificacion = identificacion;
  personaFiltroNombre = nombre;
  document.getElementById('pendientes-persona-results').classList.add('d-none');
  document.getElementById('pendientes-persona-search').value = '';
  document.getElementById('pendientes-persona-nombre-activa').textContent = nombre;
  document.getElementById('pendientes-persona-cedula-activa').textContent = identificacion;
  document.getElementById('pendientes-persona-activa').classList.remove('d-none');
  applyFiltroYRender();
}

document.getElementById('pendientes-persona-search').addEventListener('input', function() {
  doPendientesPersonaSearch(this.value.trim());
});
document.getElementById('pendientes-persona-search').addEventListener('keydown', function(e) {
  if (e.key === 'Escape') document.getElementById('pendientes-persona-results').classList.add('d-none');
});
document.getElementById('btn-limpiar-persona-filtro').addEventListener('click', function() {
  personaFiltroIdentificacion = null;
  personaFiltroNombre = null;
  document.getElementById('pendientes-persona-activa').classList.add('d-none');
  applyFiltroYRender();
});

/* ── Init ── */
document.addEventListener('DOMContentLoaded', function() {
  instId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || instId;
  checkAuth();
  Cuspide.api.institucion().then(function(d) { if (d && d.nombre) instNombre = d.nombre; }).catch(function() {});
  loadFormasPago();
  loadPendientes();
  loadRecentPagos();
});
</script>
{% endblock %}
