function verDetallePagoModal(pagoId) {
  var modalEl = document.getElementById('modal-pago-detalle');
  var body    = document.getElementById('modal-pago-detalle-body');
  var lbl     = document.getElementById('modal-pago-detalle-label');

  currentPagoDetalle     = null;
  currentVentaExtDetalle = null;
  document.getElementById('btn-imprimir-pago').disabled = true;
  document.getElementById('btn-descargar-pago-pdf').disabled = true;
  body.innerHTML = '<div class="text-center py-5"><span class="spinner-border text-primary"></span><p class="mt-2 text-muted">Cargando comprobante...</p></div>';

  bootstrap.Modal.getOrCreateInstance(modalEl).show();

  apiGet(CONFIG.ENDPOINTS.pagos, 'detail', { id: pagoId })
    .then(function(det) {
      lbl.innerHTML = 'Comprobante: <code>' + esc(det.numero) + '</code>';
      currentPagoDetalle = det;
      body.innerHTML = buildPagoDetalleHTML(det);
      document.getElementById('btn-imprimir-pago').disabled = false;
      document.getElementById('btn-descargar-pago-pdf').disabled = false;
    })
    .catch(function(err) {
      body.innerHTML = '<div class="alert alert-danger">' + esc(err.message || 'Error al cargar el comprobante.') + '</div>';
    });
}

