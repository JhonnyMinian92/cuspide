{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'reportes' %}

{% block title %}SportAdmin - Reportes y Estadísticas{% endblock %}
{% block page_title %}Reportes y Estadísticas{% endblock %}

{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ── Toast ── */
.toast-notification{position:fixed;top:1.2rem;right:1.2rem;z-index:9999;padding:.75rem 1.25rem;border-radius:.5rem;color:#fff;font-size:.875rem;opacity:0;transform:translateX(110%);transition:all .3s ease;max-width:340px;box-shadow:0 4px 20px rgba(0,0,0,.35);}
.toast-notification.show{opacity:1;transform:translateX(0);}
.toast-success{background:#198754;}.toast-error{background:#dc3545;}.toast-warning{background:#d97706;}.toast-info{background:#0d6efd;}

/* ── KPI Cards ── */
.rpt-kpi-card{border:1px solid var(--card-border);background:var(--card-bg);border-radius:12px;padding:1.25rem 1.5rem;display:flex;align-items:center;gap:1rem;box-shadow:var(--card-shadow);transition:transform .15s ease;}
.rpt-kpi-card:hover{transform:translateY(-2px);}
.rpt-kpi-icon{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;}
.rpt-kpi-label{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--app-text-muted);margin-bottom:.2rem;font-weight:600;}
.rpt-kpi-value{font-size:1.6rem;font-weight:700;line-height:1;color:var(--app-text);}
.rpt-kpi-sub{font-size:.75rem;color:var(--app-text-muted);margin-top:.2rem;}

/* ── Tabs ── */
.rpt-tabs .nav-link{color:var(--app-text-muted);border-radius:8px 8px 0 0;font-weight:500;font-size:.875rem;padding:.5rem .9rem;border:1px solid transparent;border-bottom:none;}
.rpt-tabs .nav-link:hover{color:var(--app-text);background:var(--app-surface-soft);}
.rpt-tabs .nav-link.active{color:var(--brand-color);background:var(--card-bg);border-color:var(--card-border);border-bottom-color:var(--card-bg);}

/* ── Chart wrapper ── */
.chart-canvas-wrap{position:relative;height:280px;}
.chart-canvas-wrap canvas{max-height:280px;}

/* ── Labels ── */
.section-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:var(--app-text-muted);font-weight:700;margin-bottom:.5rem;}

/* ── Summary mini-cards ── */
.rpt-summary-card{background:var(--app-surface-soft);border:1px solid var(--app-border);border-radius:10px;padding:.85rem 1.1rem;}
.rpt-summary-card .val{font-size:1.25rem;font-weight:700;color:var(--app-text);}
.rpt-summary-card .lbl{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:var(--app-text-muted);font-weight:600;}

/* ── Attendance row highlight ── */
tr.rpt-row-warn td{background:rgba(239,68,68,.07)!important;}
tr.rpt-row-warn td:first-child{border-left:3px solid #ef4444;}
tr.rpt-row-ok td{background:rgba(34,197,94,.05)!important;}
tr.rpt-row-ok td:first-child{border-left:3px solid #22c55e;}

/* ── Header bar ── */
.rpt-header{background:var(--card-bg);border:1px solid var(--card-border);border-radius:12px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;box-shadow:var(--card-shadow);}

/* ── Export btn ── */
.btn-export{font-size:.78rem;padding:.3rem .7rem;}

/* ── Loading spinner row ── */
.tab-loading{display:flex;align-items:center;justify-content:center;min-height:160px;color:var(--app-text-muted);}

/* ── Matricula detail modal ── */
#mat-detail-modal .modal-header{background:var(--card-bg);border-bottom:1px solid var(--card-border);}
#mat-detail-modal .modal-body{background:var(--card-bg);}
#mat-detail-modal .modal-footer{background:var(--card-bg);border-top:1px solid var(--card-border);}
</style>
{% endblock %}

{% block content %}

<!-- ── Page header ── -->
<div class="rpt-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
  <div>
    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
      <i class="bi bi-bar-chart-fill" style="color:var(--brand-color);"></i>
      Reportes y Estadísticas
    </h5>
    <p class="text-muted small mb-0">Análisis financiero y operativo institucional</p>
  </div>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <div class="align-self-end">
      <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-rpt-refresh" title="Actualizar datos">
        <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
      </button>
    </div>
  </div>
</div>

<!-- ── KPI Row ── -->
<div class="row g-3 mb-4" id="rpt-kpi-row">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="rpt-kpi-card">
      <div class="rpt-kpi-icon" style="background:rgba(59,130,246,.15);">
        <i class="bi bi-people-fill" style="color:#3b82f6;"></i>
      </div>
      <div>
        <div class="rpt-kpi-label">Total Alumnos</div>
        <div class="rpt-kpi-value" id="kpi-alumnos"><span class="spinner-border spinner-border-sm"></span></div>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="rpt-kpi-card">
      <div class="rpt-kpi-icon" style="background:rgba(34,197,94,.15);">
        <i class="bi bi-cash-coin" style="color:#22c55e;"></i>
      </div>
      <div>
        <div class="rpt-kpi-label">Ingresos del Mes</div>
        <div class="rpt-kpi-value" id="kpi-ingresos"><span class="spinner-border spinner-border-sm"></span></div>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="rpt-kpi-card">
      <div class="rpt-kpi-icon" style="background:rgba(168,85,247,.15);">
        <i class="bi bi-graph-up-arrow" style="color:#a855f7;"></i>
      </div>
      <div>
        <div class="rpt-kpi-label">Balance del Mes</div>
        <div class="rpt-kpi-value" id="kpi-balance"><span class="spinner-border spinner-border-sm"></span></div>
      </div>
    </div>
  </div>
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="rpt-kpi-card">
      <div class="rpt-kpi-icon" style="background:rgba(245,158,11,.15);">
        <i class="bi bi-hourglass-split" style="color:#f59e0b;"></i>
      </div>
      <div>
        <div class="rpt-kpi-label">Ventas Pendientes (Mes)</div>
        <div class="rpt-kpi-value" id="kpi-pendientes"><span class="spinner-border spinner-border-sm"></span></div>
      </div>
    </div>
  </div>
</div>

<!-- ── Main card with tabs ── -->
<div class="card chart-card p-0" style="border-radius:12px;overflow:hidden;">

  <div class="px-3 pt-3" style="border-bottom:1px solid var(--card-border);background:var(--card-bg);">
    <ul class="nav rpt-tabs" id="rpt-tab-nav" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-pagos-btn" data-bs-toggle="tab" data-bs-target="#tab-pagos" type="button" role="tab">
          <i class="bi bi-receipt me-1"></i>Pagos
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-ventas-btn" data-bs-toggle="tab" data-bs-target="#tab-ventas" type="button" role="tab">
          <i class="bi bi-cart3 me-1"></i>Ventas
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-matriculas-btn" data-bs-toggle="tab" data-bs-target="#tab-matriculas" type="button" role="tab">
          <i class="bi bi-journal-bookmark me-1"></i>Matrículas
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-gastos-btn" data-bs-toggle="tab" data-bs-target="#tab-gastos" type="button" role="tab">
          <i class="bi bi-wallet2 me-1"></i>Gastos
        </button>
      </li>
    </ul>
  </div>

  <div class="tab-content p-3 p-lg-4" id="rpt-tab-content" style="background:var(--card-bg);">

    <!-- ══════════════════════════════════════
         TAB: PAGOS REALIZADOS
    ══════════════════════════════════════ -->
    <div class="tab-pane fade show active" id="tab-pagos" role="tabpanel">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div>
          <div class="section-label">Pagos Realizados</div>
          <h6 class="fw-bold mb-0">Últimos cobros registrados en la institución</h6>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div>
            <label for="pagos-fecha-desde" class="form-label mb-0" style="font-size: .75rem;">Desde</label>
            <input type="date" id="pagos-fecha-desde" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div>
            <label for="pagos-fecha-hasta" class="form-label mb-0" style="font-size: .75rem;">Hasta</label>
            <input type="date" id="pagos-fecha-hasta" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div class="align-self-end">
            <button type="button" class="btn btn-outline-secondary btn-export" onclick="exportReport('pagos')">
              <i class="bi bi-download me-1"></i>CSV
            </button>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Total Cobrado</div>
            <div class="val text-success" id="pagos-total-cobrado">—</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">N° Transacciones</div>
            <div class="val" id="pagos-num-pagos">—</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Saldo por Cobrar</div>
            <div class="val text-danger" id="pagos-total-pendiente">—</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Facturas Pendientes</div>
            <div class="val" id="pagos-num-pendiente">—</div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-xl-5">
          <div class="section-label">Cobrado por forma de pago</div>
          <div class="chart-canvas-wrap" id="pagos-chart-wrap">
            <div class="tab-loading" id="pagos-chart-loading">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando gráfico...
            </div>
            <canvas id="chart-pagos" class="d-none"></canvas>
          </div>
        </div>
        <div class="col-12 col-xl-7">
          <div id="pagos-error" class="alert alert-danger d-none"></div>
          <div class="table-responsive" style="max-height:380px;overflow-y:auto;">
            <table class="table table-hover align-middle mb-0" style="font-size:.83rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Estado</th>
                  <th>Cliente</th>
                  <th>Identificación</th>
                  <th>N° Pago</th>
                  <th>Fecha</th>
                  <th>Forma de Pago</th>
                  <th class="text-end">Monto</th>
                </tr>
              </thead>
              <tbody id="pagos-tbody">
                <tr><td colspan="7" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                </td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Sección pendientes -->
      <div class="mt-4 pt-3" style="border-top:1px solid var(--card-border);">
        <div class="section-label mb-2"><i class="bi bi-hourglass-split me-1 text-warning"></i>Ventas con Saldo Pendiente</div>
        <div id="pagos-pendientes-error" class="alert alert-danger d-none"></div>
        <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
          <table class="table table-hover align-middle mb-0" style="font-size:.83rem;">
            <thead class="table-light sticky-top">
              <tr>
                <th>Cliente</th>
                <th>N° Factura</th>
                <th>Tipo</th>
                <th>Fecha</th>
                <th class="text-end">Total</th>
                <th class="text-end">Saldo</th>
                <th class="text-center">% Pagado</th>
                <th>Origen</th>
              </tr>
            </thead>
            <tbody id="pagos-pendientes-tbody">
              <tr><td colspan="8" class="text-center text-muted py-4">
                <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
              </td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         TAB: VENTAS
    ══════════════════════════════════════ -->
    <div class="tab-pane fade" id="tab-ventas" role="tabpanel">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div>
          <div class="section-label">Ventas</div>
          <h6 class="fw-bold mb-0">Todas las ventas de productos, matrículas y servicios</h6>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div>
            <label for="ventas-fecha-desde" class="form-label mb-0" style="font-size: .75rem;">Desde</label>
            <input type="date" id="ventas-fecha-desde" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div>
            <label for="ventas-fecha-hasta" class="form-label mb-0" style="font-size: .75rem;">Hasta</label>
            <input type="date" id="ventas-fecha-hasta" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div class="align-self-end">
            <button type="button" class="btn btn-outline-secondary btn-export" onclick="exportReport('ventas')">
              <i class="bi bi-download me-1"></i>CSV
            </button>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Total Ventas</div>
            <div class="val" id="ventas-num">—</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Monto Total</div>
            <div class="val" id="ventas-total">—</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Cobrado</div>
            <div class="val text-success" id="ventas-cobrado">—</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rpt-summary-card">
            <div class="lbl">Saldo Pendiente</div>
            <div class="val text-danger" id="ventas-pendiente">—</div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-xl-4">
          <div class="section-label">Distribución por tipo</div>
          <div class="chart-canvas-wrap" id="ventas-chart-wrap">
            <div class="tab-loading" id="ventas-chart-loading">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando gráfico...
            </div>
            <canvas id="chart-ventas" class="d-none"></canvas>
          </div>
        </div>
        <div class="col-12 col-xl-8">
          <div id="ventas-error" class="alert alert-danger d-none"></div>
          <div class="table-responsive" style="max-height:380px;overflow-y:auto;">
            <table class="table table-hover align-middle mb-0" style="font-size:.83rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Estado</th>
                  <th>Cliente</th>
                  <th>N° Factura</th>
                  <th>Tipo</th>
                  <th>Fecha</th>
                  <th class="text-end">Total</th>
                  <th class="text-end">Saldo</th>
                </tr>
              </thead>
              <tbody id="ventas-tbody">
                <tr><td colspan="7" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                </td></tr>
              </tbody>
            </table>
          </div>
          <div id="ventas-pagination" class="d-flex justify-content-between align-items-center mt-2 d-none" style="font-size:.82rem;">
            <span class="text-muted" id="ventas-page-info"></span>
            <div class="btn-group btn-group-sm">
              <button class="btn btn-outline-secondary" id="ventas-prev-btn" onclick="ventasChangePage(-1)"><i class="bi bi-chevron-left"></i></button>
              <button class="btn btn-outline-secondary" id="ventas-next-btn" onclick="ventasChangePage(1)"><i class="bi bi-chevron-right"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         TAB: MATRÍCULAS / ALUMNOS
    ══════════════════════════════════════ -->
    <div class="tab-pane fade" id="tab-matriculas" role="tabpanel">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div>
          <div class="section-label">Matrículas y Alumnos</div>
          <h6 class="fw-bold mb-0">Últimas matrículas con membresía, clases y actividades</h6>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div>
            <label for="matriculas-fecha-desde" class="form-label mb-0" style="font-size: .75rem;">Desde</label>
            <input type="date" id="matriculas-fecha-desde" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div>
            <label for="matriculas-fecha-hasta" class="form-label mb-0" style="font-size: .75rem;">Hasta</label>
            <input type="date" id="matriculas-fecha-hasta" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div class="align-self-end">
            <button type="button" class="btn btn-outline-secondary btn-export" onclick="exportReport('matriculas')">
              <i class="bi bi-download me-1"></i>CSV
            </button>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
          <div class="rpt-summary-card">
            <div class="lbl">Total Matrículas</div>
            <div class="val" id="mat-total">—</div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="rpt-summary-card">
            <div class="lbl">Con Membresía</div>
            <div class="val text-primary" id="mat-con-mem">—</div>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="rpt-summary-card">
            <div class="lbl">Sin Membresía</div>
            <div class="val text-muted" id="mat-sin-mem">—</div>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-xl-4">
          <div class="section-label">Con / Sin membresía</div>
          <div class="chart-canvas-wrap" id="matriculas-chart-wrap">
            <div class="tab-loading" id="matriculas-chart-loading">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando gráfico...
            </div>
            <canvas id="chart-matriculas" class="d-none"></canvas>
          </div>
        </div>
        <div class="col-12 col-xl-8">
          <div id="matriculas-error" class="alert alert-danger d-none"></div>
          <div class="table-responsive" style="max-height:380px;overflow-y:auto;">
            <table class="table table-hover align-middle mb-0" style="font-size:.83rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th>Alumno</th>
                  <th>Identificación</th>
                  <th>Membresía</th>
                  <th>Registro</th>
                  <th>Vigencia</th>
                  <th class="text-center">Clases</th>
                  <th class="text-center">Actividades</th>
                  <th class="text-center">Detalle</th>
                </tr>
              </thead>
              <tbody id="matriculas-tbody">
                <tr><td colspan="8" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                </td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         TAB: GASTOS
    ══════════════════════════════════════ -->
    <div class="tab-pane fade" id="tab-gastos" role="tabpanel">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div>
          <div class="section-label">Gastos</div>
          <h6 class="fw-bold mb-0">Distribución y detalle de egresos</h6>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <div>
            <label for="gastos-fecha-desde" class="form-label mb-0" style="font-size: .75rem;">Desde</label>
            <input type="date" id="gastos-fecha-desde" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div>
            <label for="gastos-fecha-hasta" class="form-label mb-0" style="font-size: .75rem;">Hasta</label>
            <input type="date" id="gastos-fecha-hasta" class="form-control form-control-sm" style="min-width:130px;">
          </div>
          <div class="align-self-end">
            <button type="button" class="btn btn-outline-secondary btn-export" onclick="exportReport('gastos')">
              <i class="bi bi-download me-1"></i>CSV
            </button>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-xl-5 d-flex flex-column gap-3">
          <div class="section-label">Gastos por categoría</div>
          <div class="chart-canvas-wrap" id="gastos-chart-wrap" style="height:260px;">
            <div class="tab-loading" id="gastos-chart-loading">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando gráfico...
            </div>
            <canvas id="chart-gastos" class="d-none" style="max-height:260px;"></canvas>
          </div>
          <div class="rpt-summary-card mt-auto">
            <div class="lbl">Total de Gastos</div>
            <div class="val text-danger" id="gastos-total">—</div>
          </div>
        </div>
        <div class="col-12 col-xl-7">
          <div id="gastos-error" class="alert alert-danger d-none"></div>
          <div class="section-label">Detalle de gastos</div>
          <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
            <table class="table table-hover align-middle mb-0" style="font-size:.83rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th>N°</th>
                  <th>Fecha</th>
                  <th>Descripción</th>
                  <th>Tipo</th>
                  <th class="text-end">Monto</th>
                </tr>
              </thead>
              <tbody id="gastos-tbody">
                <tr><td colspan="5" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                </td></tr>
              </tbody>
              <tfoot id="gastos-tfoot" class="d-none">
                <tr style="background:var(--app-surface-soft);">
                  <td colspan="4" class="fw-bold text-end pe-2">Total:</td>
                  <td class="fw-bold text-end text-danger" id="gastos-total-foot">—</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /tab-content -->
</div><!-- /main card -->

<!-- ══════════════════════════════════════
     MODAL: Detalle de matrícula
══════════════════════════════════════ -->
<div class="modal fade" id="mat-detail-modal" tabindex="-1" aria-labelledby="mat-detail-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title fw-bold d-flex align-items-center gap-2" id="mat-detail-title">
          <i class="bi bi-journal-bookmark-fill text-primary"></i>Detalle de Matrícula
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body" id="mat-detail-body">
        <div class="text-center py-4"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
(function () {
  'use strict';

  /* ─────────────────────────────────────
     STATE
  ───────────────────────────────────── */
  var instId    = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;

  var _data = {
    stats:           null,
    pagos:           null,
    pagosPendientes: null,
    ventas:          null,
    ventasExternas:  null,
    ventasMeta:      { page: 1, totalPages: 1, totalItems: 0 },
    matriculas:      null,
    gastosData:      null,
  };

  var _tabLoaded = {
    pagos:      false,
    ventas:     false,
    matriculas: false,
    gastos:     false,
  };

  var _charts = {};

  /* ─────────────────────────────────────
     HELPERS
  ───────────────────────────────────── */
  function esc(v) {
    return String(v === null || v === undefined ? '' : v)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  }

  function fmtMoney(v) {
    var n = parseFloat(v || 0);
    return (n < 0 ? '-$' : '$') + Math.abs(n).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function pct(num, den) {
    if (!den || den <= 0) return 0;
    return Math.round((num / den) * 100);
  }

  function showToast(msg, type) {
    type = type || 'info';
    var t = document.createElement('div');
    t.className = 'toast-notification toast-' + type;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(function () { t.classList.add('show'); }, 10);
    setTimeout(function () {
      t.classList.remove('show');
      setTimeout(function () { t.remove(); }, 320);
    }, 3500);
  }

  function spinnerRow(cols) {
    return '<tr><td colspan="' + cols + '" class="text-center text-muted py-5">' +
      '<span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>';
  }

  function emptyRow(cols, msg) {
    return '<tr><td colspan="' + cols + '" class="text-center text-muted py-5">' +
      '<i class="bi bi-inbox fs-4 d-block mb-2 opacity-25"></i>' + esc(msg) +
      '</td></tr>';
  }

  function errorRow(cols, msg) {
    return '<tr><td colspan="' + cols + '" class="text-center text-danger py-4">' +
      '<i class="bi bi-exclamation-triangle me-2"></i>' + esc(msg) +
      '</td></tr>';
  }

  function destroyChart(id) {
    if (_charts[id]) { _charts[id].destroy(); _charts[id] = null; }
  }

  function chartDefaults() {
    var bodyStyle = getComputedStyle(document.body);
    var textColor = bodyStyle.getPropertyValue('--app-text-muted').trim() || '#94a3b8';
    var gridColor = bodyStyle.getPropertyValue('--app-border').trim() || 'rgba(148,163,184,0.18)';
    Chart.defaults.color = textColor;
    Chart.defaults.borderColor = gridColor;
    Chart.defaults.font.family = 'inherit';
    Chart.defaults.font.size = 11;
    return { textColor: textColor, gridColor: gridColor };
  }

  function hideChartLoader(name) {
    var el = document.getElementById(name + '-chart-loading');
    if (el) el.style.display = 'none';
  }

  function truncate(str, len) {
    str = String(str || '');
    return str.length > len ? str.slice(0, len - 1) + '…' : str;
  }

  function initDatePickers() {
    var today  = new Date();
    var year   = today.getFullYear();
    var month  = today.getMonth();
    var firstDay = new Date(year, month, 1).toISOString().split('T')[0];
    var lastDay  = new Date(year, month + 1, 0).toISOString().split('T')[0];

    ['pagos', 'ventas', 'matriculas', 'gastos'].forEach(function (name) {
      var desdeEl = document.getElementById(name + '-fecha-desde');
      var hastaEl = document.getElementById(name + '-fecha-hasta');
      if (desdeEl) desdeEl.value = firstDay;
      if (hastaEl) hastaEl.value = lastDay;
    });
  }

  function getDates(name) {
    return {
      desde: (document.getElementById(name + '-fecha-desde') || {}).value || null,
      hasta:  (document.getElementById(name + '-fecha-hasta')  || {}).value || null,
    };
  }

  function reloadTab(name) {
    _tabLoaded[name] = false;
    _data[name === 'pagos' ? 'pagos' : name === 'ventas' ? 'ventas' : name === 'gastos' ? 'gastosData' : name] = null;
    if (name === 'pagos')  { _data.pagosPendientes = null; }
    if (name === 'ventas') { _data.ventasExternas  = null; }
    switch (name) {
      case 'pagos':      loadTabPagos(true);      break;
      case 'ventas':     loadTabVentas(true);     break;
      case 'matriculas': loadTabMatriculas(true); break;
      case 'gastos':     loadTabGastos(true);     break;
    }
  }

  /* ─────────────────────────────────────
     API WRAPPER
  ───────────────────────────────────── */
  function apiGet(endpoint, action, params) {
    return Cuspide.api.call('GET', CONFIG.ENDPOINTS[endpoint], action, null, params || null);
  }

  /* ─────────────────────────────────────
     ENSURE INSTITUTION ID
     Reads from CUSPIDE_STATE or loads from API
  ───────────────────────────────────── */
  function ensureInstId() {
    instId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || instId || 1;
    return Promise.resolve(instId);
  }

  /* ─────────────────────────────────────
     LOAD DASHBOARD KPIs
  ───────────────────────────────────── */
  function loadDashboardStats() {
    return apiGet('dashboard', 'stats').then(function (data) {
      _data.stats = data;

      document.getElementById('kpi-alumnos').textContent =
        data.totalAlumnos !== undefined ? data.totalAlumnos : '—';

      document.getElementById('kpi-ingresos').textContent =
        data.ingresosMes !== undefined ? fmtMoney(data.ingresosMes) : '—';

      var balanceEl = document.getElementById('kpi-balance');
      if (data.balanceMes !== undefined) {
        balanceEl.textContent = fmtMoney(data.balanceMes);
        balanceEl.style.color = data.balanceMes >= 0 ? '#22c55e' : '#ef4444';
      } else {
        balanceEl.textContent = '—';
      }

      document.getElementById('kpi-pendientes').textContent =
        data.pagosPendientesMes !== undefined ? data.pagosPendientesMes : '—';

    }).catch(function () {
      ['kpi-alumnos','kpi-ingresos','kpi-balance','kpi-pendientes'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.textContent = '—';
      });
    });
  }

  /* ─────────────────────────────────────
     RESET ALL TABS (on refresh)
  ───────────────────────────────────── */
  function resetTabs() {
    Object.keys(_tabLoaded).forEach(function (k) { _tabLoaded[k] = false; });
    _data.pagos           = null;
    _data.pagosPendientes = null;
    _data.ventas          = null;
    _data.ventasExternas  = null;
    _data.ventasMeta      = { page: 1, totalPages: 1, totalItems: 0 };
    _data.matriculas      = null;
    _data.gastosData      = null;
    Object.keys(_charts).forEach(function (id) { destroyChart(id); });

    var resets = [
      ['pagos-tbody', 7], ['pagos-pendientes-tbody', 8],
      ['ventas-tbody', 7], ['matriculas-tbody', 8], ['gastos-tbody', 5],
    ];
    resets.forEach(function (r) {
      var el = document.getElementById(r[0]);
      if (el) el.innerHTML = spinnerRow(r[1]);
    });

    ['chart-pagos','chart-ventas','chart-matriculas','chart-gastos'].forEach(function (id) {
      var cv = document.getElementById(id);
      if (cv) cv.classList.add('d-none');
    });
    ['pagos','ventas','matriculas','gastos'].forEach(function (name) {
      var el = document.getElementById(name + '-chart-loading');
      if (el) el.style.display = 'flex';
    });
    ['pagos','ventas','matriculas','gastos'].forEach(function (name) {
      var el = document.getElementById(name + '-error');
      if (el) el.classList.add('d-none');
    });

    ['pagos-total-cobrado','pagos-num-pagos'].forEach(function(id){ var e=document.getElementById(id); if(e) e.textContent='—'; });
    ['ventas-total','ventas-cobrado','ventas-pendiente','ventas-num'].forEach(function(id){ var e=document.getElementById(id); if(e) e.textContent='—'; });
    ['mat-total','mat-con-mem','mat-sin-mem','gastos-total','gastos-total-foot'].forEach(function(id){ var e=document.getElementById(id); if(e) e.textContent='—'; });
    var tfoot = document.getElementById('gastos-tfoot');
    if (tfoot) tfoot.classList.add('d-none');
    var vpag = document.getElementById('ventas-pagination');
    if (vpag) vpag.classList.add('d-none');
  }

  /* ════════════════════════════════════════════════════
     TAB: PAGOS
     Source: pagos?api=recent
     Fields: id, numero, fecha, monto, referencia,
             observacion, estado_id, forma_pago,
             nombre_cliente, identificacion
  ════════════════════════════════════════════════════ */
  function loadTabPagos(force) {
    if (_tabLoaded.pagos && !force) return;
    _tabLoaded.pagos = true;

    var dates = getDates('pagos');
    document.getElementById('pagos-tbody').innerHTML           = spinnerRow(7);
    document.getElementById('pagos-pendientes-tbody').innerHTML = spinnerRow(8);

    Promise.all([
      apiGet('pagos', 'recent',  { desde: dates.desde, hasta: dates.hasta }),
      apiGet('pagos', 'pending', {}),
    ]).then(function (results) {
      _data.pagos           = Array.isArray(results[0]) ? results[0] : [];
      _data.pagosPendientes = Array.isArray(results[1]) ? results[1] : [];
      renderPagosTab(_data.pagos, _data.pagosPendientes);
    }).catch(function (err) {
      var errEl = document.getElementById('pagos-error');
      errEl.textContent = 'Error al cargar pagos: ' + (err.message || 'Error');
      errEl.classList.remove('d-none');
      document.getElementById('pagos-tbody').innerHTML = errorRow(7, err.message || 'Error');
      hideChartLoader('pagos');
    });
  }

  function renderPagosTab(items, pendientes) {
    var activos      = items.filter(function (p) { return parseInt(p.estado_id) === 1; });
    var totalCobrado = activos.reduce(function (s, p) { return s + parseFloat(p.monto || 0); }, 0);
    var totalPend    = (pendientes || []).reduce(function (s, p) { return s + parseFloat(p.saldo || 0); }, 0);

    document.getElementById('pagos-total-cobrado').textContent  = fmtMoney(totalCobrado);
    document.getElementById('pagos-num-pagos').textContent      = activos.length;
    document.getElementById('pagos-total-pendiente').textContent = fmtMoney(totalPend);
    document.getElementById('pagos-num-pendiente').textContent  = (pendientes || []).length;

    var tbody = document.getElementById('pagos-tbody');
    if (!items.length) {
      tbody.innerHTML = emptyRow(7, 'No hay pagos en el período seleccionado.');
      hideChartLoader('pagos');
    } else {
      tbody.innerHTML = items.map(function (p) {
        var monto    = parseFloat(p.monto || 0);
        var estadoId = parseInt(p.estado_id || 1);
        var esExt    = p.tipo_origen === 'externa';
        var estadoBadge = estadoId === 1
          ? '<span class="badge bg-success rounded-pill">Cobrado</span>'
          : '<span class="badge bg-danger rounded-pill">Anulado</span>';
        var extBadge = esExt
          ? ' <span class="badge rounded-pill" style="font-size:.65rem;background:var(--app-border);color:var(--app-text-muted);">Ext</span>'
          : '';
        return '<tr>' +
          '<td>' + estadoBadge + '</td>' +
          '<td class="fw-semibold">' + esc(p.nombre_cliente || '—') + '</td>' +
          '<td><code style="font-size:.72rem;">' + esc(p.identificacion || '—') + '</code></td>' +
          '<td>' + esc(p.numero || '—') + extBadge + '</td>' +
          '<td style="font-size:.8rem;">' + esc(p.fecha || '—') + '</td>' +
          '<td><span class="badge rounded-pill bg-secondary">' + esc(p.forma_pago || 'Efectivo') + '</span></td>' +
          '<td class="text-end fw-bold ' + (estadoId === 1 ? 'text-success' : 'text-muted text-decoration-line-through') + '">' + fmtMoney(monto) + '</td>' +
        '</tr>';
      }).join('');

      var formaMap = {};
      activos.forEach(function (p) {
        var f = p.forma_pago || 'Efectivo';
        formaMap[f] = (formaMap[f] || 0) + parseFloat(p.monto || 0);
      });
      renderPagosChart(formaMap);
    }

    /* ─ Pendientes ─ */
    var ptbody = document.getElementById('pagos-pendientes-tbody');
    if (!pendientes || !pendientes.length) {
      ptbody.innerHTML = emptyRow(8, 'Sin facturas con saldo pendiente.');
    } else {
      ptbody.innerHTML = pendientes.map(function (p) {
        var total = parseFloat(p.total || 0);
        var saldo = parseFloat(p.saldo || 0);
        var pct   = total > 0 ? Math.round((1 - saldo / total) * 100) : 0;
        var origenBadge = p.tipo_origen === 'externa'
          ? '<span class="badge rounded-pill" style="font-size:.65rem;background:rgba(99,102,241,.15);color:#6366f1;border:1px solid rgba(99,102,241,.35);">Externa</span>'
          : '<span class="badge rounded-pill bg-secondary" style="font-size:.65rem;">Regular</span>';
        return '<tr>' +
          '<td class="fw-semibold">' + esc(p.nombre || '—') + '<br>' +
            '<code style="font-size:.7rem;color:var(--app-text-muted);">' + esc(p.identificacion || '') + '</code></td>' +
          '<td>' + esc(p.numero || '—') + '</td>' +
          '<td><span class="badge rounded-pill" style="background:rgba(99,102,241,.12);color:var(--app-text);border:1px solid rgba(99,102,241,.35);font-size:.7rem;">' + esc(p.tipo || '—') + '</span></td>' +
          '<td style="font-size:.8rem;">' + esc(p.fecha || '—') + '</td>' +
          '<td class="text-end">' + fmtMoney(total) + '</td>' +
          '<td class="text-end fw-bold text-danger">' + fmtMoney(saldo) + '</td>' +
          '<td class="text-center">' +
            '<div class="progress" style="height:6px;width:70px;display:inline-flex;vertical-align:middle;margin-right:4px;">' +
              '<div class="progress-bar bg-success" style="width:' + pct + '%"></div>' +
            '</div>' +
            '<span style="font-size:.75rem;">' + pct + '%</span>' +
          '</td>' +
          '<td>' + origenBadge + '</td>' +
        '</tr>';
      }).join('');
    }
  }

  function renderPagosChart(formaMap) {
    hideChartLoader('pagos');
    var cv = document.getElementById('chart-pagos');
    cv.classList.remove('d-none');
    destroyChart('pagos');

    var labels  = Object.keys(formaMap);
    var values  = labels.map(function (k) { return formaMap[k]; });
    var palette = ['#3b82f6','#22c55e','#f59e0b','#a855f7','#14b8a6','#f97316'];

    chartDefaults();
    _charts['pagos'] = new Chart(cv, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Total cobrado ($)',
          data: values,
          backgroundColor: labels.map(function (_, i) { return palette[i % palette.length] + 'b0'; }),
          borderColor: labels.map(function (_, i) { return palette[i % palette.length]; }),
          borderWidth: 1,
          borderRadius: 6,
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function (ctx) { return ' ' + fmtMoney(ctx.parsed.y); } } },
        },
        scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return '$' + v.toFixed(0); } } } },
      },
    });
  }

  /* ════════════════════════════════════════════════════
     TAB: VENTAS
     Source: ventas?api=list&institucion=X
     Returns: { items: [...], totalItems, totalPages, currentPage }
     Item fields: id, numero, fecha, tipo, total, saldo,
                  estado, identificacion, nombre
  ════════════════════════════════════════════════════ */
  function loadTabVentas(force) {
    if (_tabLoaded.ventas && !force) return;
    _tabLoaded.ventas = true;
    document.getElementById('ventas-tbody').innerHTML = spinnerRow(7);
    fetchVentasPage(1);
  }

  function fetchVentasPage(page) {
    var dates = getDates('ventas');
    ensureInstId().then(function (id) {
      if (!id) throw new Error('No se pudo obtener la institución.');
      var params = { institucion: id, page: page || 1, desde: dates.desde, hasta: dates.hasta };
      return Promise.all([
        apiGet('ventas', 'list', params),
        apiGet('ventas', 'list_externas', { institucion: id, desde: dates.desde, hasta: dates.hasta, limit: 200 }),
      ]);
    }).then(function (results) {
      var regData = results[0];
      var extData = results[1];

      var items = Array.isArray(regData) ? regData : (regData && Array.isArray(regData.items) ? regData.items : []);
      var meta  = { totalItems: 0, totalPages: 1, currentPage: 1 };
      if (regData && !Array.isArray(regData)) {
        meta.totalItems  = regData.totalItems  || items.length;
        meta.totalPages  = regData.totalPages  || 1;
        meta.currentPage = regData.currentPage || 1;
      }

      /* Mapear externas al mismo formato */
      var extItems = (extData && Array.isArray(extData.items) ? extData.items : [])
        .map(function (ve) {
          return {
            id:             ve.id,
            numero:         ve.numero,
            fecha:          ve.fecha,
            tipo:           'EXTERNA',
            total:          ve.total,
            saldo:          ve.saldo,
            estado:         ve.estado,  /* 1=activa, 2=anulada */
            identificacion: ve.cliente_identificacion || '',
            nombre:         ve.cliente_nombre || 'Anónimo',
            _externa:       true,
          };
        });

      _data.ventas         = items;
      _data.ventasExternas = extItems;
      _data.ventasMeta     = meta;

      var merged = items.concat(extItems);
      merged.sort(function (a, b) { return new Date(b.fecha) - new Date(a.fecha); });
      renderVentasTab(merged, meta);
    }).catch(function (err) {
      var errEl = document.getElementById('ventas-error');
      errEl.textContent = 'Error al cargar ventas: ' + (err.message || 'Error');
      errEl.classList.remove('d-none');
      document.getElementById('ventas-tbody').innerHTML = errorRow(7, err.message || 'Error');
      hideChartLoader('ventas');
    });
  }

  function ventaEstadoBadge(v) {
    var estadoNum = parseInt(v.estado || 1);
    var saldo     = parseFloat(v.saldo || 0);
    var total     = parseFloat(v.total || 0);
    var pct       = total > 0 ? Math.round((1 - saldo / total) * 100) : 100;

    /* ventas regulares: estado=2 anulado, ventas_externas: estado=2 anulado */
    if (v._externa) {
      if (estadoNum === 2) return '<span class="badge bg-danger rounded-pill">Anulada</span>';
      if (saldo <= 0)      return '<span class="badge bg-success rounded-pill">Cobrado</span>';
      return '<span class="badge rounded-pill" style="background:#f59e0b22;color:#b45309;border:1px solid #f59e0b55;">' +
             'Pagado ' + pct + '%</span>';
    }
    /* ventas regulares */
    if (estadoNum === 2 && saldo <= 0) return '<span class="badge bg-success rounded-pill">Cobrado</span>';
    if (estadoNum === 0)               return '<span class="badge bg-danger rounded-pill">Anulado</span>';
    if (saldo <= 0)                    return '<span class="badge bg-success rounded-pill">Cobrado</span>';
    if (pct > 0 && pct < 100)
      return '<span class="badge rounded-pill" style="background:#f59e0b22;color:#b45309;border:1px solid #f59e0b55;">' +
             'Pagado ' + pct + '%</span>';
    return '<span class="badge bg-warning text-dark rounded-pill">Pendiente</span>';
  }

  function renderVentasTab(items, meta) {
    var totalSuma = items.reduce(function (s, v) { return s + parseFloat(v.total || 0); }, 0);
    var saldoSuma = items.reduce(function (s, v) { return s + parseFloat(v.saldo || 0); }, 0);
    var cobrado   = totalSuma - saldoSuma;

    document.getElementById('ventas-total').textContent     = fmtMoney(totalSuma);
    document.getElementById('ventas-cobrado').textContent   = fmtMoney(cobrado);
    document.getElementById('ventas-pendiente').textContent = fmtMoney(saldoSuma);
    document.getElementById('ventas-num').textContent       = items.length;

    var tbody = document.getElementById('ventas-tbody');
    if (!items.length) {
      tbody.innerHTML = emptyRow(7, 'No hay ventas en el período seleccionado.');
      hideChartLoader('ventas');
      return;
    }

    tbody.innerHTML = items.map(function (v) {
      var total     = parseFloat(v.total || 0);
      var saldo     = parseFloat(v.saldo || 0);
      var tipoBadge = v.tipo
        ? '<span class="badge rounded-pill" style="background:rgba(99,102,241,.12);color:var(--app-text);border:1px solid rgba(99,102,241,.35);font-size:.7rem;">' + esc(v.tipo) + '</span>'
        : '<span class="text-muted">—</span>';
      return '<tr>' +
        '<td>' + ventaEstadoBadge(v) + '</td>' +
        '<td class="fw-semibold" style="max-width:160px;">' + esc(v.nombre || '—') + '<br>' +
          '<code style="font-size:.7rem;color:var(--app-text-muted);">' + esc(v.identificacion || '') + '</code></td>' +
        '<td>' + esc(v.numero || '—') + '</td>' +
        '<td>' + tipoBadge + '</td>' +
        '<td style="font-size:.8rem;">' + esc(v.fecha || '—') + '</td>' +
        '<td class="text-end fw-bold">' + fmtMoney(total) + '</td>' +
        '<td class="text-end fw-semibold ' + (saldo > 0 ? 'text-danger' : 'text-success') + '">' + fmtMoney(saldo) + '</td>' +
      '</tr>';
    }).join('');

    /* Pagination — solo aplica para ventas regulares */
    if (meta.totalPages > 1) {
      var vpag = document.getElementById('ventas-pagination');
      vpag.classList.remove('d-none');
      document.getElementById('ventas-page-info').textContent =
        'Página ' + meta.currentPage + ' de ' + meta.totalPages + ' (' + meta.totalItems + ' reg.)';
      document.getElementById('ventas-prev-btn').disabled = meta.currentPage <= 1;
      document.getElementById('ventas-next-btn').disabled = meta.currentPage >= meta.totalPages;
    }

    /* Chart */
    var tipoMap = {};
    items.forEach(function (v) {
      var tipo = v.tipo || 'Sin tipo';
      tipoMap[tipo] = (tipoMap[tipo] || 0) + parseFloat(v.total || 0);
    });
    renderVentasChart(tipoMap);
  }

  window.ventasChangePage = function (delta) {
    var meta = _data.ventasMeta;
    var next = (meta.currentPage || 1) + delta;
    if (next < 1 || next > meta.totalPages) return;
    _tabLoaded.ventas = false;
    _data.ventas = null;
    document.getElementById('ventas-tbody').innerHTML = spinnerRow(7);
    fetchVentasPage(next);
    _tabLoaded.ventas = true;
  };

  function renderVentasChart(tipoMap) {
    hideChartLoader('ventas');
    var cv = document.getElementById('chart-ventas');
    cv.classList.remove('d-none');
    destroyChart('ventas');

    var labels  = Object.keys(tipoMap);
    var values  = labels.map(function (k) { return tipoMap[k]; });
    var palette = ['#3b82f6','#22c55e','#f59e0b','#ef4444','#a855f7','#14b8a6'];

    chartDefaults();
    _charts['ventas'] = new Chart(cv, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: labels.map(function (_, i) { return palette[i % palette.length]; }),
          borderColor: 'transparent',
          hoverOffset: 6,
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '58%',
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, padding: 8, font: { size: 10 } } },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                var tot = ctx.dataset.data.reduce(function (s, v) { return s + v; }, 0);
                var p   = tot > 0 ? Math.round((ctx.parsed / tot) * 100) : 0;
                return ' ' + fmtMoney(ctx.parsed) + ' (' + p + '%)';
              },
            },
          },
        },
      },
    });
  }

  /* ════════════════════════════════════════════════════
     TAB: MATRÍCULAS
     Source: dashboard?api=ultimas_matriculas
     Fields: id, nombre, persona_id, identificacion,
             tipo, membresia, fecha_registro,
             fecha_inicio, fecha_fin, clases_count,
             actividades_count
  ════════════════════════════════════════════════════ */
  function loadTabMatriculas(force) {
    if (_tabLoaded.matriculas && !force) return;
    _tabLoaded.matriculas = true;

    if (_data.matriculas && !force) { renderMatriculasTab(_data.matriculas); return; }

    apiGet('dashboard', 'ultimas_matriculas').then(function (data) {
      _data.matriculas = Array.isArray(data) ? data : [];
      renderMatriculasTab(_data.matriculas);
    }).catch(function (err) {
      var errEl = document.getElementById('matriculas-error');
      errEl.textContent = 'Error al cargar matrículas: ' + (err.message || 'Error');
      errEl.classList.remove('d-none');
      document.getElementById('matriculas-tbody').innerHTML = errorRow(8, err.message || 'Error');
      hideChartLoader('matriculas');
    });
  }

  function renderMatriculasTab(items) {
    var conMem = items.filter(function (m) {
      return m.membresia && m.membresia !== 'Sin membresía';
    }).length;
    var sinMem = items.length - conMem;

    document.getElementById('mat-total').textContent   = items.length;
    document.getElementById('mat-con-mem').textContent = conMem;
    document.getElementById('mat-sin-mem').textContent = sinMem;

    var tbody = document.getElementById('matriculas-tbody');
    if (!items.length) {
      tbody.innerHTML = emptyRow(8, 'No hay matrículas registradas.');
      hideChartLoader('matriculas');
      return;
    }

    tbody.innerHTML = items.map(function (m) {
      var tieneMem  = m.membresia && m.membresia !== 'Sin membresía';
      var memBadge  = tieneMem
        ? '<span class="badge bg-primary rounded-pill" style="font-size:.7rem;">' + esc(m.membresia) + '</span>'
        : '<span class="badge rounded-pill" style="background:rgba(107,114,128,.15);color:var(--app-text-muted);font-size:.7rem;">Sin membresía</span>';
      var vigencia  = (m.fecha_inicio && m.fecha_fin)
        ? '<span style="font-size:.76rem;">' + esc(m.fecha_inicio) + '</span><br>' +
          '<span style="font-size:.72rem;color:var(--app-text-muted);">al ' + esc(m.fecha_fin) + '</span>'
        : '<span class="text-muted">—</span>';
      var detailBtn = '<button class="btn btn-sm btn-outline-primary" style="font-size:.7rem;padding:.2rem .5rem;" ' +
        'data-mat-id="' + esc(m.id) + '" data-persona-id="' + esc(m.persona_id) + '" ' +
        'onclick="verDetalleMatricula(this)">' +
        '<i class="bi bi-eye"></i>' +
        '</button>';
      return '<tr>' +
        '<td class="fw-semibold">' + esc(m.nombre || '—') + '</td>' +
        '<td><code style="font-size:.72rem;">' + esc(m.identificacion || '—') + '</code></td>' +
        '<td>' + memBadge + '</td>' +
        '<td style="font-size:.8rem;">' + esc(m.fecha_registro || '—') + '</td>' +
        '<td>' + vigencia + '</td>' +
        '<td class="text-center"><span class="badge rounded-pill ' + (parseInt(m.clases_count) > 0 ? 'bg-primary' : 'bg-light text-muted') + '">' +
          (parseInt(m.clases_count) || 0) + '</span></td>' +
        '<td class="text-center"><span class="badge rounded-pill ' + (parseInt(m.actividades_count) > 0 ? 'bg-success' : 'bg-light text-muted') + '">' +
          (parseInt(m.actividades_count) || 0) + '</span></td>' +
        '<td class="text-center">' + detailBtn + '</td>' +
      '</tr>';
    }).join('');

    renderMatriculasChart(conMem, sinMem);
  }

  function renderMatriculasChart(conMem, sinMem) {
    hideChartLoader('matriculas');
    var cv = document.getElementById('chart-matriculas');
    cv.classList.remove('d-none');
    destroyChart('matriculas');

    chartDefaults();
    _charts['matriculas'] = new Chart(cv, {
      type: 'doughnut',
      data: {
        labels: ['Con membresía', 'Sin membresía'],
        datasets: [{
          data: [conMem, sinMem],
          backgroundColor: ['#3b82f6', '#94a3b8'],
          borderColor: 'transparent',
          hoverOffset: 6,
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '62%',
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } },
          tooltip: { callbacks: { label: function (ctx) { return ' ' + ctx.parsed + ' matrícula(s)'; } } },
        },
      },
    });
  }

  /* Modal: detalle de matrícula */
  window.verDetalleMatricula = function (btn) {
    var matriculaId = btn.dataset.matId;
    var personaId   = btn.dataset.personaId;
    var matItem     = (_data.matriculas || []).find(function (m) { return String(m.id) === String(matriculaId); });
    var nombre      = matItem ? matItem.nombre : '';

    var modal   = document.getElementById('mat-detail-modal');
    var titleEl = document.getElementById('mat-detail-title');
    var bodyEl  = document.getElementById('mat-detail-body');

    titleEl.innerHTML = '<i class="bi bi-journal-bookmark-fill text-primary me-2"></i>' + esc(nombre || 'Detalle de Matrícula');
    bodyEl.innerHTML  = '<div class="text-center py-4"><span class="spinner-border spinner-border-sm me-2"></span>Cargando detalle...</div>';

    var bsModal = bootstrap.Modal.getInstance(modal) || new bootstrap.Modal(modal);
    bsModal.show();

    apiGet('matriculas', 'list', { persona_id: personaId }).then(function (data) {
      var mats   = Array.isArray(data) ? data : [];
      var target = mats.find(function (m) { return parseInt(m.id) === parseInt(matriculaId); }) || mats[0];

      if (!target) {
        bodyEl.innerHTML = '<p class="text-muted text-center py-3"><i class="bi bi-inbox fs-4 d-block mb-2 opacity-25"></i>Sin información disponible.</p>';
        return;
      }

      var clases = Array.isArray(target.clases) ? target.clases : [];
      var acts   = Array.isArray(target.actividades) ? target.actividades : [];

      var html = '<div class="row g-2 mb-4">';
      html += makeDetailField('Membresía', target.membresia || 'Sin membresía');
      html += makeDetailField('Estado', target.estado || '—');
      html += makeDetailField('Fecha inicio', target.fecha_inicio || '—');
      html += makeDetailField('Fecha fin', target.fecha_fin || '—');
      html += '</div>';

      /* Plan de pago */
      if (target.plan_pago && target.plan_pago.total) {
        html += '<div class="section-label mb-2">Plan de Pago</div>';
        html += '<div class="row g-2 mb-3">';
        html += makeDetailField('Total', fmtMoney(target.plan_pago.total));
        html += makeDetailField('Saldo', fmtMoney(target.plan_pago.saldo), parseFloat(target.plan_pago.saldo) > 0 ? 'text-danger' : 'text-success');
        html += '</div>';
      }

      /* Clases */
      if (clases.length > 0) {
        html += '<div class="section-label mb-2"><i class="bi bi-book me-1 text-primary"></i>Clases (' + clases.length + ')</div>';
        html += '<div class="list-group list-group-flush mb-3">';
        clases.forEach(function (c) {
          var activo = c.estado === 1 || c.estado === '1';
          html += '<div class="list-group-item bg-transparent px-0 py-2 border-0 border-bottom d-flex justify-content-between align-items-center">';
          html += '<span class="fw-semibold text-body">' + esc(c.clase_nombre || '—') + '</span>';
          html += '<span class="badge rounded-pill ' + (activo ? 'bg-success' : 'bg-secondary') + '">' + (activo ? 'Activa' : 'Inactiva') + '</span>';
          html += '</div>';
        });
        html += '</div>';
      }

      /* Actividades */
      if (acts.length > 0) {
        html += '<div class="section-label mb-2"><i class="bi bi-trophy me-1 text-success"></i>Actividades (' + acts.length + ')</div>';
        html += '<div class="list-group list-group-flush">';
        acts.forEach(function (a) {
          var activo = a.estado === 1 || a.estado === '1';
          html += '<div class="list-group-item bg-transparent px-0 py-2 border-0 border-bottom d-flex justify-content-between align-items-center">';
          html += '<span class="fw-semibold text-body">' + esc(a.actividad_nombre || '—') + '</span>';
          html += '<span class="badge rounded-pill ' + (activo ? 'bg-success' : 'bg-secondary') + '">' + (activo ? 'Activa' : 'Inactiva') + '</span>';
          html += '</div>';
        });
        html += '</div>';
      }

      if (clases.length === 0 && acts.length === 0) {
        html += '<p class="text-muted text-center py-3"><i class="bi bi-inbox d-block fs-4 mb-2 opacity-25"></i>Sin clases ni actividades asignadas.</p>';
      }

      bodyEl.innerHTML = html;
    }).catch(function (err) {
      bodyEl.innerHTML = '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>' + esc(err.message || 'Error al cargar el detalle.') + '</div>';
    });
  };

  function makeDetailField(label, value, valueClass) {
    return '<div class="col-6">' +
      '<div class="rpt-summary-card">' +
      '<div class="lbl">' + esc(label) + '</div>' +
      '<div class="val ' + (valueClass || '') + '" style="font-size:1rem;">' + esc(value) + '</div>' +
      '</div></div>';
  }

  /* ════════════════════════════════════════════════════
     TAB: GASTOS
  ════════════════════════════════════════════════════ */
  function loadTabGastos(force) {
    if (_tabLoaded.gastos && !force) return;
    _tabLoaded.gastos = true;

    var dates = getDates('gastos');
    document.getElementById('gastos-tbody').innerHTML = spinnerRow(5);

    apiGet('gastos', 'list', {
      limit:       500,
      fecha_inicio: dates.desde,
      fecha_fin:    dates.hasta,
    }).then(function (data) {
      var items = Array.isArray(data) ? data : (data && Array.isArray(data.items) ? data.items : []);
      _data.gastosData = items;
      renderGastosTab(items);
    }).catch(function (err) {
      var errEl = document.getElementById('gastos-error');
      errEl.textContent = 'Error al cargar gastos: ' + (err.message || 'Error');
      errEl.classList.remove('d-none');
      document.getElementById('gastos-tbody').innerHTML = errorRow(5, err.message || 'Error');
      hideChartLoader('gastos');
    });
  }

  function renderGastosTab(items) {
    var total = items.reduce(function (s, g) { return s + parseFloat(g.monto || 0); }, 0);
    document.getElementById('gastos-total').textContent      = fmtMoney(total);
    document.getElementById('gastos-total-foot').textContent = fmtMoney(total);

    var tbody = document.getElementById('gastos-tbody');
    var tfoot = document.getElementById('gastos-tfoot');

    if (!items.length) {
      tbody.innerHTML = emptyRow(5, 'No hay gastos registrados.');
      hideChartLoader('gastos');
      return;
    }

    var tipoBadgeColors = {
      NOMINA:'#1a2235', SERVICIOS:'#0d9488', ARRIENDO:'#d97706',
      EQUIPAMIENTO:'#3b82f6', MANTENIMIENTO:'#8b5cf6', TRANSPORTE:'#f97316',
      ALIMENTACION:'#14b8a6', PUBLICIDAD:'#ec4899', ADMINISTRATIVO:'#6366f1', OTROS:'#6b7280',
    };

    var sorted = items.slice().sort(function (a, b) { return new Date(b.fecha) - new Date(a.fecha); });
    tbody.innerHTML = sorted.map(function (g) {
      var color = tipoBadgeColors[g.tipo_gasto] || '#6b7280';
      return '<tr>' +
        '<td><code style="font-size:.75rem;">' + esc(g.numero || '—') + '</code></td>' +
        '<td>' + esc(g.fecha) + '</td>' +
        '<td>' + esc(g.descripcion) + '</td>' +
        '<td><span class="badge rounded-pill" style="background:' + color + ';color:#fff;">' + esc(g.tipo_gasto || '—') + '</span></td>' +
        '<td class="text-end fw-bold">' + fmtMoney(g.monto) + '</td>' +
      '</tr>';
    }).join('');

    tfoot.classList.remove('d-none');

    var tipoTotals = {};
    items.forEach(function (g) {
      var tipo = g.tipo_gasto || 'OTROS';
      tipoTotals[tipo] = (tipoTotals[tipo] || 0) + parseFloat(g.monto || 0);
    });
    renderGastosChart(tipoTotals, tipoBadgeColors);
  }

  function renderGastosChart(tipoTotals, colors) {
    hideChartLoader('gastos');
    var cv = document.getElementById('chart-gastos');
    cv.classList.remove('d-none');
    destroyChart('gastos');

    var labels   = Object.keys(tipoTotals);
    var values   = labels.map(function (k) { return tipoTotals[k]; });
    var bgColors = labels.map(function (k) { return colors[k] || '#6b7280'; });

    chartDefaults();
    _charts['gastos'] = new Chart(cv, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: bgColors,
          borderColor: 'transparent',
          hoverOffset: 6,
        }],
      },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '58%',
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 10 } } },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                var tot = ctx.dataset.data.reduce(function (s, v) { return s + v; }, 0);
                var p   = tot > 0 ? Math.round((ctx.parsed / tot) * 100) : 0;
                return ' ' + fmtMoney(ctx.parsed) + ' (' + p + '%)';
              },
            },
          },
        },
      },
    });
  }

  /* ─────────────────────────────────────
     EXPORT REPORT TO CSV
  ───────────────────────────────────── */
  function exportReport(reportType) {
    var dates      = getDates(reportType);
    var desde      = dates.desde;
    var hasta      = dates.hasta;

    if (!desde || !hasta) {
      showToast('Selecciona un rango de fechas para exportar.', 'warning');
      return;
    }

    var exportButton = document.querySelector('#tab-' + reportType + ' .btn-export');
    if (!exportButton) return;

    var originalHtml = exportButton.innerHTML;
    exportButton.disabled = true;
    exportButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Exportando...';

    var promise;

    if (reportType === 'ventas') {
      /* Ventas: regulares + externas */
      ensureInstId().then(function (id) {
        return Promise.all([
          apiGet('ventas', 'list',          { institucion: id, desde: desde, hasta: hasta, limit: 9999 }),
          apiGet('ventas', 'list_externas', { institucion: id, desde: desde, hasta: hasta, limit: 9999 }),
        ]);
      }).then(function (results) {
        var reg  = results[0];
        var ext  = results[1];
        var regItems = Array.isArray(reg) ? reg : (reg && Array.isArray(reg.items) ? reg.items : []);
        var extItems = (ext && Array.isArray(ext.items) ? ext.items : []).map(function (ve) {
          return {
            numero: ve.numero, fecha: ve.fecha, tipo: 'EXTERNA',
            total: ve.total, saldo: ve.saldo, estado: ve.estado,
            nombre: ve.cliente_nombre || 'Anónimo',
            identificacion: ve.cliente_identificacion || '',
            _externa: true,
          };
        });
        var merged = regItems.concat(extItems);
        merged.sort(function (a, b) { return new Date(b.fecha) - new Date(a.fecha); });
        if (!merged.length) { showToast('Sin datos para exportar.', 'info'); return; }
        generateAndDownloadCSV('ventas', merged, desde, hasta);
      }).catch(function (err) {
        showToast('Error al exportar: ' + (err.message || 'Error'), 'error');
      }).finally(function () {
        exportButton.disabled = false;
        exportButton.innerHTML = originalHtml;
      });
      return;
    }

    if (reportType === 'gastos') {
      promise = apiGet('gastos', 'list', {
        limit: 9999, fecha_inicio: desde, fecha_fin: hasta,
      }).then(function (data) {
        return Array.isArray(data) ? data : (data && Array.isArray(data.items) ? data.items : []);
      });
    } else if (reportType === 'pagos') {
      promise = apiGet('pagos', 'recent', { desde: desde, hasta: hasta }).then(function (data) {
        return Array.isArray(data) ? data : [];
      });
    } else if (reportType === 'matriculas') {
      promise = apiGet('dashboard', 'ultimas_matriculas', {}).then(function (data) {
        return Array.isArray(data) ? data : [];
      });
    } else {
      showToast('Tipo de reporte no configurado.', 'error');
      exportButton.disabled = false;
      exportButton.innerHTML = originalHtml;
      return;
    }

    promise.then(function (data) {
      if (!data.length) { showToast('Sin datos para exportar.', 'info'); return; }
      generateAndDownloadCSV(reportType, data, desde, hasta);
    }).catch(function (err) {
      showToast('Error al exportar: ' + (err.message || 'Error'), 'error');
    }).finally(function () {
      exportButton.disabled = false;
      exportButton.innerHTML = originalHtml;
    });
  }
  window.exportReport = exportReport;

  function generateAndDownloadCSV(reportType, data, desde, hasta) {
    let csvContent = '';
    let headers = [];
    let rows = [];
    const filename = (desde && hasta)
      ? `reporte_${reportType}_${desde}_a_${hasta}.csv`
      : `reporte_${reportType}_${new Date().toISOString().slice(0, 10)}.csv`;

    const toCsvRow = (arr) => arr.map(val => `"${String(val == null ? '' : val).replace(/"/g, '""')}"`).join(',');

    switch (reportType) {
      case 'pagos':
        headers = ['Estado', 'Cliente', 'Identificación', 'N° Pago', 'Fecha', 'Forma de Pago', 'Monto', 'Asignaturas', 'Actividades'];
        rows = data.map(p => [parseInt(p.estado_id || 1) === 1 ? 'Cobrado' : 'Anulado', p.nombre_cliente, p.identificacion, p.numero, p.fecha, p.forma_pago || 'Efectivo', parseFloat(p.monto || 0).toFixed(2), p.clases_nombres || '', p.actividades_nombres || '']);
        break;
      case 'ventas':
        headers = ['Estado', 'Cliente', 'Identificación', 'N° Factura', 'Tipo', 'Origen', 'Fecha', 'Total', 'Saldo', '% Pagado'];
        rows = data.map(function (v) {
          var saldo    = parseFloat(v.saldo || 0);
          var total    = parseFloat(v.total || 0);
          var pct      = total > 0 ? Math.round((1 - saldo / total) * 100) : 100;
          var estadoN  = parseInt(v.estado || 1);
          var estado;
          if (v._externa) {
            estado = estadoN === 2 ? 'Anulada' : (saldo <= 0 ? 'Cobrado' : 'Pagado ' + pct + '%');
          } else {
            estado = estadoN === 0 ? 'Anulado' : (saldo <= 0 ? 'Cobrado' : (pct > 0 ? 'Pagado ' + pct + '%' : 'Pendiente'));
          }
          return [estado, v.nombre || v.cliente_nombre, v.identificacion, v.numero, v.tipo, v._externa ? 'Externa' : 'Regular', v.fecha, total.toFixed(2), saldo.toFixed(2), pct + '%'];
        });
        break;
      case 'matriculas':
        headers = ['Alumno', 'Identificación', 'Membresía', 'Registro', 'Vigencia Inicio', 'Vigencia Fin', 'Clases', 'Actividades', 'Categoría Deportiva'];
        rows = data.map(m => [m.nombre, m.identificacion, m.membresia, m.fecha_registro, m.fecha_inicio, m.fecha_fin, m.clases_nombres, m.actividades_nombres, m.categorias_nombres || '']);
        break;
      case 'gastos':
        headers = ['N°', 'Fecha', 'Descripción', 'Tipo', 'Monto'];
        rows = data.map(g => [g.numero, g.fecha, g.descripcion, g.tipo_gasto, parseFloat(g.monto || 0).toFixed(2)]);
        break;
      default: return;
    }

    csvContent += toCsvRow(headers) + '\n';
    rows.forEach(row => { csvContent += toCsvRow(row) + '\n'; });

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
    showToast('CSV exportado correctamente.', 'success');
  }

  /* ─────────────────────────────────────
     TAB LAZY LOADING
  ───────────────────────────────────── */
  document.getElementById('rpt-tab-nav').addEventListener('show.bs.tab', function (e) {
    var target = e.target.getAttribute('data-bs-target');
    switch (target) {
      case '#tab-pagos':      loadTabPagos(false);      break;
      case '#tab-ventas':     loadTabVentas(false);     break;
      case '#tab-matriculas': loadTabMatriculas(false); break;
      case '#tab-gastos':     loadTabGastos(false);     break;
    }
  });

  /* ─────────────────────────────────────
     DATE PICKER CHANGE → RELOAD TAB
  ───────────────────────────────────── */
  ['pagos', 'ventas', 'gastos'].forEach(function (name) {
    ['desde', 'hasta'].forEach(function (d) {
      var el = document.getElementById(name + '-fecha-' + d);
      if (el) el.addEventListener('change', function () { reloadTab(name); });
    });
  });

  /* ─────────────────────────────────────
     REFRESH BUTTON
  ───────────────────────────────────── */
  document.getElementById('btn-rpt-refresh').addEventListener('click', function () {
    resetTabs();

    ['kpi-alumnos','kpi-ingresos','kpi-balance','kpi-pendientes'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    });

    loadDashboardStats().then(function () {
      var activeBtn = document.querySelector('#rpt-tab-nav .nav-link.active');
      if (!activeBtn) return;
      var target = activeBtn.getAttribute('data-bs-target');
      switch (target) {
        case '#tab-pagos':      loadTabPagos();      break;
        case '#tab-ventas':     loadTabVentas();     break;
        case '#tab-matriculas': loadTabMatriculas(); break;
        case '#tab-gastos':     loadTabGastos();     break;
      }
    });
  });

  /* ─────────────────────────────────────
     INIT
  ───────────────────────────────────── */
  document.addEventListener('DOMContentLoaded', function () {
    checkAuth();
    initDatePickers();

    instId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;

    Promise.all([
      loadDashboardStats(),
      ensureInstId(),
    ]).then(function () {
      loadTabPagos();
    }).catch(function (err) {
      showToast('Error al inicializar reportes: ' + (err.message || 'Error'), 'error');
    });
  });

})();
</script>
{% endblock %}
