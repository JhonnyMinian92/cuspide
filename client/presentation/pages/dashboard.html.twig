{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'dashboard' %}

{% block title %}Dashboard — Huaquillas F.C.{% endblock %}
{% block page_title %}Panel de Control{% endblock %}

{% block content %}
<div class="row g-4 mb-4">
  <!-- Total Alumnos -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#1a2235;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Total Alumnos</div>
          <div class="stat-value" id="stat-alumnos">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
      </div>
    </div>
  </div>
  <!-- Categorías Activas -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#0d9488;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Categorías Activas</div>
          <div class="stat-value" id="stat-categorias">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-tags-fill"></i></div>
      </div>
    </div>
  </div>
  <!-- Alumnos Evaluados -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#d97706;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Alumnos Evaluados</div>
          <div class="stat-value" id="stat-evaluados">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-clipboard-check-fill"></i></div>
      </div>
    </div>
  </div>
  <!-- Pagos Vencidos -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#dc2626;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Pagos Vencidos</div>
          <div class="stat-value" id="stat-pagos">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- Aviso endpoint en construcción (oculto por defecto, se muestra via JS) -->
<div class="alert alert-info d-flex align-items-center mb-4 d-none" role="alert" id="stats-notice">
  <i class="bi bi-info-circle-fill me-2"></i>
  Las estadísticas detalladas están en construcción.
</div>

<!-- Tabla Próximos Vencimientos -->
<div class="card chart-card">
  <div class="card-body p-4">
    <h6 class="fw-bold mb-3">Próximos Vencimientos</h6>
    <div class="table-responsive table-container">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Alumno</th>
            <th>Membresía</th>
            <th>Fecha Vencimiento</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody id="vencimientos-tbody">
          <tr>
            <td colspan="4" class="text-center text-muted py-4">
              <i class="bi bi-clock-history me-2"></i>
              Cargando vencimientos...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  document.addEventListener('DOMContentLoaded', async function () {
    await loadEstadisticas();
  });

  const STAT_IDS = ['stat-alumnos', 'stat-categorias', 'stat-evaluados', 'stat-pagos'];

  function setStatsPlaceholder(value) {
    STAT_IDS.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.textContent = value;
    });
  }

  async function loadEstadisticas() {
    try {
      // estadistica vive en users — si el back aún no lo implementa, cae al catch
      const data = await authGet(CONFIG.ENDPOINTS.users, 'find');

      if (Array.isArray(data) && data.length === 0) {
        setStatsPlaceholder('0');
        document.getElementById('stats-notice').classList.remove('d-none');
        document.getElementById('vencimientos-tbody').innerHTML =
          '<tr><td colspan="4" class="text-center text-muted py-4">' +
          '<i class="bi bi-check-circle-fill text-success me-2"></i>' +
          'No hay vencimientos próximos disponibles.</td></tr>';
        return;
      }

      // Cuando el endpoint esté implementado procesar aquí
      if (data && typeof data === 'object') {
        if (data.totalAlumnos   !== undefined) document.getElementById('stat-alumnos').textContent    = data.totalAlumnos;
        if (data.totalCategorias !== undefined) document.getElementById('stat-categorias').textContent = data.totalCategorias;
        if (data.totalEvaluados  !== undefined) document.getElementById('stat-evaluados').textContent  = data.totalEvaluados;
        if (data.pagosVencidos   !== undefined) document.getElementById('stat-pagos').textContent      = data.pagosVencidos;
      }

    } catch (err) {
      // El endpoint aún no existe en el back — mostrar placeholder sin romper la UI
      setStatsPlaceholder('—');
      document.getElementById('stats-notice').classList.remove('d-none');
      document.getElementById('vencimientos-tbody').innerHTML =
        '<tr><td colspan="4" class="text-center text-muted py-4">' +
        '<i class="bi bi-hourglass-split me-2"></i>' +
        'Estadísticas pendientes de implementar en el backend.</td></tr>';
    }
  }
</script>
{% endblock %}
