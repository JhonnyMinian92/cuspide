{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'dashboard' %}

{% block title %}Dashboard — Huaquillas F.C.{% endblock %}
{% block page_title %}Panel de Control{% endblock %}

{% block content %}
<!-- Tarjetas de estadísticas
     Los valores se actualizan via fetch a ?api=estadistica en app.js.
     Mientras el endpoint devuelve [] se muestran en 0 con indicador de construcción. -->
<div class="row g-4 mb-4">
  <!-- Total Alumnos -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#1a2235;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Total Alumnos</div>
          <div class="stat-value" id="stat-alumnos">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
      </div>
    </div>
  </div>
  <!-- Categorías Activas -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#0d9488;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Categorías Activas</div>
          <div class="stat-value" id="stat-categorias">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-tags-fill"></i></div>
      </div>
    </div>
  </div>
  <!-- Alumnos Evaluados -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#d97706;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Alumnos Evaluados</div>
          <div class="stat-value" id="stat-evaluados">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-clipboard-check-fill"></i></div>
      </div>
    </div>
  </div>
  <!-- Pagos Vencidos -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card stat-card text-white" style="background:#dc2626;">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <div class="stat-label">Pagos Vencidos</div>
          <div class="stat-value" id="stat-pagos">—</div>
        </div>
        <div class="stat-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- Aviso de estadísticas en construcción -->
<div class="alert alert-info d-flex align-items-center mb-4" role="alert" id="stats-notice" style="display:none!important;">
  <i class="bi bi-info-circle-fill me-2"></i>
  Las estadísticas detalladas están en construcción. El endpoint <code>?api=estadistica</code> aún está pendiente de implementar.
</div>

<!-- Tabla Próximos Vencimientos -->
<div class="card chart-card">
  <div class="card-body p-4">
    <h6 class="fw-bold mb-3">Próximos Vencimientos</h6>
    <div class="table-responsive table-container">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Alumno</th>
            <th>Membresía</th>
            <th>Fecha Vencimiento</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody id="vencimientos-tbody">
          <tr>
            <td colspan="4" class="text-center text-muted py-4">
              <i class="bi bi-clock-history me-2"></i>
              Cargando vencimientos...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  /**
   * Al cargar el dashboard:
   * 1. Verificar autenticación (checkAuth en app.js redirige a / si no hay token)
   * 2. Cargar estadísticas via GET ?api=estadistica
   * 3. Mostrar el mensaje de en construcción si el array viene vacío
   */
  document.addEventListener('DOMContentLoaded', async function () {
    // checkAuth() y loadUserProfile() / loadInstitucion() / loadMenu() se invocan desde app.js
    await loadEstadisticas();
  });

  // IDs de las tarjetas de estadísticas (usados en múltiples lugares del bloque)
  const STAT_IDS = ['stat-alumnos', 'stat-categorias', 'stat-evaluados', 'stat-pagos'];

  function setStatsZero() {
    STAT_IDS.forEach(function(id) {
      document.getElementById(id).textContent = '0';
    });
  }

  async function loadEstadisticas() {
    const token = localStorage.getItem('token');
    try {
      // Fetch al endpoint de estadísticas
      const res = await fetch('/app/controllers/api/users/index.php?api=estadistica', {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      const json = await res.json();
      const data = json.data;

      // El endpoint actualmente devuelve [] — mostrar aviso y valores en 0
      if (Array.isArray(data) && data.length === 0) {
        setStatsZero();
        document.getElementById('stats-notice').style.removeProperty('display');

        document.getElementById('vencimientos-tbody').innerHTML = `
          <tr>
            <td colspan="4" class="text-center text-muted py-4">
              <i class="bi bi-check-circle-fill text-success me-2"></i>
              No hay vencimientos próximos disponibles.
            </td>
          </tr>`;
      } else {
        // Cuando el endpoint sea implementado, procesar los datos aquí
        document.getElementById('stats-notice').style.removeProperty('display');
      }
    } catch (err) {
      // Error de red: mostrar ceros
      setStatsZero();
      document.getElementById('vencimientos-tbody').innerHTML = `
        <tr>
          <td colspan="4" class="text-center text-muted py-4">
            <i class="bi bi-wifi-off me-2"></i>No se pudo cargar la información.
          </td>
        </tr>`;
    }
  }
</script>
{% endblock %}
