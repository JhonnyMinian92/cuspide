.form-switch .form-check-input { cursor:pointer; }
.table-container { overflow-x:auto; }
</style>

{% endblock %}

{% block scripts %}
<script>
/* ════════════════════════════════════════════════════════════
   HELPERS GLOBALES
════════════════════════════════════════════════════════════ */
function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}

function showToast(msg, type) {
  type = type || 'success';
  if (type === 'error') type = 'danger';
  var icons = { success:'check-circle-fill', danger:'x-circle-fill', warning:'exclamation-triangle-fill', info:'info-circle-fill' };
  var t = document.createElement('div');
  t.className = 'toast align-items-center border-0 text-white bg-' + type + ' show';
  t.setAttribute('role','alert');
  t.innerHTML =
    '<div class="d-flex"><div class="toast-body">' +
    '<i class="bi bi-' + (icons[type] || 'info-circle-fill') + ' me-2"></i>' + esc(msg) +
    '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.closest(\'.toast\').remove()"></button></div>';
  var c = document.getElementById('toast-container');
  if (c) c.appendChild(t);
  setTimeout(function() { if (t.parentNode) t.remove(); }, 4000);
}

function debounce(fn, ms) {
  var timer;
  return function() {
    var args = arguments;
    clearTimeout(timer);
    timer = setTimeout(function() { fn.apply(null, args); }, ms);
  };
}

function togglePwd(inputId, btnId) {
  var inp = document.getElementById(inputId);
  var btn = document.getElementById(btnId);
  if (!inp) return;
  if (inp.type === 'password') {
    inp.type = 'text';
    if (btn) btn.querySelector('i').className = 'bi bi-eye-slash';
  } else {
    inp.type = 'password';
    if (btn) btn.querySelector('i').className = 'bi bi-eye';
  }
}

var institucionId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;

/* ════════════════════════════════════════════════════════════
   CATÁLOGOS LOCALES
════════════════════════════════════════════════════════════ */
var TIPO_LABELS = {
  'DEV_USER':       'Desarrollador',
  'ADMIN':          'Administrador',
  'ESTUDIANTE':     'Estudiante',
  'PROFESOR':       'Entrenador / Profesor',
  'MEDICO':         'Personal Médico',
  'ADMINISTRATIVO': 'Administrativo',
};

function tipoLabel(t) {
  return TIPO_LABELS[t] || t || '—';
}

/* ════════════════════════════════════════════════════════════
   TAB 1: USUARIOS
════════════════════════════════════════════════════════════ */

/* ── Estado ── */
var allUsuarios   = [];   // cache de todos los usuarios cargados
var searchTerm    = '';
var apiListFailed = false;

/* ── Fallback estático mientras la API no esté lista ── */
var STATIC_USUARIOS = [
  { id: 1, username: 'csoberon', type: 'DEV_USER', estado: 1, image: '' },
];

/* ── Cargar usuarios via API ── */
function loadUsuarios() {
  document.getElementById('usuarios-tbody').innerHTML =
    '<tr><td colspan="5" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>';
  document.getElementById('usuarios-info').textContent = 'Cargando usuarios...';

  Cuspide.api.call('GET', CONFIG.ENDPOINTS.usuarios, 'list', null, null)
    .then(function(data) {
      apiListFailed = false;
      allUsuarios = Array.isArray(data) ? data : [];
      renderUsuariosTable(allUsuarios);
    })
    .catch(function() {
      apiListFailed = true;
      allUsuarios = STATIC_USUARIOS.slice();
      renderUsuariosTable(allUsuarios);
      document.getElementById('usuarios-info').textContent =
        'API de listado en desarrollo — mostrando datos locales.';
    });
}

/* ── Renderizar tabla ── */
function renderUsuariosTable(items) {
  var tbody = document.getElementById('usuarios-tbody');
  var info  = document.getElementById('usuarios-info');

  if (!items || items.length === 0) {
    tbody.innerHTML =
      '<tr><td colspan="5" class="text-center text-muted py-5">' +
      '<i class="bi bi-person-x fs-2 d-block mb-2 opacity-25"></i>' +
      'No se encontraron usuarios.' +
      '</td></tr>';
    if (info && !apiListFailed) info.textContent = '0 usuarios encontrados.';
    // Mostrar formulario crear cuando búsqueda no da resultados
    if (searchTerm.length >= 1) {
      showCrearForm(searchTerm);
    }
    return;
  }

  // Ocultar form crear si había resultados
  if (searchTerm.length >= 1) {
    hideCrearForm();
  }

  if (info && !apiListFailed) info.textContent = items.length + ' usuario(s) encontrado(s).';

  tbody.innerHTML = items.map(function(u) {
    var estadoBadge = parseInt(u.estado) !== 0
      ? '<span class="badge bg-success rounded-pill">Activo</span>'
      : '<span class="badge bg-secondary rounded-pill">Inactivo</span>';
    var avatarLetter = (u.username || 'U').charAt(0).toUpperCase();
    return '<tr>' +
      '<td class="ps-4"><code>#' + esc(u.id) + '</code></td>' +
      '<td>' +
        '<div class="d-flex align-items-center gap-2">' +
          '<div class="avatar-circle flex-shrink-0" style="width:34px;height:34px;font-size:.85rem;">' + esc(avatarLetter) + '</div>' +
          '<span class="fw-semibold">' + esc(u.username) + '</span>' +
        '</div>' +
      '</td>' +
      '<td><span class="badge rounded-pill" style="background:var(--app-surface-soft);color:var(--app-text-soft);border:1px solid var(--app-border);">' + esc(tipoLabel(u.type)) + '</span></td>' +
      '<td>' + estadoBadge + '</td>' +
      '<td class="text-end pe-3">' +
        '<div class="d-flex gap-1 justify-content-end">' +
          '<button type="button" class="btn btn-sm btn-outline-primary" ' +
            'onclick="openEditarUsuario(' + u.id + ',\'' + esc(u.username) + '\',\'' + esc(u.type) + '\',\'' + esc(u.image || '') + '\')">' +
            '<i class="bi bi-pencil me-1"></i>Editar</button>' +
          '<button type="button" class="btn btn-sm btn-outline-danger" ' +
            'onclick="deshabilitarUsuario(' + u.id + ',\'' + esc(u.username) + '\',' + (parseInt(u.estado) !== 0 ? 1 : 0) + ')">' +
            (parseInt(u.estado) !== 0
              ? '<i class="bi bi-slash-circle me-1"></i>Deshabilitar'
              : '<i class="bi bi-check-circle me-1"></i>Habilitar') +
          '</button>' +
        '</div>' +
      '</td>' +
    '</tr>';
  }).join('');
}

/* ── Búsqueda con debounce ── */
var doUserSearch = debounce(function(q) {
  searchTerm = q;
  if (q.length === 0) {
    renderUsuariosTable(allUsuarios);
    hideCrearForm();
    document.getElementById('usuarios-info').textContent = allUsuarios.length + ' usuario(s) registrado(s).';
    return;
  }

  document.getElementById('user-search-spinner').classList.remove('d-none');
  var filtered = allUsuarios.filter(function(u) {
    return (u.username || '').toLowerCase().indexOf(q.toLowerCase()) !== -1;
  });
  document.getElementById('user-search-spinner').classList.add('d-none');
  renderUsuariosTable(filtered);
}, 350);

/* ── Formulario crear: mostrar / ocultar ── */
function showCrearForm(prefillUsername) {
  var card = document.getElementById('form-crear-usuario-card');
  card.classList.remove('d-none');
  if (prefillUsername) {
    var inp = document.getElementById('c-username');
    if (inp && !inp.value) inp.value = prefillUsername;
  }
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function hideCrearForm() {
  document.getElementById('form-crear-usuario-card').classList.add('d-none');
  document.getElementById('form-crear-usuario').reset();
}

/* ── Formulario editar: mostrar / ocultar ── */
function openEditarUsuario(id, username, tipo, imagen) {
  document.getElementById('e-user-id').value    = id;
  document.getElementById('e-username').value   = username || '';
  document.getElementById('e-password').value   = '';
  document.getElementById('e-imagen').value     = imagen || '';
  // Tipo de usuario select
  var sel = document.getElementById('e-tipo-user');
  for (var i = 0; i < sel.options.length; i++) {
    sel.options[i].selected = (sel.options[i].value === tipo);
  }
  document.getElementById('edit-usuario-title').textContent = username || '';
  var card = document.getElementById('form-editar-usuario-card');
  card.classList.remove('d-none');
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function hideEditarForm() {
  document.getElementById('form-editar-usuario-card').classList.add('d-none');
  document.getElementById('form-editar-usuario').reset();
}

/* ── Deshabilitar / habilitar usuario ── */
function deshabilitarUsuario(id, username, currentEstado) {
  var accion  = currentEstado === 1 ? 'deshabilitar' : 'habilitar';
  var confirm = window.confirm('¿' + (accion.charAt(0).toUpperCase() + accion.slice(1)) + ' al usuario "' + username + '"?');
  if (!confirm) return;

  Cuspide.api.call('PUT', CONFIG.ENDPOINTS.usuarios, 'disable', null, { id: id })
    .then(function() {
      showToast('Usuario ' + accion + 'do correctamente.', 'success');
      loadUsuarios();
    })
    .catch(function(err) {
      showToast(err.message || ('Error al ' + accion + ' el usuario.'), 'danger');
    });
}

/* ── Crear usuario: submit ── */
document.getElementById('form-crear-usuario').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('btn-submit-crear');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creando...';

  var username  = document.getElementById('c-username').value.trim();
  var password  = document.getElementById('c-password').value;
  var tipo_user = document.getElementById('c-tipo-user').value;
  var imagen    = document.getElementById('c-imagen').value.trim();

  if (!username || !password || !tipo_user) {
    showToast('Completa los campos requeridos.', 'warning');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Crear Usuario';
    return;
  }

  var body = { username: username, password: password, tipo_user: tipo_user };
  if (imagen) body.imagen = imagen;

  Cuspide.api.call('POST', CONFIG.ENDPOINTS.usuarios, 'save', body, null)
    .then(function() {
      showToast('Usuario "' + username + '" creado correctamente.', 'success');
      hideCrearForm();
      searchTerm = '';
      document.getElementById('usuario-search').value = '';
      loadUsuarios();
    })
    .catch(function(err) {
      showToast(err.message || 'Error al crear el usuario.', 'danger');
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Crear Usuario';
    });
});

/* ── Editar usuario: submit ── */
document.getElementById('form-editar-usuario').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('btn-submit-editar');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var id        = document.getElementById('e-user-id').value;
  var username  = document.getElementById('e-username').value.trim();
  var password  = document.getElementById('e-password').value;
  var tipo_user = document.getElementById('e-tipo-user').value;
  var imagen    = document.getElementById('e-imagen').value.trim();

  if (!username || !tipo_user) {
    showToast('Username y Tipo de Usuario son requeridos.', 'warning');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar Cambios';
    return;
  }

  var body = { username: username, tipo_user: tipo_user };
  if (password) body.password = password;
  if (imagen)   body.imagen   = imagen;

  Cuspide.api.call('PUT', CONFIG.ENDPOINTS.usuarios, 'save', body, { id: id })
    .then(function() {
      showToast('Usuario actualizado correctamente.', 'success');
      hideEditarForm();
      loadUsuarios();
    })
    .catch(function(err) {
      showToast(err.message || 'Error al actualizar el usuario.', 'danger');
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar Cambios';
    });
});

/* ── Botones de cancel/limpiar ── */
document.getElementById('btn-nuevo-usuario').addEventListener('click', function() {
  hideEditarForm();
  showCrearForm('');
});
document.getElementById('btn-cancelar-crear').addEventListener('click', hideCrearForm);
document.getElementById('btn-cancelar-crear-2').addEventListener('click', hideCrearForm);
document.getElementById('btn-cancelar-editar').addEventListener('click', hideEditarForm);
document.getElementById('btn-cancelar-editar-2').addEventListener('click', hideEditarForm);

document.getElementById('usuario-search').addEventListener('input', function() {
  doUserSearch(this.value.trim());
});

document.getElementById('btn-limpiar-usuarios').addEventListener('click', function() {
  document.getElementById('usuario-search').value = '';
  searchTerm = '';
  renderUsuariosTable(allUsuarios);
  hideCrearForm();
  hideEditarForm();
  document.getElementById('usuarios-info').textContent = allUsuarios.length + ' usuario(s) registrado(s).';
  document.getElementById('usuario-search').focus();
});


/* ════════════════════════════════════════════════════════════
   TAB 3: PERMISOS DE MENÚ
════════════════════════════════════════════════════════════ */

var currentPermisosTipo = '';

/* ── Cargar botones para tipo seleccionado ── */
function loadPermisos(tipo) {
  currentPermisosTipo = tipo;
  var tbody = document.getElementById('permisos-tbody');
  var info  = document.getElementById('permisos-info');

  tbody.innerHTML =
    '<tr><td colspan="6" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>';
  info.textContent = 'Cargando botones para ' + tipoLabel(tipo) + '...';

  // Mostrar/ocultar form nuevo botón
  var formCard = document.getElementById('form-nuevo-boton-card');
  formCard.classList.remove('d-none');
  document.getElementById('nb-tipo-user').value       = tipo;
  document.getElementById('nb-tipo-user-hidden').value = tipo;
  document.getElementById('nb-institucion').value      = institucionId;

  Cuspide.api.call('GET', CONFIG.ENDPOINTS.usuarios, 'buttons', null, { tipo_user: tipo, institucion: institucionId })
    .then(function(data) {
      var items = Array.isArray(data) ? data : [];
      renderPermisosTable(items, tipo);
      info.textContent = items.length + ' botón(es) para ' + tipoLabel(tipo) + '.';
    })
    .catch(function(err) {
      tbody.innerHTML =
        '<tr><td colspan="6" class="text-center text-danger py-4">' +
        '<i class="bi bi-exclamation-circle me-2"></i>' + esc(err.message || 'Error al cargar botones.') +
        '</td></tr>';
      info.textContent = 'Error al cargar.';
    });
}

/* ── Renderizar tabla de botones ── */
function renderPermisosTable(items, tipo) {
  var tbody = document.getElementById('permisos-tbody');

  if (!items.length) {
    tbody.innerHTML =
      '<tr><td colspan="6" class="text-center text-muted py-5">' +
      '<i class="bi bi-layout-sidebar fs-2 d-block mb-2 opacity-25"></i>' +
      'No hay botones asignados a "' + esc(tipoLabel(tipo)) + '".</td></tr>';
    return;
  }

  tbody.innerHTML = items.map(function(b) {
    var checked = parseInt(b.estado) !== 0;
    var iconEl  = b.icono
      ? '<i class="bi ' + esc(b.icono) + ' fs-5"></i>'
      : '<span class="text-muted small">—</span>';
    var tipoBadge = '<span class="badge rounded-pill" style="background:var(--app-surface-soft);color:var(--app-text-soft);border:1px solid var(--app-border);">' + esc(b.tipo || tipo) + '</span>';
    return '<tr>' +
      '<td class="ps-4 text-muted small">' + esc(b.orden || '—') + '</td>' +
      '<td class="fw-semibold">' + esc(b.nombre) + '</td>' +
      '<td>' + tipoBadge + '</td>' +
      '<td>' + iconEl + '</td>' +
      '<td>' +
        '<div class="form-check form-switch mb-0">' +
          '<input class="form-check-input" type="checkbox" role="switch" ' +
            'id="toggle-btn-' + esc(b.id) + '" ' +
            (checked ? 'checked' : '') + ' ' +
            'onchange="toggleBoton(' + b.id + ', this.checked)">' +
          '<label class="form-check-label small" for="toggle-btn-' + esc(b.id) + '">' +
            (checked ? 'Activo' : 'Inactivo') +
          '</label>' +
        '</div>' +
      '</td>' +
      '<td class="text-end pe-3">' +
        '<button type="button" class="btn btn-sm btn-outline-danger" ' +
          'onclick="toggleBoton(' + b.id + ', false, true)">' +
          '<i class="bi bi-trash"></i>' +
        '</button>' +
      '</td>' +
    '</tr>';
  }).join('');
}

/* ── Toggle estado de botón ── */
function toggleBoton(id, estadoActivo, forceOff) {
  var estado = forceOff ? 0 : (estadoActivo ? 1 : 0);
  var label  = document.querySelector('label[for="toggle-btn-' + id + '"]');

  Cuspide.api.call('PUT', CONFIG.ENDPOINTS.usuarios, 'button', { estado: estado }, { id: id })
    .then(function() {
      showToast('Botón ' + (estado ? 'activado' : 'desactivado') + ' correctamente.', 'success');
      if (label) label.textContent = estado ? 'Activo' : 'Inactivo';
      if (currentPermisosTipo) loadPermisos(currentPermisosTipo);
    })
    .catch(function(err) {
      showToast(err.message || 'Error al actualizar el botón.', 'danger');
      // Revertir el toggle visual
      var inp = document.getElementById('toggle-btn-' + id);
      if (inp) inp.checked = !estadoActivo;
      if (currentPermisosTipo) loadPermisos(currentPermisosTipo);
    });
}

/* ── Formulario nuevo botón: submit ── */
document.getElementById('form-nuevo-boton').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('btn-submit-boton');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Agregando...';

  var nombre    = document.getElementById('nb-nombre').value.trim();
  var ruta      = document.getElementById('nb-ruta').value.trim();
  var icono     = document.getElementById('nb-icono').value.trim();
  var tipo_user = document.getElementById('nb-tipo-user').value;
  var inst      = document.getElementById('nb-institucion').value || institucionId;

  if (!nombre || !ruta || !tipo_user) {
    showToast('Nombre, ruta y tipo de usuario son requeridos.', 'warning');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-plus-lg me-1"></i>Agregar Botón';
    return;
  }

  var body = { nombre: nombre, tipo_user: tipo_user, institucion: inst };
  if (ruta)  body.ruta  = ruta;
  if (icono) body.icono = icono;

  Cuspide.api.call('POST', CONFIG.ENDPOINTS.usuarios, 'button', body, null)
    .then(function() {
      showToast('Botón "' + nombre + '" agregado correctamente.', 'success');
      document.getElementById('form-nuevo-boton').reset();
      document.getElementById('nb-icono-icon').className = 'bi bi-question-circle';
      if (currentPermisosTipo) {
        document.getElementById('nb-tipo-user').value = currentPermisosTipo;
        loadPermisos(currentPermisosTipo);
      }
    })
    .catch(function(err) {
      showToast(err.message || 'Error al agregar el botón.', 'danger');
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-plus-lg me-1"></i>Agregar Botón';
    });
});

/* ── Preview de icono en tiempo real ── */
document.getElementById('nb-icono').addEventListener('input', function() {
  var val  = this.value.trim();
  var icon = document.getElementById('nb-icono-icon');
  icon.className = val ? 'bi ' + val : 'bi bi-question-circle';
});

/* ── Reset limpia el preview ── */
document.getElementById('btn-reset-boton').addEventListener('click', function() {
  setTimeout(function() {
    document.getElementById('nb-icono-icon').className = 'bi bi-question-circle';
    if (currentPermisosTipo) {
      document.getElementById('nb-tipo-user').value = currentPermisosTipo;
    }
  }, 10);
});

/* ── Cambio de tipo de usuario (select permisos) ── */
document.getElementById('permisos-tipo-select').addEventListener('change', function() {
  var tipo = this.value;
  if (!tipo) {
    document.getElementById('permisos-tbody').innerHTML =
      '<tr><td colspan="6" class="text-center text-muted py-5">' +
      '<i class="bi bi-layout-sidebar fs-2 d-block mb-2 opacity-25"></i>Selecciona un tipo de usuario.</td></tr>';
    document.getElementById('permisos-info').textContent = 'Selecciona un tipo de usuario para cargar sus botones.';
    document.getElementById('form-nuevo-boton-card').classList.add('d-none');
    currentPermisosTipo = '';
    return;
  }
  loadPermisos(tipo);
});

/* ── Sincronizar tipo al cambiar entre tabs ── */
document.getElementById('tab-permisos-btn').addEventListener('click', function() {
  institucionId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;
  document.getElementById('nb-institucion').value = institucionId;
});

/* ════════════════════════════════════════════════════════════
   INIT
════════════════════════════════════════════════════════════ */
function init() {
  loadUsuarios();
}

document.addEventListener('DOMContentLoaded', function() {
  checkAuth();
  init();
});
</script>
{% endblock %}
