{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'usuarios' %}
{% block title %}Usuarios — Huaquillas F.C.{% endblock %}
{% block page_title %}Gestión de Usuarios{% endblock %}

{% block content %}

<!-- ── Tabs de navegación ── -->
<ul class="nav nav-pills flex-wrap gap-1 mb-4" id="usuarios-tabs-nav" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="tab-usuarios-btn" data-bs-toggle="pill"
      data-bs-target="#tab-usuarios" type="button" role="tab" aria-selected="true">
      <i class="bi bi-people-fill me-1"></i>Usuarios
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="tab-tipos-btn" data-bs-toggle="pill"
      data-bs-target="#tab-tipos" type="button" role="tab" aria-selected="false">
      <i class="bi bi-shield-fill me-1"></i>Tipos de Usuario
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="tab-permisos-btn" data-bs-toggle="pill"
