      <i class="bi bi-layout-sidebar-fill me-1"></i>Permisos de Menú
    </button>
  </li>
</ul>

<div class="tab-content">

  <!-- ═══════════════════════════════════════════════════════
       TAB 1: USUARIOS
  ═══════════════════════════════════════════════════════ -->
  <div class="tab-pane fade show active" id="tab-usuarios" role="tabpanel">

    <!-- Buscador -->
