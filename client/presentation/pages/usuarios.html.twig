            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Tipo de Usuario *</label>
              <select class="form-select" id="c-tipo-user" name="tipo_user" required>
                <option value="">— Seleccionar —</option>
                <option value="DEV_USER">Desarrollador</option>
                <option value="ADMIN">Administrador</option>
                <option value="ESTUDIANTE">Estudiante</option>
                <option value="PROFESOR">Entrenador / Profesor</option>
                <option value="MEDICO">Personal Médico</option>
                <option value="ADMINISTRATIVO">Administrativo</option>
              </select>
