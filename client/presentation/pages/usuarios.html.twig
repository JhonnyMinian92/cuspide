              </span>
            </div>
          </div>
          <div class="col-12 col-lg-3">
            <label class="form-label d-none d-lg-block invisible">.</label>
            <button type="button" class="btn btn-outline-secondary w-100" id="btn-limpiar-usuarios">
              <i class="bi bi-x-circle me-1"></i>Limpiar
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de usuarios -->
    <div class="card chart-card mb-4" id="usuarios-table-card">
      <div class="card-body p-0">
        <div class="px-4 pt-4 pb-2 d-flex justify-content-between align-items-center">
          <div>
            <h6 class="fw-bold mb-0">Resultados</h6>
            <p class="text-muted small mb-0" id="usuarios-info">Cargando usuarios...</p>
          </div>
        </div>
        <div class="table-responsive table-container" style="border-radius:0 0 12px 12px; border-top:1px solid var(--table-border); border-left:none; border-right:none; border-bottom:none;">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4" style="width:60px;">ID</th>
                <th>Username</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th class="text-end pe-4">Acciones</th>
              </tr>
            </thead>
            <tbody id="usuarios-tbody">
              <tr>
                <td colspan="5" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Formulario crear usuario (aparece cuando no hay resultados o botón "Nuevo") -->
    <div class="card chart-card mb-4 d-none" id="form-crear-usuario-card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
          <div>
            <h6 class="fw-bold mb-1"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Usuario</h6>
            <p class="text-muted small mb-0">Completa los campos requeridos (*) para crear el usuario.</p>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-cancelar-crear">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <form id="form-crear-usuario" novalidate>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">Username *</label>
              <input type="text" class="form-control" id="c-username" name="username"
                placeholder="Ej: jperez" autocomplete="off" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Contraseña *</label>
              <div class="input-group">
