document.getElementById('form-act').addEventListener('submit', function(e) {
  e.preventDefault();
  var id = document.getElementById('act-id').value;
  var body = {
    nombre: document.getElementById('act-nombre').value.trim(),
    categoria_deportiva: document.getElementById('act-categoria-deportiva').value,
    nivel: document.getElementById('act-nivel').value,
    precio: document.getElementById('act-precio').value,
    cupo_maximo: document.getElementById('act-cupo-maximo').value,
    docente: document.getElementById('act-docente').value,
    periodo_academico: document.getElementById('act-periodo-academico').value,
    observacion: document.getElementById('act-observacion').value.trim(),
    estado: parseInt(document.getElementById('act-estado').value),
    institucion: institucionId
  };

  if (!body.nombre || !body.categoria_deportiva || !body.nivel || !body.precio || !body.cupo_maximo) {
    showToast('Completa los campos obligatorios.', 'warning');
    return;
  }

  // Convertir a números
  body.categoria_deportiva = parseInt(body.categoria_deportiva);
  body.nivel = parseInt(body.nivel);
  body.precio = parseFloat(body.precio);
  body.cupo_maximo = parseInt(body.cupo_maximo);
  body.docente = body.docente ? parseInt(body.docente) : null;
  body.periodo_academico = body.periodo_academico ? parseInt(body.periodo_academico) : null;

  var btn = document.getElementById('btn-act-submit');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var method = id ? 'PUT' : 'POST';
  var params = id ? { id: id } : null;
  apiCall(method, 'actividades', 'save', body, params)
    .then(function() {
      showToast(id ? 'Actividad actualizada.' : 'Actividad creada.', 'success');
      cerrarFormAct();
      loadActividades();
    })
    .catch(function(err) { showToast(err.message || 'Error al guardar.', 'error'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar'; });
});

