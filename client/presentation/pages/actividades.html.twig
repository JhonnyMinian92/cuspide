{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'actividades' %}
{% block title %}Actividades Deportivas — Huaquillas F.C.{% endblock %}
{% block page_title %}Actividades Deportivas{% endblock %}

{% block content %}
<style>
.toast-notification{position:fixed;top:1.2rem;right:1.2rem;z-index:9999;padding:.75rem 1.25rem;border-radius:.5rem;color:#fff;font-size:.9rem;opacity:0;transform:translateX(110%);transition:all .3s ease;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.4);}
.toast-notification.show{opacity:1;transform:translateX(0);}
.toast-success{background:#198754;}.toast-error{background:#dc3545;}.toast-warning{background:#ffc107;color:#212529;}.toast-info{background:#0dcaf0;color:#212529;}
.nav-tabs-custom .nav-link{border:none;border-bottom:3px solid transparent;color:var(--app-text-muted);font-weight:600;padding:.6rem 1.1rem;background:transparent;border-radius:0;}
.nav-tabs-custom .nav-link.active{color:var(--brand-color);border-bottom-color:var(--brand-color);background:transparent;}
.nav-tabs-custom .nav-link:hover:not(.active){color:var(--app-text);}
</style>

<!-- Tabs -->
<ul class="nav nav-tabs-custom border-bottom mb-4" id="tabs-main" style="border-color:var(--table-border);">
  <li class="nav-item">
    <button class="nav-link active" id="tab-actividades-btn" type="button" onclick="switchTab('actividades')">
      <i class="bi bi-trophy me-2"></i>Actividades
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" id="tab-deportes-btn" type="button" onclick="switchTab('deportes')">
      <i class="bi bi-dribbble me-2"></i>Deportes
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" id="tab-categorias-btn" type="button" onclick="switchTab('categorias')">
      <i class="bi bi-tags me-2"></i>Categorías
    </button>
  </li>
</ul>

<!-- ==================== TAB: ACTIVIDADES ==================== -->
<div id="panel-actividades">

  <!-- Header + Búsqueda -->
  <div class="card chart-card mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-start gap-3 mb-3">
        <div>
          <h6 class="fw-bold mb-1">Actividades Deportivas</h6>
          <p class="text-muted small mb-0">Gestiona las actividades del club. Busca, edita o desactiva actividades existentes.</p>
        </div>
        <button type="button" class="btn btn-brand flex-shrink-0" id="btn-nueva-actividad">
          <i class="bi bi-plus-lg me-1"></i>Nueva Actividad
        </button>
      </div>
      <div class="row g-3 align-items-center">
        <div class="col-12 col-lg-10">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" id="act-search"
              placeholder="Buscar por nombre, deporte o nivel..." autocomplete="off">
            <span class="input-group-text d-none" id="act-search-spinner">
              <span class="spinner-border spinner-border-sm" role="status"></span>
            </span>
          </div>
        </div>
        <div class="col-12 col-lg-2">
          <button type="button" class="btn btn-outline-secondary w-100" id="btn-act-limpiar">
            <i class="bi bi-x-circle me-1"></i>Limpiar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla actividades -->
  <div class="card chart-card mb-4">
    <div class="card-body p-0">
      <div class="px-4 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-0">Listado</h6>
          <p class="text-muted small mb-0" id="act-list-info">Cargando...</p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-act-reload" title="Recargar">
          <i class="bi bi-arrow-repeat"></i>
        </button>
      </div>
      <div class="table-responsive" style="border-top:1px solid var(--table-border);">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Nombre</th>
              <th>Deporte</th>
              <th>Nivel</th>
              <th class="text-end">Precio</th>
              <th class="text-center">Matriculados</th>
              <th class="text-center">Asistencias</th>
              <th class="text-center">Faltas</th>
              <th class="text-center">Estado</th>
              <th class="text-end pe-4">Acciones</th>
            </tr>
          </thead>
          <tbody id="act-list-tbody">
            <tr><td colspan="9" class="text-center text-muted py-5">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando actividades...
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Formulario Crear / Editar (inline, d-none por defecto) -->
  <div class="card chart-card mb-4 d-none" id="form-act-card">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h6 class="fw-bold mb-1" id="form-act-title"><i class="bi bi-trophy me-2"></i>Nueva Actividad</h6>
          <p class="text-muted small mb-0">Completa los datos de la actividad deportiva.</p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-act-form-cerrar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <form id="form-act" novalidate>
        <input type="hidden" id="act-id" value="">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Nombre *</label>
            <input type="text" class="form-control" id="act-nombre" placeholder="Ej: Fútbol Sub-15" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Deporte *</label>
            <select class="form-select" id="act-deporte" required>
              <option value="">Cargando...</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Nivel *</label>
            <select class="form-select" id="act-nivel" required>
              <option value="">— Seleccionar —</option>
              <option value="1">Iniciación</option>
              <option value="2">Básico</option>
              <option value="3">Intermedio</option>
              <option value="4">Avanzado</option>
              <option value="5">Élite</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Precio ($) *</label>
            <input type="number" class="form-control" id="act-precio" placeholder="0.00" min="0" step="0.01" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Estado</label>
            <select class="form-select" id="act-estado">
              <option value="1">Activo</option>
              <option value="0">Inactivo</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Observación</label>
            <input type="text" class="form-control" id="act-observacion" placeholder="Observaciones opcionales...">
          </div>
        </div>
        <div class="d-flex gap-2 justify-content-end mt-4">
          <button type="button" class="btn btn-outline-secondary" id="btn-act-cancelar">
            <i class="bi bi-x-lg me-1"></i>Cancelar
          </button>
          <button type="submit" class="btn btn-brand" id="btn-act-submit">
            <i class="bi bi-check-lg me-1"></i>Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Sección Asistencias -->
  <div class="card chart-card mb-4">
    <div class="card-body p-4">
      <h6 class="fw-bold mb-1"><i class="bi bi-clipboard2-check me-2"></i>Registrar Asistencia a Actividad</h6>
      <p class="text-muted small mb-4">Registra la presencia de un matriculado en una actividad y horario específicos.</p>
      <form id="form-asistencia" novalidate>
        <div class="row g-3">
          <div class="col-md-3">
            <label class="form-label fw-semibold">Fecha *</label>
            <input type="date" class="form-control" id="asi-fecha" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Actividad *</label>
            <select class="form-select" id="asi-actividad" required>
              <option value="">— Seleccionar —</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Horario *</label>
            <select class="form-select" id="asi-horario" required>
              <option value="">— Seleccionar actividad —</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Matrícula ID *</label>
            <input type="number" class="form-control" id="asi-matricula" placeholder="ID de matrícula" required min="1">
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Estado *</label>
            <select class="form-select" id="asi-estado" required>
              <option value="1">Presente</option>
              <option value="2">Ausente</option>
              <option value="3">Justificado</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Hora de Entrada</label>
            <input type="time" class="form-control" id="asi-hora-entrada">
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Hora de Salida</label>
            <input type="time" class="form-control" id="asi-hora-salida">
          </div>
        </div>
        <div class="d-flex justify-content-end mt-4">
          <button type="submit" class="btn btn-brand" id="btn-asi-submit">
            <i class="bi bi-clipboard2-plus me-1"></i>Registrar Asistencia
          </button>
        </div>
      </form>
    </div>
  </div>

</div><!-- /panel-actividades -->

<!-- ==================== TAB: DEPORTES ==================== -->
<div id="panel-deportes" class="d-none">

  <div class="card chart-card mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-start gap-3 mb-3">
        <div>
          <h6 class="fw-bold mb-1">Deportes</h6>
          <p class="text-muted small mb-0">Administra los deportes disponibles en el club.</p>
        </div>
        <button type="button" class="btn btn-brand flex-shrink-0" id="btn-nuevo-deporte">
          <i class="bi bi-plus-lg me-1"></i>Nuevo Deporte
        </button>
      </div>
      <div class="row g-3 align-items-center">
        <div class="col-12 col-lg-10">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" id="dep-search"
              placeholder="Buscar deporte..." autocomplete="off">
          </div>
        </div>
        <div class="col-12 col-lg-2">
          <button type="button" class="btn btn-outline-secondary w-100" id="btn-dep-limpiar">
            <i class="bi bi-x-circle me-1"></i>Limpiar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla deportes -->
  <div class="card chart-card mb-4">
    <div class="card-body p-0">
      <div class="px-4 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-0">Listado de Deportes</h6>
          <p class="text-muted small mb-0" id="dep-list-info">Cargando...</p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-dep-reload" title="Recargar">
          <i class="bi bi-arrow-repeat"></i>
        </button>
      </div>
      <div class="table-responsive" style="border-top:1px solid var(--table-border);">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Descripción</th>
              <th class="text-center">Estado</th>
              <th class="text-end pe-4">Acciones</th>
            </tr>
          </thead>
          <tbody id="dep-list-tbody">
            <tr><td colspan="5" class="text-center text-muted py-5">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando deportes...
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Formulario crear/editar deporte -->
  <div class="card chart-card mb-4 d-none" id="form-dep-card">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h6 class="fw-bold mb-1" id="form-dep-title"><i class="bi bi-dribbble me-2"></i>Nuevo Deporte</h6>
          <p class="text-muted small mb-0">Ingresa los datos del deporte.</p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-dep-form-cerrar">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <form id="form-dep" novalidate>
        <input type="hidden" id="dep-id" value="">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Nombre *</label>
            <input type="text" class="form-control" id="dep-nombre" placeholder="Ej: Fútbol" required>
          </div>
          <div class="col-md-8">
            <label class="form-label fw-semibold">Descripción</label>
            <input type="text" class="form-control" id="dep-descripcion" placeholder="Descripción breve...">
          </div>
        </div>
        <div class="d-flex gap-2 justify-content-end mt-4">
          <button type="button" class="btn btn-outline-secondary" id="btn-dep-cancelar">
            <i class="bi bi-x-lg me-1"></i>Cancelar
          </button>
          <button type="submit" class="btn btn-brand" id="btn-dep-submit">
            <i class="bi bi-check-lg me-1"></i>Guardar
          </button>
        </div>
      </form>
    </div>
  </div>

</div><!-- /panel-deportes -->

<!-- ==================== TAB: CATEGORÍAS ==================== -->
<div id="panel-categorias" class="d-none">

  <div class="card chart-card mb-4">
    <div class="card-body p-0">
      <div class="px-4 pt-4 pb-3 d-flex justify-content-between align-items-center">
        <div>
          <h6 class="fw-bold mb-1"><i class="bi bi-tags me-2"></i>Categorías Deportivas</h6>
          <p class="text-muted small mb-0" id="cat-list-info">Cargando...</p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-cat-reload" title="Recargar">
          <i class="bi bi-arrow-repeat"></i>
        </button>
      </div>
      <div class="table-responsive" style="border-top:1px solid var(--table-border);">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Nombre</th>
              <th>Nemónico</th>
              <th>Deporte</th>
              <th class="text-center">Edad Mín.</th>
              <th class="text-center">Edad Máx.</th>
              <th class="text-center">Estado</th>
            </tr>
          </thead>
          <tbody id="cat-list-tbody">
            <tr><td colspan="6" class="text-center text-muted py-5">
              <span class="spinner-border spinner-border-sm me-2"></span>Cargando categorías...
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div><!-- /panel-categorias -->

{% endblock %}

{% block scripts %}
<script>
/* ── Helpers globales ── */
function showToast(msg, type) {
  type = type || 'success';
  var t = document.createElement('div');
  t.className = 'toast-notification toast-' + type;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function() { t.classList.add('show'); }, 10);
  setTimeout(function() { t.classList.remove('show'); setTimeout(function() { t.remove(); }, 300); }, 3200);
}
function formatMoney(v) { return '$' + parseFloat(v || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function debounce(fn, ms) {
  var t;
  return function() { var a = arguments; clearTimeout(t); t = setTimeout(function() { fn.apply(null, a); }, ms); };
}
var institucionId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;

/* ── API helpers ── */
function apiCall(method, endpoint, action, body, params) {
  return Cuspide.api.call(method, CONFIG.ENDPOINTS[endpoint], action, body, params);
}

/* ── Estado ── */
var actividadesData = [];
var deportesData    = [];

/* ─────────────────────────────────────────────
   TABS
───────────────────────────────────────────── */
function switchTab(tab) {
  ['actividades','deportes','categorias'].forEach(function(t) {
    document.getElementById('panel-' + t).classList.toggle('d-none', t !== tab);
    document.getElementById('tab-' + t + '-btn').classList.toggle('active', t === tab);
  });
  if (tab === 'deportes' && deportesData.length === 0) loadDeportes();
  if (tab === 'categorias') loadCategorias();
}

/* ─────────────────────────────────────────────
   TAB ACTIVIDADES — LISTADO
───────────────────────────────────────────── */
function loadActividades() {
  document.getElementById('act-list-info').textContent = 'Cargando...';
  apiCall('GET', 'actividades', 'list', null, { institucion: institucionId })
    .then(function(data) {
      actividadesData = Array.isArray(data) ? data : [];
      renderActividades(actividadesData);
      poblarSelectActividades();
    })
    .catch(function(err) {
      document.getElementById('act-list-tbody').innerHTML =
        '<tr><td colspan="9" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-2"></i>' + esc(err.message || 'Error al cargar') + '</td></tr>';
      document.getElementById('act-list-info').textContent = 'Error al cargar.';
    });
}

function renderActividades(items) {
  var tbody = document.getElementById('act-list-tbody');
  var info  = document.getElementById('act-list-info');
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-5"><i class="bi bi-trophy fs-2 d-block mb-2 opacity-25"></i>Sin actividades registradas.</td></tr>';
    info.textContent = 'Sin resultados.';
    return;
  }
  info.textContent = items.length + ' actividad(es).';
  tbody.innerHTML = items.map(function(a) {
    var estadoBadge = parseInt(a.estado) === 1
      ? '<span class="badge rounded-pill bg-success">Activo</span>'
      : '<span class="badge rounded-pill bg-secondary">Inactivo</span>';
    return '<tr>' +
      '<td class="fw-semibold">' + esc(a.nombre) + '</td>' +
      '<td>' + esc(a.deporte || '—') + '</td>' +
      '<td><span class="badge rounded-pill" style="background:var(--info-bg);color:var(--info-text);border:1px solid var(--info-border);">' + esc(a.nivel || '—') + '</span></td>' +
      '<td class="text-end fw-semibold">' + formatMoney(a.precio) + '</td>' +
      '<td class="text-center">' + esc(a.matriculados || 0) + '</td>' +
      '<td class="text-center text-success">' + esc(a.asistencias || 0) + '</td>' +
      '<td class="text-center text-danger">' + esc(a.faltas || 0) + '</td>' +
      '<td class="text-center">' + estadoBadge + '</td>' +
      '<td class="text-end pe-3">' +
        '<button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="verCupo(' + a.id + ')" title="Ver cupo"><i class="bi bi-people"></i></button>' +
        '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="editarActividad(' + a.id + ')" title="Editar"><i class="bi bi-pencil"></i></button>' +
        '<button type="button" class="btn btn-sm btn-outline-danger" onclick="desactivarActividad(' + a.id + ')" title="Desactivar"><i class="bi bi-slash-circle"></i></button>' +
      '</td></tr>';
  }).join('');
}

/* ── Búsqueda actividades (debounce 350ms) ── */
var doActSearch = debounce(function(q) {
  var filtered = actividadesData.filter(function(a) {
    var hay = (a.nombre + ' ' + (a.deporte || '') + ' ' + (a.nivel || '')).toLowerCase();
    return hay.indexOf(q.toLowerCase()) !== -1;
  });
  renderActividades(filtered);
  if (filtered.length === 0 && q.length >= 2) {
    document.getElementById('form-act-card').classList.remove('d-none');
    document.getElementById('form-act-title').innerHTML = '<i class="bi bi-trophy me-2"></i>Nueva Actividad';
    document.getElementById('act-id').value = '';
    document.getElementById('form-act').reset();
    document.getElementById('form-act-card').scrollIntoView({ behavior: 'smooth' });
  }
}, 350);

document.getElementById('act-search').addEventListener('input', function() {
  var q = this.value.trim();
  if (q.length === 0) renderActividades(actividadesData);
  else if (q.length >= 2) doActSearch(q);
});
document.getElementById('btn-act-limpiar').addEventListener('click', function() {
  document.getElementById('act-search').value = '';
  renderActividades(actividadesData);
});

/* ── Cupo ── */
function verCupo(id) {
  apiCall('GET', 'actividades', 'capacity', null, { id: id })
    .then(function(data) {
      showToast('Cupo: ' + (data.ocupados || 0) + '/' + (data.cupo_maximo || 0) + ' — Disponible: ' + (data.disponible || 0), 'info');
    })
    .catch(function(err) { showToast(err.message || 'Error al obtener cupo.', 'error'); });
}

/* ── Editar actividad ── */
function editarActividad(id) {
  var a = actividadesData.find(function(x) { return x.id == id; });
  if (!a) return;
  document.getElementById('act-id').value     = a.id;
  document.getElementById('act-nombre').value = a.nombre || '';
  document.getElementById('act-precio').value = a.precio || '';
  document.getElementById('act-observacion').value = a.observacion || '';
  document.getElementById('act-estado').value = (a.estado !== undefined ? a.estado : 1);
  // Deporte: intentar coincidir por nombre
  var depSel = document.getElementById('act-deporte');
  Array.from(depSel.options).forEach(function(opt) {
    if (opt.textContent.trim().toLowerCase() === (a.deporte || '').toLowerCase()) depSel.value = opt.value;
  });
  // Nivel: coincide por nombre
  var nivNames = ['', 'iniciación', 'básico', 'intermedio', 'avanzado', 'élite'];
  var nivIdx = nivNames.findIndex(function(n) { return n === (a.nivel || '').toLowerCase(); });
  document.getElementById('act-nivel').value = nivIdx > 0 ? nivIdx : (a.nivel_id || '');

  document.getElementById('form-act-title').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Actividad';
  document.getElementById('form-act-card').classList.remove('d-none');
  document.getElementById('form-act-card').scrollIntoView({ behavior: 'smooth' });
}

/* ── Desactivar actividad ── */
function desactivarActividad(id) {
  if (!confirm('¿Desactivar esta actividad?')) return;
  apiCall('PUT', 'actividades', 'delete', null, { id: id })
    .then(function() {
      showToast('Actividad desactivada.', 'success');
      loadActividades();
    })
    .catch(function(err) { showToast(err.message || 'Error al desactivar.', 'error'); });
}

/* ── Formulario crear/editar ── */
document.getElementById('btn-nueva-actividad').addEventListener('click', function() {
  document.getElementById('act-id').value = '';
  document.getElementById('form-act').reset();
  document.getElementById('form-act-title').innerHTML = '<i class="bi bi-trophy me-2"></i>Nueva Actividad';
  document.getElementById('form-act-card').classList.remove('d-none');
  document.getElementById('form-act-card').scrollIntoView({ behavior: 'smooth' });
});

function cerrarFormAct() {
  document.getElementById('form-act-card').classList.add('d-none');
  document.getElementById('act-id').value = '';
  document.getElementById('form-act').reset();
}
document.getElementById('btn-act-form-cerrar').addEventListener('click', cerrarFormAct);
document.getElementById('btn-act-cancelar').addEventListener('click', cerrarFormAct);

document.getElementById('form-act').addEventListener('submit', function(e) {
  e.preventDefault();
  var id     = document.getElementById('act-id').value;
  var nombre = document.getElementById('act-nombre').value.trim();
  var deporte= document.getElementById('act-deporte').value;
  var nivel  = document.getElementById('act-nivel').value;
  var precio = document.getElementById('act-precio').value;
  var obs    = document.getElementById('act-observacion').value.trim();
  var estado = parseInt(document.getElementById('act-estado').value);

  if (!nombre || !deporte || !nivel || !precio) {
    showToast('Completa los campos obligatorios.', 'warning');
    return;
  }
  var body = { nombre: nombre, deporte: parseInt(deporte), precio: parseFloat(precio), nivel: parseInt(nivel), observacion: obs, institucion: institucionId, estado: estado };
  var btn = document.getElementById('btn-act-submit');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var method = id ? 'PUT' : 'POST';
  var params = id ? { id: id } : null;
  apiCall(method, 'actividades', 'save', body, params)
    .then(function() {
      showToast(id ? 'Actividad actualizada.' : 'Actividad creada.', 'success');
      cerrarFormAct();
      loadActividades();
    })
    .catch(function(err) { showToast(err.message || 'Error al guardar.', 'error'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar'; });
});

document.getElementById('btn-act-reload').addEventListener('click', loadActividades);

/* ─────────────────────────────────────────────
   ASISTENCIAS
───────────────────────────────────────────── */
function poblarSelectActividades() {
  var sel = document.getElementById('asi-actividad');
  var prev = sel.value;
  sel.innerHTML = '<option value="">— Seleccionar —</option>';
  actividadesData.forEach(function(a) {
    var opt = document.createElement('option');
    opt.value = a.id;
    opt.textContent = a.nombre;
    sel.appendChild(opt);
  });
  if (prev) sel.value = prev;
}

document.getElementById('asi-actividad').addEventListener('change', function() {
  var actId = this.value;
  var horSel = document.getElementById('asi-horario');
  horSel.innerHTML = '<option value="">Cargando...</option>';
  if (!actId) { horSel.innerHTML = '<option value="">— Seleccionar actividad —</option>'; return; }
  apiCall('GET', 'horarios', 'list', null, { actividad: actId })
    .then(function(data) {
      horSel.innerHTML = '<option value="">— Seleccionar horario —</option>';
      if (Array.isArray(data) && data.length) {
        data.forEach(function(h) {
          var opt = document.createElement('option');
          opt.value = h.id;
          opt.textContent = (h.nombre || 'Horario #' + h.id) + ' — ' + (h.dia_semana || '') + ' ' + (h.hora_inicio || '') + '-' + (h.hora_fin || '');
          horSel.appendChild(opt);
        });
      } else {
        horSel.innerHTML = '<option value="">Sin horarios disponibles</option>';
      }
    })
    .catch(function() { horSel.innerHTML = '<option value="">Error al cargar horarios</option>'; });
});

// Fecha por defecto: hoy
(function() {
  var today = new Date().toISOString().split('T')[0];
  document.getElementById('asi-fecha').value = today;
})();

document.getElementById('form-asistencia').addEventListener('submit', function(e) {
  e.preventDefault();
  var fecha       = document.getElementById('asi-fecha').value;
  var actividadId = document.getElementById('asi-actividad').value;
  var matriculaId = document.getElementById('asi-matricula').value;
  var horarioId   = document.getElementById('asi-horario').value;
  var estadoAsi   = document.getElementById('asi-estado').value;
  var horaEntrada = document.getElementById('asi-hora-entrada').value;
  var horaSalida  = document.getElementById('asi-hora-salida').value;

  if (!fecha || !actividadId || !matriculaId || !horarioId) {
    showToast('Completa todos los campos obligatorios.', 'warning');
    return;
  }
  var body = {
    matricula:    parseInt(matriculaId),
    actividad:    parseInt(actividadId),
    fecha:        fecha,
    estado:       parseInt(estadoAsi),
    horario:      parseInt(horarioId),
    hora_entrada: horaEntrada || null,
    hora_salida:  horaSalida  || null,
    observacion:  ''
  };
  var btn = document.getElementById('btn-asi-submit');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Registrando...';

  apiCall('POST', 'actividades', 'attendance', body, null)
    .then(function() {
      showToast('Asistencia registrada correctamente.', 'success');
      document.getElementById('form-asistencia').reset();
      document.getElementById('asi-fecha').value = new Date().toISOString().split('T')[0];
    })
    .catch(function(err) { showToast(err.message || 'Error al registrar asistencia.', 'error'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-clipboard2-plus me-1"></i>Registrar Asistencia'; });
});

/* ─────────────────────────────────────────────
   TAB DEPORTES
───────────────────────────────────────────── */
function loadDeportes() {
  document.getElementById('dep-list-info').textContent = 'Cargando...';
  apiCall('GET', 'deportes', 'list', null, null)
    .then(function(data) {
      deportesData = Array.isArray(data) ? data : [];
      renderDeportes(deportesData);
      poblarSelectDeportes();
    })
    .catch(function(err) {
      document.getElementById('dep-list-tbody').innerHTML =
        '<tr><td colspan="5" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-2"></i>' + esc(err.message || 'Error al cargar') + '</td></tr>';
      document.getElementById('dep-list-info').textContent = 'Error.';
    });
}

function renderDeportes(items) {
  var tbody = document.getElementById('dep-list-tbody');
  var info  = document.getElementById('dep-list-info');
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-5"><i class="bi bi-dribbble fs-2 d-block mb-2 opacity-25"></i>Sin deportes registrados.</td></tr>';
    info.textContent = 'Sin resultados.';
    return;
  }
  info.textContent = items.length + ' deporte(s).';
  tbody.innerHTML = items.map(function(d) {
    var estadoBadge = parseInt(d.estado) === 1
      ? '<span class="badge bg-success rounded-pill">Activo</span>'
      : '<span class="badge bg-secondary rounded-pill">Inactivo</span>';
    return '<tr>' +
      '<td><code>' + esc(d.id) + '</code></td>' +
      '<td class="fw-semibold">' + esc(d.nombre) + '</td>' +
      '<td class="text-muted small">' + esc(d.descripcion || '—') + '</td>' +
      '<td class="text-center">' + estadoBadge + '</td>' +
      '<td class="text-end pe-3">' +
        '<button type="button" class="btn btn-sm btn-outline-primary" onclick="editarDeporte(' + d.id + ')" title="Editar"><i class="bi bi-pencil"></i></button>' +
      '</td></tr>';
  }).join('');
}

function poblarSelectDeportes() {
  var sel = document.getElementById('act-deporte');
  var prev = sel.value;
  sel.innerHTML = '<option value="">— Seleccionar —</option>';
  deportesData.forEach(function(d) {
    var opt = document.createElement('option');
    opt.value = d.id;
    opt.textContent = d.nombre;
    sel.appendChild(opt);
  });
  if (prev) sel.value = prev;
}

/* Búsqueda deportes (filtro cliente) */
var doDepSearch = debounce(function(q) {
  var filtered = deportesData.filter(function(d) {
    return (d.nombre + ' ' + (d.descripcion || '')).toLowerCase().indexOf(q.toLowerCase()) !== -1;
  });
  renderDeportes(filtered);
  if (filtered.length === 0 && q.length >= 2) {
    document.getElementById('dep-nombre').value = q;
    document.getElementById('dep-id').value = '';
    document.getElementById('form-dep-title').innerHTML = '<i class="bi bi-dribbble me-2"></i>Nuevo Deporte';
    document.getElementById('form-dep-card').classList.remove('d-none');
    document.getElementById('form-dep-card').scrollIntoView({ behavior: 'smooth' });
  }
}, 350);

document.getElementById('dep-search').addEventListener('input', function() {
  var q = this.value.trim();
  if (q.length === 0) renderDeportes(deportesData);
  else if (q.length >= 2) doDepSearch(q);
});
document.getElementById('btn-dep-limpiar').addEventListener('click', function() {
  document.getElementById('dep-search').value = '';
  renderDeportes(deportesData);
});

/* Editar deporte */
function editarDeporte(id) {
  var d = deportesData.find(function(x) { return x.id == id; });
  if (!d) return;
  document.getElementById('dep-id').value          = d.id;
  document.getElementById('dep-nombre').value      = d.nombre || '';
  document.getElementById('dep-descripcion').value = d.descripcion || '';
  document.getElementById('form-dep-title').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Deporte';
  document.getElementById('form-dep-card').classList.remove('d-none');
  document.getElementById('form-dep-card').scrollIntoView({ behavior: 'smooth' });
}

function cerrarFormDep() {
  document.getElementById('form-dep-card').classList.add('d-none');
  document.getElementById('dep-id').value = '';
  document.getElementById('form-dep').reset();
}
document.getElementById('btn-dep-form-cerrar').addEventListener('click', cerrarFormDep);
document.getElementById('btn-dep-cancelar').addEventListener('click', cerrarFormDep);
document.getElementById('btn-nuevo-deporte').addEventListener('click', function() {
  document.getElementById('dep-id').value = '';
  document.getElementById('form-dep').reset();
  document.getElementById('form-dep-title').innerHTML = '<i class="bi bi-dribbble me-2"></i>Nuevo Deporte';
  document.getElementById('form-dep-card').classList.remove('d-none');
  document.getElementById('form-dep-card').scrollIntoView({ behavior: 'smooth' });
});

document.getElementById('form-dep').addEventListener('submit', function(e) {
  e.preventDefault();
  var id     = document.getElementById('dep-id').value;
  var nombre = document.getElementById('dep-nombre').value.trim();
  var desc   = document.getElementById('dep-descripcion').value.trim();
  if (!nombre) { showToast('El nombre es obligatorio.', 'warning'); return; }

  var body = { nombre: nombre, descripcion: desc, institucion: institucionId, estado: 1 };
  var btn = document.getElementById('btn-dep-submit');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var method = id ? 'PUT' : 'POST';
  var params = id ? { id: id } : null;
  apiCall(method, 'deportes', 'save', body, params)
    .then(function() {
      showToast(id ? 'Deporte actualizado.' : 'Deporte creado.', 'success');
      cerrarFormDep();
      deportesData = [];
      loadDeportes();
    })
    .catch(function(err) { showToast(err.message || 'Error al guardar.', 'error'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar'; });
});

document.getElementById('btn-dep-reload').addEventListener('click', function() { deportesData = []; loadDeportes(); });

/* ─────────────────────────────────────────────
   TAB CATEGORÍAS
───────────────────────────────────────────── */
function loadCategorias() {
  document.getElementById('cat-list-info').textContent = 'Cargando...';
  apiCall('GET', 'actividades', 'categories', null, { institucion: institucionId })
    .then(function(data) {
      renderCategorias(Array.isArray(data) ? data : []);
    })
    .catch(function() {
      // Intentar con endpoint 'deportes'
      apiCall('GET', 'deportes', 'categories', null, { institucion: institucionId })
        .then(function(data) { renderCategorias(Array.isArray(data) ? data : []); })
        .catch(function() { renderCategorias([]); });
    });
}

function renderCategorias(items) {
  var tbody = document.getElementById('cat-list-tbody');
  var info  = document.getElementById('cat-list-info');
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-5">' +
      '<i class="bi bi-tags fs-2 d-block mb-2 opacity-25"></i>' +
      '<div>No hay categorías disponibles.</div>' +
      '<div class="mt-2"><span class="badge rounded-pill px-3 py-2" style="background:var(--warning-bg);color:var(--warning-text);border:1px solid var(--warning-border);">' +
        '<i class="bi bi-hourglass-split me-1"></i>Gestión de categorías deportivas disponible próximamente</span></div>' +
      '</td></tr>';
    info.textContent = 'Sin datos.';
    return;
  }
  info.textContent = items.length + ' categoría(s).';
  tbody.innerHTML = items.map(function(c) {
    var estadoBadge = parseInt(c.estado) === 1
      ? '<span class="badge bg-success rounded-pill">Activo</span>'
      : '<span class="badge bg-secondary rounded-pill">Inactivo</span>';
    return '<tr>' +
      '<td class="fw-semibold">' + esc(c.nombre) + '</td>' +
      '<td><code>' + esc(c.nemonico || '—') + '</code></td>' +
      '<td>' + esc(c.deporte_nombre || c.deporte || '—') + '</td>' +
      '<td class="text-center">' + esc(c.edad_minima || '—') + '</td>' +
      '<td class="text-center">' + esc(c.edad_maxima || '—') + '</td>' +
      '<td class="text-center">' + estadoBadge + '</td>' +
    '</tr>';
  }).join('');
}

document.getElementById('btn-cat-reload').addEventListener('click', loadCategorias);

/* ─────────────────────────────────────────────
   INIT
───────────────────────────────────────────── */
function init() {
  // Cargar deportes primero (para poblar select de actividades)
  loadDeportes();
  loadActividades();
}

document.addEventListener('DOMContentLoaded', function() {
  checkAuth();
  init();
});
</script>
{% endblock %}
