/* ─────────────────────────────────────────────
   INIT
───────────────────────────────────────────── */
function init() {
  whenInstitucionReady()
    .then(function() { return loadDeportes(); })
    .then(function() {
      return Promise.all([
        loadCategorias(),
        loadDocentes(),
        loadPeriodos(),
        loadNiveles()
      ]);
    }).then(loadActividades)
    .catch(function(err) {
      console.error("Error en la inicialización:", err);
      showToast("Error al cargar datos iniciales. " + (err ? err.message : ''), 'error');
    });
}

document.addEventListener('DOMContentLoaded', function() {
  checkAuth();
  init();
});
</script>
{% endblock %}
