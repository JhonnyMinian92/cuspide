{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'membresias' %}

{% block title %}Membresías — Huaquillas F.C.{% endblock %}
{% block page_title %}Membresías{% endblock %}

{% block content %}
<div class="card chart-card">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h6 class="fw-bold mb-0">Lista de Membresías</h6>
      <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#modalMembresia">
        <i class="bi bi-plus-lg me-1"></i>Añadir Membresía
      </button>
    </div>

    <!-- Los datos se cargarán via API en el futuro; por ahora se muestra tabla vacía -->
    <div class="table-responsive table-container">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Alumno</th>
            <th>Tipo Membresía</th>
            <th>Fecha Inicio</th>
            <th>Fecha Vencimiento</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="membresias-tbody">
          <tr>
            <td colspan="7" class="text-center text-muted py-4">
              <i class="bi bi-credit-card me-2"></i>
              Los datos de membresías se cargarán via API próximamente.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Añadir Membresía -->
<div class="modal fade" id="modalMembresia" tabindex="-1" aria-labelledby="modalMembresiaLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="modalMembresiaLabel"><i class="bi bi-credit-card-fill me-2"></i>Añadir Membresía</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Alumno</label>
          <input type="text" class="form-control" placeholder="Nombre del alumno">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Tipo de Membresía</label>
          <select class="form-select">
            <option value="">Seleccionar...</option>
            <option>Mensual</option>
            <option>Trimestral</option>
            <option>Anual</option>
            <option>Socio GOLD</option>
            <option>Socio PLATINUM</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Fecha Inicio</label>
          <input type="date" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Fecha Vencimiento</label>
          <input type="date" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Estado</label>
          <select class="form-select">
            <option>Activo</option>
            <option>Vencido</option>
            <option>Suspendido</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-brand" data-bs-dismiss="modal"><i class="bi bi-check-lg me-1"></i>Guardar</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}
