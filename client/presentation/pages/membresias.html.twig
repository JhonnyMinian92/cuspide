{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'membresias' %}
{% block title %}Membresías — Huaquillas F.C.{% endblock %}
{% block page_title %}Membresías{% endblock %}

{% block content %}
<style>
.toast-notification{position:fixed;top:1.2rem;right:1.2rem;z-index:9999;padding:.75rem 1.25rem;border-radius:.5rem;color:#fff;font-size:.9rem;opacity:0;transform:translateX(110%);transition:all .3s ease;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.4);}
.toast-notification.show{opacity:1;transform:translateX(0);}
.toast-success{background:#198754;}.toast-error{background:#dc3545;}.toast-warning{background:#ffc107;color:#212529;}.toast-info{background:#0dcaf0;color:#212529;}
.mem-card{border-radius:14px;border:1px solid var(--card-border);background:var(--card-bg);box-shadow:var(--card-shadow);transition:transform .18s ease,box-shadow .18s ease;overflow:hidden;display:flex;flex-direction:column;}
.mem-card:hover{transform:translateY(-3px);box-shadow:0 20px 50px rgba(0,0,0,.32);}
.mem-card-accent{height:5px;width:100%;}
.mem-card-body{padding:1.4rem;flex:1;display:flex;flex-direction:column;}
.mem-card-precio{font-size:2rem;font-weight:800;letter-spacing:-0.02em;line-height:1.1;}
.mem-card-footer{padding:.9rem 1.4rem;border-top:1px solid var(--card-border);background:var(--app-bg-soft);}
.mem-card.mem-inactive{opacity:.6;}
.accent-0{background:linear-gradient(90deg,#e8b84b,#f0c96b);}
.accent-1{background:linear-gradient(90deg,#3b82f6,#60a5fa);}
.accent-2{background:linear-gradient(90deg,#10b981,#34d399);}
.accent-3{background:linear-gradient(90deg,#8b5cf6,#a78bfa);}
.accent-4{background:linear-gradient(90deg,#ef4444,#f87171);}
.accent-5{background:linear-gradient(90deg,#f59e0b,#fbbf24);}
</style>

<!-- ─── Sección superior: buscador + cards ─── -->
<div class="card chart-card mb-4">
  <div class="card-body p-4">
    <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-start gap-3 mb-4">
      <div>
        <h6 class="fw-bold mb-1">Planes de Membresía</h6>
        <p class="text-muted small mb-0">Consulta, edita o crea planes de membresía para los socios del club.</p>
      </div>
      <button type="button" class="btn btn-brand flex-shrink-0" id="btn-nueva-membresia">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Plan
      </button>
    </div>

    <!-- Búsqueda -->
    <div class="row g-3 align-items-center mb-4">
      <div class="col-12 col-lg-10">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="search" class="form-control" id="mem-search"
            placeholder="Buscar plan por título..." autocomplete="off">
        </div>
      </div>
      <div class="col-12 col-lg-2">
        <button type="button" class="btn btn-outline-secondary w-100" id="btn-mem-limpiar">
          <i class="bi bi-x-circle me-1"></i>Limpiar
        </button>
      </div>
    </div>

    <!-- Cards grid -->
    <div id="mem-cards-wrap">
      <div class="row g-4" id="mem-cards-row">
        <div class="col-12 text-center text-muted py-5">
          <span class="spinner-border spinner-border-sm me-2"></span>Cargando planes...
        </div>
      </div>
      <!-- Sin resultados -->
      <div id="mem-no-results" class="d-none mt-3">
        <div class="alert mb-0" style="background:var(--info-bg);color:var(--info-text);border:1px solid var(--info-border);">
          <i class="bi bi-info-circle me-2"></i>
          Sin resultados para "<span id="mem-no-results-q"></span>". Puedes crear un nuevo plan a continuación.
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ─── Formulario Crear / Editar ─── -->
<div class="card chart-card d-none" id="form-mem-card">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h6 class="fw-bold mb-1" id="form-mem-title">
          <i class="bi bi-star me-2"></i>Nuevo Plan de Membresía
        </h6>
        <p class="text-muted small mb-0">Completa la información del plan. Los campos con * son obligatorios.</p>
      </div>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-mem-form-cerrar">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <form id="form-mem" novalidate>
      <input type="hidden" id="mem-id" value="">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Título *</label>
          <input type="text" class="form-control" id="mem-titulo"
            placeholder="Ej: Plan Mensual" required maxlength="120">
        </div>
        <div class="col-md-3">
          <label class="form-label fw-semibold">Precio ($) *</label>
          <div class="input-group">
            <span class="input-group-text">$</span>
            <input type="number" class="form-control" id="mem-precio"
              placeholder="0.00" min="0" step="0.01" required>
          </div>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-semibold">Descuento (%)</label>
          <div class="input-group">
            <input type="number" class="form-control" id="mem-porcentaje"
              placeholder="0" min="0" max="100" step="1" value="0">
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Descripción</label>
          <textarea class="form-control" id="mem-descripcion" rows="3"
            placeholder="Descripción del plan, beneficios incluidos..."></textarea>
        </div>
        <div class="col-md-6">
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label fw-semibold">URL Botón (opcional)</label>
              <input type="text" class="form-control" id="mem-url-boton"
                placeholder="https://...">
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Fecha Inicio *</label>
              <input type="date" class="form-control" id="mem-fecha-inicio" required>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Fecha Fin *</label>
              <input type="date" class="form-control" id="mem-fecha-fin" required>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="mem-activo" checked>
            <label class="form-check-label fw-semibold" for="mem-activo">Plan activo</label>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 justify-content-end mt-4">
        <button type="button" class="btn btn-outline-secondary" id="btn-mem-cancelar">
          <i class="bi bi-x-lg me-1"></i>Cancelar
        </button>
        <button type="submit" class="btn btn-brand" id="btn-mem-submit">
          <i class="bi bi-check-lg me-1"></i>Guardar Plan
        </button>
      </div>
    </form>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
/* ── Helpers ── */
function showToast(msg, type) {
  type = type || 'success';
  var t = document.createElement('div');
  t.className = 'toast-notification toast-' + type;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function() { t.classList.add('show'); }, 10);
  setTimeout(function() { t.classList.remove('show'); setTimeout(function() { t.remove(); }, 300); }, 3200);
}
function formatMoney(v) { return '$' + parseFloat(v || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function debounce(fn, ms) {
  var t;
  return function() { var a = arguments; clearTimeout(t); t = setTimeout(function() { fn.apply(null, a); }, ms); };
}
function formatDate(s) {
  if (!s) return '—';
  var parts = String(s).split('-');
  if (parts.length === 3) return parts[2] + '/' + parts[1] + '/' + parts[0];
  return s;
}

/* ── Estado ── */
var membresiasList = [];

/* ── API ── */
function apiCall(method, endpoint, action, body, params) {
  return Cuspide.api.call(method, CONFIG.ENDPOINTS[endpoint], action, body, params);
}

/* ─────────────────────────────────────────────
   CARGAR MEMBRESÍAS
───────────────────────────────────────────── */
function loadMembresias() {
  document.getElementById('mem-cards-row').innerHTML =
    '<div class="col-12 text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Cargando planes...</div>';
  document.getElementById('mem-no-results').classList.add('d-none');

  apiCall('GET', 'membresias', 'list', null, null)
    .then(function(data) {
      membresiasList = Array.isArray(data) ? data : [];
      renderCards(membresiasList);
    })
    .catch(function(err) {
      document.getElementById('mem-cards-row').innerHTML =
        '<div class="col-12 text-center text-danger py-5"><i class="bi bi-exclamation-triangle fs-3 d-block mb-2"></i>' +
        esc(err.message || 'Error al cargar membresías.') + '</div>';
    });
}

/* ─────────────────────────────────────────────
   RENDER CARDS
───────────────────────────────────────────── */
function renderCards(items) {
  var row = document.getElementById('mem-cards-row');
  var noResults = document.getElementById('mem-no-results');

  if (!items.length) {
    row.innerHTML = '<div class="col-12 text-center text-muted py-5">' +
      '<i class="bi bi-star fs-2 d-block mb-2 opacity-25"></i>' +
      'No hay planes registrados.' +
    '</div>';
    return;
  }

  noResults.classList.add('d-none');
  row.innerHTML = items.map(function(m, idx) {
    var accentClass = 'accent-' + (idx % 6);
    var isActive    = parseInt(m.estado) === 1;
    var descuento   = parseFloat(m.porcentaje || 0);
    var vigencia    = formatDate(m.fecha_inicio) + ' — ' + formatDate(m.fecha_fin);

    var descuentoBadge = descuento > 0
      ? '<span class="badge ms-2" style="background:var(--success-bg);color:var(--success-text);border:1px solid var(--success-border);">' +
          '<i class="bi bi-tag me-1"></i>' + descuento + '% dto.' +
        '</span>'
      : '';

    var estadoBadge = isActive
      ? '<span class="badge rounded-pill bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>'
      : '<span class="badge rounded-pill bg-secondary"><i class="bi bi-slash-circle me-1"></i>Inactivo</span>';

    return '<div class="col-12 col-sm-6 col-xl-4">' +
      '<div class="mem-card' + (!isActive ? ' mem-inactive' : '') + '">' +
        '<div class="mem-card-accent ' + accentClass + '"></div>' +
        '<div class="mem-card-body">' +
          '<div class="d-flex justify-content-between align-items-start mb-2">' +
            '<div class="fw-bold fs-6">' + esc(m.titulo) + descuentoBadge + '</div>' +
            estadoBadge +
          '</div>' +
          '<div class="mem-card-precio" style="color:var(--brand-color);">' +
            formatMoney(m.precio) +
            '<span class="fs-6 text-muted fw-normal">/plan</span>' +
          '</div>' +
          (m.descripcion
            ? '<p class="text-muted small mt-2 mb-0" style="flex:1;">' + esc(m.descripcion) + '</p>'
            : '<p class="text-muted small mt-2 mb-0 fst-italic" style="flex:1;">Sin descripción.</p>') +
          '<div class="mt-3 small text-muted">' +
            '<i class="bi bi-calendar-range me-1"></i>' + esc(vigencia) +
          '</div>' +
        '</div>' +
        '<div class="mem-card-footer d-flex justify-content-end gap-2">' +
          '<button type="button" class="btn btn-sm btn-outline-primary" onclick="editarMembresia(' + m.id + ')">' +
            '<i class="bi bi-pencil me-1"></i>Editar' +
          '</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}

/* ─────────────────────────────────────────────
   BÚSQUEDA (debounce 350ms, filtro cliente)
───────────────────────────────────────────── */
var doMemSearch = debounce(function(q) {
  var noResults = document.getElementById('mem-no-results');
  if (!q) {
    renderCards(membresiasList);
    noResults.classList.add('d-none');
    return;
  }
  var filtered = membresiasList.filter(function(m) {
    return (m.titulo || '').toLowerCase().indexOf(q.toLowerCase()) !== -1;
  });
  renderCards(filtered);
  if (!filtered.length) {
    document.getElementById('mem-no-results-q').textContent = q;
    noResults.classList.remove('d-none');
    // Auto-abrir formulario con título prelleno
    document.getElementById('mem-id').value = '';
    document.getElementById('form-mem').reset();
    document.getElementById('mem-titulo').value = q;
    document.getElementById('mem-activo').checked = true;
    document.getElementById('form-mem-title').innerHTML = '<i class="bi bi-star me-2"></i>Nuevo Plan de Membresía';
    document.getElementById('form-mem-card').classList.remove('d-none');
    document.getElementById('form-mem-card').scrollIntoView({ behavior: 'smooth' });
  } else {
    noResults.classList.add('d-none');
  }
}, 350);

document.getElementById('mem-search').addEventListener('input', function() {
  doMemSearch(this.value.trim());
});
document.getElementById('btn-mem-limpiar').addEventListener('click', function() {
  document.getElementById('mem-search').value = '';
  renderCards(membresiasList);
  document.getElementById('mem-no-results').classList.add('d-none');
});

/* ─────────────────────────────────────────────
   EDITAR MEMBRESÍA
───────────────────────────────────────────── */
function editarMembresia(id) {
  var m = membresiasList.find(function(x) { return x.id == id; });
  if (!m) return;

  document.getElementById('mem-id').value          = m.id;
  document.getElementById('mem-titulo').value       = m.titulo || '';
  document.getElementById('mem-precio').value       = m.precio || '';
  document.getElementById('mem-porcentaje').value   = m.porcentaje || 0;
  document.getElementById('mem-descripcion').value  = m.descripcion || '';
  document.getElementById('mem-url-boton').value    = m.url_boton || '';
  document.getElementById('mem-fecha-inicio').value = m.fecha_inicio || '';
  document.getElementById('mem-fecha-fin').value    = m.fecha_fin || '';
  document.getElementById('mem-activo').checked     = parseInt(m.estado) === 1;

  document.getElementById('form-mem-title').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Plan: ' + esc(m.titulo);
  document.getElementById('form-mem-card').classList.remove('d-none');
  document.getElementById('form-mem-card').scrollIntoView({ behavior: 'smooth' });
}

/* ─────────────────────────────────────────────
   MOSTRAR / CERRAR FORMULARIO
───────────────────────────────────────────── */
function mostrarFormNuevo() {
  document.getElementById('mem-id').value = '';
  document.getElementById('form-mem').reset();
  document.getElementById('mem-activo').checked = true;
  document.getElementById('form-mem-title').innerHTML = '<i class="bi bi-star me-2"></i>Nuevo Plan de Membresía';
  document.getElementById('form-mem-card').classList.remove('d-none');
  document.getElementById('form-mem-card').scrollIntoView({ behavior: 'smooth' });
}

function cerrarForm() {
  document.getElementById('form-mem-card').classList.add('d-none');
  document.getElementById('mem-id').value = '';
  document.getElementById('form-mem').reset();
  document.getElementById('mem-no-results').classList.add('d-none');
  document.getElementById('mem-search').value = '';
  renderCards(membresiasList);
}

document.getElementById('btn-nueva-membresia').addEventListener('click', mostrarFormNuevo);
document.getElementById('btn-mem-form-cerrar').addEventListener('click', cerrarForm);
document.getElementById('btn-mem-cancelar').addEventListener('click', cerrarForm);

/* ─────────────────────────────────────────────
   GUARDAR (POST / PUT)
───────────────────────────────────────────── */
document.getElementById('form-mem').addEventListener('submit', function(e) {
  e.preventDefault();

  var id          = document.getElementById('mem-id').value;
  var titulo      = document.getElementById('mem-titulo').value.trim();
  var precio      = document.getElementById('mem-precio').value;
  var porcentaje  = document.getElementById('mem-porcentaje').value || 0;
  var descripcion = document.getElementById('mem-descripcion').value.trim();
  var urlBoton    = document.getElementById('mem-url-boton').value.trim();
  var fechaInicio = document.getElementById('mem-fecha-inicio').value;
  var fechaFin    = document.getElementById('mem-fecha-fin').value;
  var activo      = document.getElementById('mem-activo').checked ? 1 : 0;

  if (!titulo)   { showToast('El título es obligatorio.', 'warning'); document.getElementById('mem-titulo').focus(); return; }
  if (!precio || parseFloat(precio) < 0) { showToast('Ingresa un precio válido.', 'warning'); document.getElementById('mem-precio').focus(); return; }
  if (!fechaInicio) { showToast('La fecha de inicio es obligatoria.', 'warning'); return; }
  if (!fechaFin)    { showToast('La fecha de fin es obligatoria.', 'warning'); return; }
  if (fechaFin < fechaInicio) { showToast('La fecha de fin debe ser posterior al inicio.', 'warning'); return; }

  var body = {
    titulo:       titulo,
    precio:       parseFloat(precio),
    porcentaje:   parseFloat(porcentaje),
    descripcion:  descripcion,
    url_boton:    urlBoton,
    fecha_inicio: fechaInicio,
    fecha_fin:    fechaFin,
    estado:       activo
  };

  var btn = document.getElementById('btn-mem-submit');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var method = id ? 'PUT' : 'POST';
  var params = id ? { id: id } : null;

  apiCall(method, 'membresias', 'save', body, params)
    .then(function() {
      showToast(id ? 'Plan actualizado correctamente.' : 'Plan creado correctamente.', 'success');
      cerrarForm();
      loadMembresias();
    })
    .catch(function(err) {
      showToast(err.message || 'Error al guardar el plan.', 'error');
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar Plan';
    });
});

/* ─────────────────────────────────────────────
   INIT
───────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', function() {
  checkAuth();
  loadMembresias();
});
</script>
{% endblock %}
