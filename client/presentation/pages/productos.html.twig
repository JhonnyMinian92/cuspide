{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'productos' %}
{% block title %}SportAdmin - Gestion Educativa{% endblock %}
{% block page_title %}Productos{% endblock %}

{% block content %}
<style>
.toast-notification{position:fixed;top:1.2rem;right:1.2rem;z-index:9999;padding:.75rem 1.25rem;border-radius:.5rem;color:#fff;font-size:.9rem;opacity:0;transform:translateX(110%);transition:all .3s ease;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.4);}
.toast-notification.show{opacity:1;transform:translateX(0);}
.toast-success{background:#198754;}.toast-error{background:#dc3545;}.toast-warning{background:#ffc107;color:#212529;}.toast-info{background:#0dcaf0;color:#212529;}
</style>

<!-- Nav Tabs -->
<ul class="nav nav-tabs mb-4" id="prod-tabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active fw-semibold" id="tab-productos-btn"
      data-bs-toggle="tab" data-bs-target="#tab-productos" type="button" role="tab">
      <i class="bi bi-bag-fill me-2"></i>Productos
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-semibold" id="tab-categorias-btn"
      data-bs-toggle="tab" data-bs-target="#tab-categorias" type="button" role="tab"
      onclick="ensureCategoriasLoaded()">
      <i class="bi bi-tags-fill me-2"></i>Categorías
    </button>
  </li>
</ul>

<div class="tab-content">

  <!-- ═══════════════════════════════════════
       TAB 1: PRODUCTOS
  ═══════════════════════════════════════ -->
  <div class="tab-pane fade show active" id="tab-productos" role="tabpanel">

    <!-- Barra de búsqueda -->
    <div class="card chart-card mb-4">
      <div class="card-body p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-center gap-2 mb-2">
          <div>
            <h6 class="fw-bold mb-1">Catálogo de Productos</h6>
            <p class="text-muted small mb-0">Busca por nombre o código. Si no hay resultados aparecerá el formulario de creación.</p>
          </div>
          <a href="/inventario" class="btn btn-outline-secondary flex-shrink-0">
            <i class="bi bi-clipboard-data me-1"></i> Control de Inventario
          </a>
        </div>
        <div class="row g-3 align-items-center">
          <div class="col-12 col-lg-8">
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input type="search" class="form-control" id="prod-search"
                placeholder="Buscar por nombre o código..." autocomplete="off">
            </div>
          </div>
          <div class="col-12 col-lg-4 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-fill" id="btn-limpiar-prod">
              <i class="bi bi-x-circle me-1"></i>Limpiar
            </button>
            <button type="button" class="btn btn-brand flex-fill" id="btn-nuevo-prod">
              <i class="bi bi-plus-lg me-1"></i>Nuevo
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla de productos -->
    <div class="card chart-card mb-4">
      <div class="card-body p-0">
        <div class="px-4 pt-3 pb-2">
          <p class="text-muted small mb-0" id="prod-info">Cargando...</p>
        </div>
        <div class="table-responsive table-container"
          style="border-radius:0 0 12px 12px;border-top:1px solid var(--table-border);">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Código</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Costo</th>
                <th>Stock</th>
                <th>Ctrl. Stock</th>
                <th>Estado</th>
                <th class="text-end pe-4">Acciones</th>
              </tr>
            </thead>
            <tbody id="prod-tbody">
              <tr>
                <td colspan="9" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando productos...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Formulario crear / editar producto (d-none por defecto) -->
    <div class="card chart-card d-none" id="prod-form-card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h6 class="fw-bold mb-1" id="prod-form-title">
              <i class="bi bi-plus-circle me-2"></i>Nuevo Producto
            </h6>
            <p class="text-muted small mb-0">Los campos marcados con * son obligatorios.</p>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-cancel-prod">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <form id="form-producto" novalidate>
          <input type="hidden" id="f-prod-id">
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label fw-semibold">Código *</label>
              <input type="text" class="form-control" id="f-prod-codigo"
                placeholder="Ej: UNI-001" required>
            </div>
            <div class="col-md-5">
              <label class="form-label fw-semibold">Nombre *</label>
              <input type="text" class="form-control" id="f-prod-nombre"
                placeholder="Ej: Camiseta Oficial HFC" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Categoría</label>
              <select class="form-select" id="f-prod-categoria">
                <option value="">— Sin categoría —</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Descripción</label>
              <textarea class="form-control" id="f-prod-descripcion" rows="2"
                placeholder="Descripción opcional..."></textarea>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Precio *</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" class="form-control" id="f-prod-precio"
                  step="0.01" min="0" placeholder="0.00" required>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Costo</label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" class="form-control" id="f-prod-costo"
                  step="0.01" min="0" placeholder="0.00">
              </div>
            </div>
            <div class="col-md-3 d-flex align-items-end pb-1">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="f-prod-controla-stock" checked>
                <label class="form-check-label fw-semibold" for="f-prod-controla-stock">Controla Stock</label>
              </div>
            </div>
          </div>
          <div class="d-flex gap-2 justify-content-end mt-4">
            <button type="button" class="btn btn-outline-secondary" id="btn-cancel-prod-2">
              <i class="bi bi-x-lg me-1"></i>Cancelar
            </button>
            <button type="submit" class="btn btn-brand" id="btn-submit-prod">
              <i class="bi bi-check-lg me-1"></i>Guardar Producto
            </button>
          </div>
        </form>
      </div>
    </div>

  </div><!-- /tab-productos -->

  <!-- ═══════════════════════════════════════
       TAB 2: CATEGORÍAS
  ═══════════════════════════════════════ -->
  <div class="tab-pane fade" id="tab-categorias" role="tabpanel">

    <!-- Buscador categorías -->
    <div class="card chart-card mb-4">
      <div class="card-body p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-start gap-2 mb-2">
          <div>
            <h6 class="fw-bold mb-1">Categorías de Productos</h6>
            <p class="text-muted small mb-0">Agrupa los productos por tipo. Sin resultados muestra el formulario de creación.</p>
          </div>
        </div>
        <div class="row g-3 align-items-center">
          <div class="col-12 col-lg-8">
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input type="search" class="form-control" id="cat-search"
                placeholder="Buscar categoría..." autocomplete="off">
            </div>
          </div>
          <div class="col-12 col-lg-4 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-fill" id="btn-limpiar-cat">
              <i class="bi bi-x-circle me-1"></i>Limpiar
            </button>
            <button type="button" class="btn btn-brand flex-fill" id="btn-nueva-cat">
              <i class="bi bi-plus-lg me-1"></i>Nueva
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabla categorías -->
    <div class="card chart-card mb-4">
      <div class="card-body p-0">
        <div class="px-4 pt-3 pb-2">
          <p class="text-muted small mb-0" id="cat-info">Cargando...</p>
        </div>
        <div class="table-responsive table-container"
          style="border-radius:0 0 12px 12px;border-top:1px solid var(--table-border);">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Nombre</th>
                <th>Nemónico</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th class="text-end pe-4">Acciones</th>
              </tr>
            </thead>
            <tbody id="cat-tbody">
              <tr>
                <td colspan="5" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando categorías...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Formulario categoría (d-none por defecto) -->
    <div class="card chart-card d-none" id="cat-form-card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h6 class="fw-bold mb-1" id="cat-form-title">
              <i class="bi bi-plus-circle me-2"></i>Nueva Categoría
            </h6>
            <p class="text-muted small mb-0">Los campos marcados con * son obligatorios.</p>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-cancel-cat">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <form id="form-categoria" novalidate>
          <input type="hidden" id="f-cat-id">
          <div class="row g-3">
            <div class="col-md-5">
              <label class="form-label fw-semibold">Nombre *</label>
              <input type="text" class="form-control" id="f-cat-nombre"
                placeholder="Ej: Uniformes" required>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Nemónico</label>
              <input type="text" class="form-control" id="f-cat-nemonico"
                placeholder="Ej: UNI" maxlength="10">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Descripción</label>
              <input type="text" class="form-control" id="f-cat-descripcion"
                placeholder="Descripción opcional...">
            </div>
          </div>
          <div class="d-flex gap-2 justify-content-end mt-4">
            <button type="button" class="btn btn-outline-secondary" id="btn-cancel-cat-2">
              <i class="bi bi-x-lg me-1"></i>Cancelar
            </button>
            <button type="submit" class="btn btn-brand" id="btn-submit-cat">
              <i class="bi bi-check-lg me-1"></i>Guardar Categoría
            </button>
          </div>
        </form>
      </div>
    </div>

  </div><!-- /tab-categorias -->

</div><!-- /tab-content -->
{% endblock %}

{% block scripts %}
<script>
/* ────────────────────────────────────────────────
   HELPERS
──────────────────────────────────────────────── */
function esc(v){return String(v===null||v===undefined?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function showToast(msg,type){type=type||'success';var t=document.createElement('div');t.className='toast-notification toast-'+type;t.textContent=msg;document.body.appendChild(t);setTimeout(function(){t.classList.add('show');},10);setTimeout(function(){t.classList.remove('show');setTimeout(function(){t.remove();},300);},3200);}
function formatMoney(v){return '$'+parseFloat(v||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
function debounce(fn,ms){var t;return function(){var a=arguments;clearTimeout(t);t=setTimeout(function(){fn.apply(null,a);},ms);};}
var institucionId=(window.CUSPIDE_STATE&&window.CUSPIDE_STATE.currentInstitucionId)||1;

function estadoBadge(e){
  return parseInt(e)===1
    ?'<span class="badge bg-success rounded-pill">Activo</span>'
    :'<span class="badge bg-secondary rounded-pill">Inactivo</span>';
}
function stockBadge(stock,minimo){
  var s=parseInt(stock)||0;
  var m=parseInt(minimo)||0;
  if(s===0) return '<span class="badge bg-danger rounded-pill">'+s+' — Sin stock</span>';
  if(s<=m)  return '<span class="badge bg-warning text-dark rounded-pill">'+s+' — Bajo</span>';
  return '<span class="badge bg-success rounded-pill">'+s+'</span>';
}

/* ── ESTADO LOCAL ── */
var allProducts   = [];
var allCategories = [];
var editingProdId = null;
var editingCatId  = null;
var categoriesLoaded = false;

/* ────────────────────────────────────────────────
   INIT
──────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', function() {
  checkAuth();
  loadCategories(function() { loadProducts(); });
});

/* ────────────────────────────────────────────────
   CATEGORÍAS (necesario para el select de productos)
──────────────────────────────────────────────── */
function loadCategories(cb) {
  Cuspide.api.call('GET', CONFIG.ENDPOINTS.productos, 'categories', null, { institucion: institucionId })
    .then(function(data) {
      allCategories = Array.isArray(data) ? data : [];
      categoriesLoaded = true;
      populateCatSelect();
      if (cb) cb();
    })
    .catch(function() {
      allCategories = [];
      categoriesLoaded = true;
      if (cb) cb();
    });
}

function populateCatSelect() {
  var sel = document.getElementById('f-prod-categoria');
  if (!sel) return;
  sel.innerHTML = '<option value="">— Sin categoría —</option>' +
    allCategories.map(function(c){
      return '<option value="'+esc(c.id)+'">'+esc(c.nombre)+'</option>';
    }).join('');
}

function getCatName(id) {
  if (!id) return null;
  var c = allCategories.find(function(x){ return String(x.id)===String(id); });
  return c ? c.nombre : null;
}

function ensureCategoriasLoaded() {
  if (!categoriesLoaded) {
    loadCategories(function(){ renderCatTable(allCategories); });
  } else {
    renderCatTable(allCategories);
  }
}

/* ────────────────────────────────────────────────
   PRODUCTOS — CARGAR
──────────────────────────────────────────────── */
function loadProducts() {
  document.getElementById('prod-info').textContent = 'Cargando...';
  Cuspide.api.call('GET', CONFIG.ENDPOINTS.productos, 'list', null, { institucion: institucionId })
    .then(function(data) {
      allProducts = Array.isArray(data) ? data : [];
      renderProdTable(allProducts);
    })
    .catch(function(err) {
      document.getElementById('prod-tbody').innerHTML =
        '<tr><td colspan="9" class="text-center text-danger py-5">' +
        '<i class="bi bi-exclamation-circle me-2"></i>'+esc(err.message||'Error al cargar productos.')+'</td></tr>';
      document.getElementById('prod-info').textContent = 'Error al cargar.';
    });
}

/* ── RENDER TABLA PRODUCTOS ── */
function renderProdTable(items) {
  var tbody = document.getElementById('prod-tbody');
  var info  = document.getElementById('prod-info');
  if (!items || items.length === 0) {
    tbody.innerHTML =
      '<tr><td colspan="9" class="text-center text-muted py-5">' +
      '<i class="bi bi-bag-x fs-2 d-block mb-2 opacity-25"></i>' +
      'No se encontraron productos.</td></tr>';
    info.textContent = 'Sin resultados.';
    return;
  }
  info.textContent = items.length + ' producto(s).';
  tbody.innerHTML = items.map(function(p) {
    var catName = p.categoria_nombre || getCatName(p.categoria) || '—';
    var ctrlBadge = p.controla_stock
      ? '<span class="badge bg-info text-dark rounded-pill">Sí</span>'
      : '<span class="badge bg-secondary rounded-pill">No</span>';
    var stockVal = (p.stock !== undefined && p.stock !== null) ? p.stock : null;
    var stkHtml = stockVal !== null
      ? stockBadge(stockVal, p.stock_minimo || 0)
      : '<span class="text-muted small">—</span>';
    var isActive = parseInt(p.estado) === 1;
    return '<tr>' +
      '<td class="ps-4"><code>'+esc(p.codigo)+'</code></td>' +
      '<td class="fw-semibold">'+esc(p.nombre)+'</td>' +
      '<td><span class="badge rounded-pill" style="background:var(--app-surface-soft);color:var(--app-text-soft);border:1px solid var(--app-border);">'+esc(catName)+'</span></td>' +
      '<td class="fw-semibold">'+formatMoney(p.precio)+'</td>' +
      '<td class="text-muted small">'+formatMoney(p.costo)+'</td>' +
      '<td>'+stkHtml+'</td>' +
      '<td>'+ctrlBadge+'</td>' +
      '<td>'+estadoBadge(p.estado)+'</td>' +
      '<td class="text-end pe-3">' +
        '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="openEditProd('+esc(p.id)+')">' +
          '<i class="bi bi-pencil me-1"></i>Editar</button>' +
        (isActive
          ? '<button type="button" class="btn btn-sm btn-outline-danger" onclick="disableProduct('+esc(p.id)+',this)"><i class="bi bi-slash-circle me-1"></i>Deshab.</button>'
          : '<button type="button" class="btn btn-sm btn-outline-success" onclick="enableProduct('+esc(p.id)+',this)"><i class="bi bi-check-circle me-1"></i>Habilitar</button>') +
      '</td>' +
    '</tr>';
  }).join('');
}

/* ── BÚSQUEDA CLIENT-SIDE (debounce 350 ms) ── */
var doProdSearch = debounce(function(q) {
  if (!q) {
    renderProdTable(allProducts);
    return;
  }
  var lq = q.toLowerCase();
  var filtered = allProducts.filter(function(p) {
    return (p.nombre||'').toLowerCase().indexOf(lq) > -1 ||
           (p.codigo||'').toLowerCase().indexOf(lq) > -1;
  });
  renderProdTable(filtered);
  hideProdForm();
}, 350);

document.getElementById('prod-search').addEventListener('input', function(){
  doProdSearch(this.value.trim());
});
document.getElementById('btn-limpiar-prod').addEventListener('click', function(){
  document.getElementById('prod-search').value = '';
  renderProdTable(allProducts);
  hideProdForm();
});

/* ── FORMULARIO PRODUCTO ── */
function openNewProdForm() {
  editingProdId = null;
  document.getElementById('form-producto').reset();
  document.getElementById('f-prod-id').value = '';
  document.getElementById('prod-form-title').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Nuevo Producto';
  populateCatSelect();
  showProdForm();
}

function openEditProd(id) {
  var p = allProducts.find(function(x){ return String(x.id)===String(id); });
  if (!p) { showToast('Producto no encontrado.','error'); return; }
  editingProdId = id;
  document.getElementById('f-prod-id').value              = id;
  document.getElementById('f-prod-codigo').value          = p.codigo || '';
  document.getElementById('f-prod-nombre').value          = p.nombre || '';
  document.getElementById('f-prod-descripcion').value     = p.descripcion || '';
  document.getElementById('f-prod-precio').value          = p.precio || '';
  document.getElementById('f-prod-costo').value           = p.costo || '';
  document.getElementById('f-prod-controla-stock').checked = !!p.controla_stock;
  populateCatSelect();
  var catSel = document.getElementById('f-prod-categoria');
  if (p.categoria) {
    for (var i = 0; i < catSel.options.length; i++) {
      if (catSel.options[i].value === String(p.categoria)) { catSel.selectedIndex = i; break; }
    }
  }
  document.getElementById('prod-form-title').innerHTML =
    '<i class="bi bi-pencil-square me-2"></i>Editar Producto — '+esc(p.nombre);
  showProdForm();
}

function showProdForm() {
  var card = document.getElementById('prod-form-card');
  card.classList.remove('d-none');
  card.scrollIntoView({ behavior:'smooth', block:'nearest' });
}
function hideProdForm() {
  document.getElementById('prod-form-card').classList.add('d-none');
  document.getElementById('form-producto').reset();
  editingProdId = null;
}

document.getElementById('btn-nuevo-prod').addEventListener('click', openNewProdForm);
document.getElementById('btn-cancel-prod').addEventListener('click', hideProdForm);
document.getElementById('btn-cancel-prod-2').addEventListener('click', hideProdForm);

document.getElementById('form-producto').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('btn-submit-prod');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var isEdit  = !!editingProdId;
  var catVal  = document.getElementById('f-prod-categoria').value;
  var body = {
    codigo:         document.getElementById('f-prod-codigo').value.trim(),
    nombre:         document.getElementById('f-prod-nombre').value.trim(),
    descripcion:    document.getElementById('f-prod-descripcion').value.trim() || null,
    precio:         parseFloat(document.getElementById('f-prod-precio').value) || 0,
    costo:          parseFloat(document.getElementById('f-prod-costo').value) || 0,
    controla_stock: document.getElementById('f-prod-controla-stock').checked ? 1 : 0,
    categoria:      catVal ? parseInt(catVal) : null,
    institucion:    institucionId,
    estado:         1,
  };
  var method = isEdit ? 'PUT' : 'POST';
  var params = isEdit ? { id: editingProdId } : null;

  Cuspide.api.call(method, CONFIG.ENDPOINTS.productos, 'save', body, params)
    .then(function() {
      showToast(isEdit ? 'Producto actualizado correctamente.' : 'Producto creado correctamente.', 'success');
      hideProdForm();
      loadProducts();
    })
    .catch(function(err) { showToast(err.message || 'Error al guardar producto.', 'error'); })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar Producto';
    });
});

async function disableProduct(id, btn) {
  var r = await swConfirm('¿Deshabilitar producto?', 'El producto dejará de estar disponible para ventas.', 'Sí, deshabilitar');
  if (!r.isConfirmed) return;
  btn.disabled = true;
  Cuspide.api.call('PUT', CONFIG.ENDPOINTS.productos, 'disable', null, { id: id })
    .then(function() { showToast('Producto deshabilitado.', 'success'); loadProducts(); })
    .catch(function(err) { showToast(err.message || 'Error al deshabilitar.', 'error'); btn.disabled = false; });
}
function enableProduct(id, btn) {
  btn.disabled = true;
  Cuspide.api.call('PUT', CONFIG.ENDPOINTS.productos, 'save', { estado: 1 }, { id: id })
    .then(function() { showToast('Producto habilitado.', 'success'); loadProducts(); })
    .catch(function(err) { showToast(err.message || 'Error al habilitar.', 'error'); btn.disabled = false; });
}

/* ────────────────────────────────────────────────
   CATEGORÍAS — RENDER
──────────────────────────────────────────────── */
function renderCatTable(items) {
  var tbody = document.getElementById('cat-tbody');
  var info  = document.getElementById('cat-info');
  if (!info || !tbody) return;
  if (!items || items.length === 0) {
    tbody.innerHTML =
      '<tr><td colspan="5" class="text-center text-muted py-5">' +
      '<i class="bi bi-tags fs-2 d-block mb-2 opacity-25"></i>' +
      'Sin categorías encontradas.</td></tr>';
    info.textContent = 'Sin resultados.';
    return;
  }
  info.textContent = items.length + ' categoría(s).';
  tbody.innerHTML = items.map(function(c) {
    var estado = (c.estado !== undefined) ? c.estado : 1;
    return '<tr>' +
      '<td class="ps-4 fw-semibold">'+esc(c.nombre)+'</td>' +
      '<td><code>'+esc(c.nemonico||'—')+'</code></td>' +
      '<td class="text-muted small">'+esc(c.descripcion||'—')+'</td>' +
      '<td>'+estadoBadge(estado)+'</td>' +
      '<td class="text-end pe-3">' +
        '<button type="button" class="btn btn-sm btn-outline-primary" onclick="openEditCat('+esc(c.id)+')">'+
          '<i class="bi bi-pencil me-1"></i>Editar</button>' +
      '</td>' +
    '</tr>';
  }).join('');
}

var doCatSearch = debounce(function(q) {
  if (!q) { renderCatTable(allCategories); hideCatForm(); return; }
  var lq = q.toLowerCase();
  var filtered = allCategories.filter(function(c) {
    return (c.nombre||'').toLowerCase().indexOf(lq) > -1;
  });
  renderCatTable(filtered);
  hideCatForm();
}, 350);

document.getElementById('cat-search').addEventListener('input', function(){
  doCatSearch(this.value.trim());
});
document.getElementById('btn-limpiar-cat').addEventListener('click', function(){
  document.getElementById('cat-search').value = '';
  renderCatTable(allCategories);
  hideCatForm();
});

/* ── FORMULARIO CATEGORÍA ── */
function openNewCatForm() {
  editingCatId = null;
  document.getElementById('form-categoria').reset();
  document.getElementById('f-cat-id').value = '';
  document.getElementById('cat-form-title').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Nueva Categoría';
  showCatForm();
}
function openEditCat(id) {
  var c = allCategories.find(function(x){ return String(x.id)===String(id); });
  if (!c) return;
  editingCatId = id;
  document.getElementById('f-cat-id').value          = id;
  document.getElementById('f-cat-nombre').value      = c.nombre || '';
  document.getElementById('f-cat-nemonico').value    = c.nemonico || '';
  document.getElementById('f-cat-descripcion').value = c.descripcion || '';
  document.getElementById('cat-form-title').innerHTML =
    '<i class="bi bi-pencil-square me-2"></i>Editar Categoría — '+esc(c.nombre);
  showCatForm();
}
function showCatForm() {
  var card = document.getElementById('cat-form-card');
  card.classList.remove('d-none');
  card.scrollIntoView({ behavior:'smooth', block:'nearest' });
}
function hideCatForm() {
  document.getElementById('cat-form-card').classList.add('d-none');
  document.getElementById('form-categoria').reset();
  editingCatId = null;
}

document.getElementById('btn-nueva-cat').addEventListener('click', openNewCatForm);
document.getElementById('btn-cancel-cat').addEventListener('click', hideCatForm);
document.getElementById('btn-cancel-cat-2').addEventListener('click', hideCatForm);

document.getElementById('form-categoria').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('btn-submit-cat');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

  var isEdit = !!editingCatId;
  var body = {
    nombre:      document.getElementById('f-cat-nombre').value.trim(),
    nemonico:    document.getElementById('f-cat-nemonico').value.trim() || null,
    descripcion: document.getElementById('f-cat-descripcion').value.trim() || null,
    institucion: institucionId,
    estado:      1,
  };
  var method = isEdit ? 'PUT' : 'POST';
  var params = isEdit ? { id: editingCatId } : null;

  Cuspide.api.call(method, CONFIG.ENDPOINTS.productos, 'saveCategory', body, params)
    .then(function() {
      showToast(isEdit ? 'Categoría actualizada.' : 'Categoría creada.', 'success');
      hideCatForm();
      loadCategories(function(){ renderCatTable(allCategories); });
    })
    .catch(function(err) { showToast(err.message || 'Error al guardar categoría.', 'error'); })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar Categoría';
    });
});
</script>
{% endblock %}
