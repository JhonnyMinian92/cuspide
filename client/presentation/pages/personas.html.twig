});

/* ── Recargar secciones después de guardar ── */
function reloadSections() {
  if (!currentPersonaId) return;
  apiGet(CONFIG.ENDPOINTS.personas, 'sections', { id: currentPersonaId })
    .then(function(data) {
      currentSections = data;
      renderAllTabs(data);
    })
    .catch(function() {});
}

/* ── Cerrar detalle ── */
document.getElementById('btn-cerrar-detalle').addEventListener('click', function() {
  document.getElementById('persona-detail-card').classList.add('d-none');
  currentPersonaId = null;
  currentSections  = null;
});

/* ── Nueva persona: mostrar / ocultar ── */
function showNuevaPersona() {
  document.getElementById('nueva-persona-card').classList.remove('d-none');
  document.getElementById('nueva-persona-card').scrollIntoView({ behavior: 'smooth' });
  loadInstitucionesSelect('n-institucion');
}
function hideNuevaPersona() {
  document.getElementById('nueva-persona-card').classList.add('d-none');
  document.getElementById('form-nueva-persona').reset();
}
document.getElementById('btn-nueva-persona').addEventListener('click', showNuevaPersona);
document.getElementById('btn-cancelar-nueva').addEventListener('click', hideNuevaPersona);
document.getElementById('btn-cancelar-nueva-2').addEventListener('click', hideNuevaPersona);

/* ── Cargar select de instituciones ── */
function loadInstitucionesSelect(selectId) {
  var sel = document.getElementById(selectId);
  if (!sel) return;
  if (window.CUSPIDE_STATE && window.CUSPIDE_STATE.instituciones && window.CUSPIDE_STATE.instituciones.length > 0) {
    populateInstSelect(sel, window.CUSPIDE_STATE.instituciones);
    return;
  }
  apiGet(CONFIG.ENDPOINTS.instituciones, 'list')
    .then(function(data) {
      if (Array.isArray(data)) populateInstSelect(sel, data);
    })
    .catch(function() { sel.innerHTML = '<option value="">Error al cargar</option>'; });
}
function populateInstSelect(sel, items) {
  sel.innerHTML = '<option value="">— Seleccionar institución —</option>' +
    items.map(function(i) { return '<option value="' + i.id + '">' + esc(i.nombre) + '</option>'; }).join('');
}

/* ── Registrar nueva persona ── */
document.getElementById('form-nueva-persona').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('btn-submit-nueva');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Registrando...';

  var username  = document.getElementById('n-username').value.trim();
  var password  = document.getElementById('n-password').value;
  var tipo_user = document.getElementById('n-tipo-user').value;

  var body = {
    identificacion:  document.getElementById('n-identificacion').value.trim(),
    primer_nombre:   document.getElementById('n-primer-nombre').value.trim(),
    segundo_nombre:  document.getElementById('n-segundo-nombre').value.trim() || null,
    primer_apellido: document.getElementById('n-primer-apellido').value.trim(),
    segundo_apellido:document.getElementById('n-segundo-apellido').value.trim() || null,
    fecha_nacimiento:document.getElementById('n-fecha-nacimiento').value || null,
    genero:          parseInt(document.getElementById('n-genero').value) || null,
    etnia:           parseInt(document.getElementById('n-etnia').value) || null,
    institucion:     parseInt(document.getElementById('n-institucion').value) || null,
    tipo_persona:    parseInt(document.getElementById('n-tipo-persona').value) || null,
    direccion:       document.getElementById('n-direccion').value.trim() || null,
    grupo_sanguineo: document.getElementById('n-grupo-sanguineo').value || null,
  };
  if (username) { body.username = username; }
  if (password) { body.password = password; }
  if (tipo_user) { body.tipo_user = tipo_user; }

  apiPost(CONFIG.ENDPOINTS.personas, 'save', body)
    .then(function(data) {
      showToast('Persona registrada: ' + (data.nombre_completo || data.identificacion), 'success');
      hideNuevaPersona();
      document.getElementById('persona-search').value = body.identificacion;
      doSearch(body.identificacion);
    })
    .catch(function(err) { showToast(err.message || 'Error al registrar persona.', 'danger'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Registrar Persona'; });
});

/* ── Inicialización ── */
document.addEventListener('DOMContentLoaded', function() {
  var searchInput = document.getElementById('persona-search');
  var clearBtn    = document.getElementById('btn-limpiar-personas');

  searchInput.addEventListener('input', function() { doSearch(this.value.trim()); });
  clearBtn.addEventListener('click', function() {
    searchInput.value = '';
    renderTable([]);
    document.getElementById('personas-info').textContent = 'Ingresa al menos 2 caracteres.';
    document.getElementById('persona-detail-card').classList.add('d-none');
    searchInput.focus();
  });
});
</script>
{% endblock %}
