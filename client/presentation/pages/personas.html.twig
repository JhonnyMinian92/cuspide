      showToast('Datos médicos actualizados.', 'success');
      cancelEdit('medico');
      reloadSections();
    })
    .catch(function(err) { showToast(err.message, 'danger'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar'; });
});

/* ── Guardar sección: Contacto ── */
document.getElementById('form-contacto').addEventListener('submit', function(e) {
  e.preventDefault();
  showToast('Contacto: la edición de teléfonos y correos se implementa con los endpoints de contactos individuales.', 'info');
  cancelEdit('contacto');
});

/* ── Agregar campos dinámicos de teléfono/correo ── */
document.getElementById('btn-add-tel').addEventListener('click', function() {
