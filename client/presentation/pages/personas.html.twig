{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'personas' %}
{% block title %}Personas — CUSPIDE{% endblock %}
{% block page_title %}Personas{% endblock %}

{% block content %}

<!-- Buscador + acción nueva -->
<div class="card chart-card mb-4">
  <div class="card-body p-4">
    <div class="d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-start gap-3 mb-3">
      <div>
        <h6 class="fw-bold mb-1">Gestión de Personas</h6>
        <p class="text-muted small mb-0">Busca por cédula, nombre o apellido. Selecciona una persona para ver y editar sus secciones.</p>
      </div>
      <button type="button" class="btn btn-brand flex-shrink-0" id="btn-nueva-persona">
        <i class="bi bi-person-plus-fill me-1"></i>Nueva Persona
      </button>
    </div>
    <div class="row g-3 align-items-center">
      <div class="col-12 col-lg-9">
        <label for="persona-search" class="form-label fw-semibold">Buscar persona</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="search" class="form-control" id="persona-search"
            placeholder="Ej: Pérez, Juan, 0701234567..." autocomplete="off">
          <span class="input-group-text d-none" id="search-spinner-wrap">
            <span class="spinner-border spinner-border-sm" role="status"></span>
          </span>
        </div>
      </div>
      <div class="col-12 col-lg-3">
        <label class="form-label d-none d-lg-block invisible">.</label>
        <button type="button" class="btn btn-outline-secondary w-100" id="btn-limpiar-personas">
          <i class="bi bi-x-circle me-1"></i>Limpiar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Tabla de resultados -->
<div class="card chart-card mb-4">
  <div class="card-body p-0">
    <div class="px-4 pt-4 pb-2 d-flex justify-content-between align-items-center">
      <div>
        <h6 class="fw-bold mb-0">Resultados</h6>
        <p class="text-muted small mb-0" id="personas-info">Ingresa al menos 2 caracteres.</p>
      </div>
    </div>
    <div class="table-responsive table-container" style="border-radius:0 0 12px 12px; border-top:1px solid var(--table-border); border-left:none; border-right:none; border-bottom:none;">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Identificación</th>
            <th>Nombre Completo</th>
            <th>Tipo</th>
            <th>Institución</th>
            <th class="text-end pe-4">Acciones</th>
          </tr>
        </thead>
        <tbody id="personas-tbody">
          <tr>
            <td colspan="5" class="text-center text-muted py-5">
              <i class="bi bi-person-lines-fill fs-2 d-block mb-2 opacity-25"></i>
              Ingresa un criterio de búsqueda.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Detalle de persona con tabs (hidden by default) -->
