{% block scripts %}
<script>
/* ── Catálogos locales ── */
var CATALOG = {
  genero:      { '1': 'Masculino', '2': 'Femenino', '3': 'Otro' },
  etnia:       { '1': 'Mestizo', '2': 'Indígena', '3': 'Afroecuatoriano', '4': 'Montubio', '5': 'Blanco', '6': 'Otro' },
  tipo_persona:{ '1': 'Estudiante', '2': 'Profesor/Entrenador', '3': 'Secretaria', '4': 'Contador', '5': 'Personal Médico', '6': 'Administrativo', '7': 'Asistente', '8': 'Mantenimiento' },
};

/* ── Estado de la vista ── */
var currentPersonaId = null;
var currentSections  = null;

/* ── Helpers de API ── */
function apiGet(path, action, params) {
  var base = (CONFIG.API_BASE_URL + path).replace(/\/+$/, '');
  var url  = base + '/index.php?api=' + encodeURIComponent(action);
  if (params) {
    Object.keys(params).forEach(function(k) {
      if (params[k] !== null && params[k] !== undefined && params[k] !== '') {
        url += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
      }
    });
  }
  return Cuspide.api.request(url, { auth: true });
}
function apiPost(path, action, body) {
  var base = (CONFIG.API_BASE_URL + path).replace(/\/+$/, '');
  return Cuspide.api.request(base + '/index.php?api=' + encodeURIComponent(action), { method: 'POST', auth: true, body: body });
}
function apiPut(path, action, body, params) {
  var base = (CONFIG.API_BASE_URL + path).replace(/\/+$/, '');
  var url  = base + '/index.php?api=' + encodeURIComponent(action);
  if (params) {
    Object.keys(params).forEach(function(k) {
      if (params[k] !== null && params[k] !== undefined) {
        url += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
      }
    });
  }
  return Cuspide.api.request(url, { method: 'PUT', auth: true, body: body });
}

/* ── XSS escape ── */
function esc(v) {
  return String(v === null || v === undefined ? '' : v)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function val(v, fallback) { return (v !== null && v !== undefined && v !== '') ? v : (fallback || '—'); }

/* ── Toast ── */
function showToast(msg, type) {
  type = type || 'success';
  var icons = { success: 'check-circle-fill', danger: 'x-circle-fill', warning: 'exclamation-triangle-fill', info: 'info-circle-fill' };
  var toast = document.createElement('div');
  toast.className = 'toast align-items-center border-0 text-white bg-' + type + ' show';
  toast.role = 'alert';
  toast.innerHTML =
    '<div class="d-flex"><div class="toast-body">' +
    '<i class="bi bi-' + (icons[type] || 'info-circle-fill') + ' me-2"></i>' + esc(msg) +
    '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
  var c = document.getElementById('toast-container');
  if (c) c.appendChild(toast);
  setTimeout(function() { toast.remove(); }, 4000);
}

/* ── Debounce ── */
function debounce(fn, ms) {
  var t;
  return function() {
    var args = arguments;
    clearTimeout(t);
    t = setTimeout(function() { fn.apply(null, args); }, ms);
  };
}

/* ── Búsqueda de personas ── */
var doSearch = debounce(function(q) {
  if (q.length < 2) {
    renderTable([]);
    document.getElementById('personas-info').textContent = 'Ingresa al menos 2 caracteres.';
    return;
  }
  document.getElementById('search-spinner-wrap').classList.remove('d-none');
  apiGet(CONFIG.ENDPOINTS.personas, 'search', { q: q })
    .then(function(data) {
      renderTable(Array.isArray(data) ? data : []);
    })
    .catch(function(err) {
      showToast(err.message || 'Error al buscar personas.', 'danger');
      renderTable([]);
    })
    .finally(function() {
      document.getElementById('search-spinner-wrap').classList.add('d-none');
    });
}, 350);

function renderTable(items) {
  var tbody = document.getElementById('personas-tbody');
  var info  = document.getElementById('personas-info');
  if (!items || items.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-5">' +
      '<i class="bi bi-person-x fs-2 d-block mb-2 opacity-25"></i>Sin resultados.</td></tr>';
    if (info) info.textContent = 'Sin coincidencias.';
    return;
  }
  if (info) info.textContent = items.length + ' persona(s) encontrada(s).';
  tbody.innerHTML = items.map(function(p) {
    return '<tr>' +
      '<td><code>' + esc(p.identificacion) + '</code></td>' +
      '<td class="fw-semibold">' + esc(p.nombre_completo) + '</td>' +
      '<td><span class="badge rounded-pill" style="background:var(--app-surface-soft);color:var(--app-text-soft);border:1px solid var(--app-border);">' + esc(p.tipo) + '</span></td>' +
      '<td class="text-muted small">' + esc(p.institucion) + '</td>' +
      '<td class="text-end pe-3">' +
        '<button type="button" class="btn btn-sm btn-outline-primary" onclick="loadPersonaDetail(' + p.id + ', \'' + esc(p.nombre_completo) + '\', \'' + esc(p.tipo) + '\', \'' + esc(p.identificacion) + '\', \'' + esc(p.institucion) + '\')">' +
          '<i class="bi bi-eye me-1"></i>Ver</button>' +
      '</td>' +
    '</tr>';
  }).join('');
}

/* ── Cargar detalle de persona ── */
function loadPersonaDetail(id, nombre, tipo, cedula, institucion) {
  currentPersonaId = id;

  document.getElementById('detail-nombre').textContent    = nombre;
  document.getElementById('detail-tipo').textContent      = tipo;
  document.getElementById('detail-cedula').textContent    = cedula;
  document.getElementById('detail-institucion').textContent = institucion;
  document.getElementById('detail-avatar').textContent    = (nombre.charAt(0) || '?').toUpperCase();

  var card = document.getElementById('persona-detail-card');
  card.classList.remove('d-none');
  document.getElementById('detail-loading').classList.remove('d-none');
  document.getElementById('detail-tabs-wrapper').classList.add('d-none');

  card.scrollIntoView({ behavior: 'smooth', block: 'start' });

  apiGet(CONFIG.ENDPOINTS.personas, 'sections', { id: id })
    .then(function(data) {
      currentSections = data;
      renderAllTabs(data);
      document.getElementById('detail-loading').classList.add('d-none');
      document.getElementById('detail-tabs-wrapper').classList.remove('d-none');
    })
    .catch(function(err) {
      document.getElementById('detail-loading').innerHTML =
        '<div class="alert alert-danger"><i class="bi bi-x-circle-fill me-2"></i>' + esc(err.message) + '</div>';
    });
}

/* ── Renderizar todas las tabs con datos ── */
function renderAllTabs(d) {
  renderPersonalTab(d.datos_personales);
  renderContactoTab(d.contacto);
  renderMedicoTab(d.medico);
  renderFisicoTab(d.fisico);
  renderRolesTab(d.roles_instituciones);
  renderMatriculasPTab(d.matriculas);
}

function infoRow(label, value) {
  return '<div class="col-md-4 col-sm-6 mb-3">' +
    '<div class="text-muted small mb-1">' + label + '</div>' +
    '<div class="fw-semibold">' + esc(val(value)) + '</div>' +
    '</div>';
}

function renderPersonalTab(p) {
  if (!p) { document.getElementById('tab-personal-view').innerHTML = '<p class="text-muted">Sin datos personales.</p>'; return; }
  var generoText = CATALOG.genero[String(p.genero && p.genero.id)] || val(p.genero && p.genero.id);
  var etniaText  = CATALOG.etnia[String(p.etnia && p.etnia.id)]   || val(p.etnia && p.etnia.id);
  var html = '<div class="row">' +
    infoRow('Identificación', p.identificacion) +
    infoRow('Primer Nombre', p.primer_nombre) +
    infoRow('Segundo Nombre', p.segundo_nombre) +
    infoRow('Primer Apellido', p.primer_apellido) +
    infoRow('Segundo Apellido', p.segundo_apellido) +
    infoRow('Fecha Nacimiento', p.fecha_nacimiento) +
    infoRow('Género', generoText) +
    infoRow('Etnia', etniaText) +
    infoRow('Dirección', p.direccion) +
    '</div>' +
    '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="editSection(\'personal\')"><i class="bi bi-pencil me-1"></i>Editar sección</button>';
  document.getElementById('tab-personal-view').innerHTML = html;

  var dp = p;
  setVal('e-identificacion', dp.identificacion);
  setVal('e-primer-nombre', dp.primer_nombre);
  setVal('e-segundo-nombre', dp.segundo_nombre);
  setVal('e-primer-apellido', dp.primer_apellido);
  setVal('e-segundo-apellido', dp.segundo_apellido);
  setVal('e-fecha-nacimiento', dp.fecha_nacimiento);
  setSelectVal('e-genero', dp.genero && dp.genero.id);
  setSelectVal('e-etnia', dp.etnia && dp.etnia.id);
  setVal('e-direccion', dp.direccion);
}

function renderContactoTab(c) {
  if (!c) { document.getElementById('tab-contacto-view').innerHTML = '<p class="text-muted">Sin datos de contacto.</p>'; return; }
  var tels = (c.telefonos || []).map(function(t) {
    return '<div class="d-flex align-items-center gap-3 py-2 border-bottom" style="border-color:var(--table-border) !important;">' +
      '<i class="bi bi-telephone-fill text-muted"></i>' +
      '<span class="fw-semibold">' + esc(t.numero) + '</span>' +
      '<span class="badge bg-secondary rounded-pill">' + esc(t.tipo) + '</span>' +
      '<span class="text-muted small">' + esc(t.operadora) + '</span>' +
      '</div>';
  }).join('') || '<p class="text-muted small">Sin teléfonos registrados.</p>';
  var mails = (c.correos || []).map(function(m) {
    return '<div class="d-flex align-items-center gap-3 py-2 border-bottom" style="border-color:var(--table-border) !important;">' +
      '<i class="bi bi-envelope-fill text-muted"></i>' +
      '<span class="fw-semibold">' + esc(m.email) + '</span>' +
      '<span class="badge bg-secondary rounded-pill">' + esc(m.tipo) + '</span>' +
      '</div>';
  }).join('') || '<p class="text-muted small">Sin correos registrados.</p>';
  document.getElementById('tab-contacto-view').innerHTML =
    '<h6 class="fw-semibold mb-2">Teléfonos</h6>' + tels +
    '<h6 class="fw-semibold mt-3 mb-2">Correos</h6>' + mails +
    '<div class="mt-3"><button type="button" class="btn btn-sm btn-outline-secondary" onclick="editSection(\'contacto\')"><i class="bi bi-pencil me-1"></i>Editar sección</button></div>';
}

function renderMedicoTab(m) {
  if (!m) { document.getElementById('tab-medico-view').innerHTML = '<p class="text-muted">Sin datos médicos.</p>'; return; }
  var html = '<div class="row">' +
    infoRow('Grupo Sanguíneo', m.grupo_sanguineo) +
    infoRow('Alergias', m.alergias) +
    infoRow('Enfermedades Preexistentes', m.enfermedades_preexistentes) +
    infoRow('Medicamentos Actuales', m.medicamentos_actuales) +
    infoRow('Contacto de Emergencia', m.contacto_emergencia_nombre) +
    infoRow('Teléfono de Emergencia', m.contacto_emergencia_telefono) +
    '</div>' +
    '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="editSection(\'medico\')"><i class="bi bi-pencil me-1"></i>Editar sección</button>';
  document.getElementById('tab-medico-view').innerHTML = html;

  setSelectVal('e-grupo-sanguineo', m.grupo_sanguineo);
  setVal('e-alergias', m.alergias);
  setVal('e-enfermedades', m.enfermedades_preexistentes);
  setVal('e-medicamentos', m.medicamentos_actuales);
  setVal('e-emergencia-nombre', m.contacto_emergencia_nombre);
  setVal('e-emergencia-tel', m.contacto_emergencia_telefono);
}

function renderFisicoTab(fisico) {
  var rows = (fisico || []).map(function(f) {
    return '<tr><td>' + esc(f.tipo_prenda) + '</td><td>' + esc(f.talla) + '</td><td>' +
      (f.medida_cm ? f.medida_cm + ' cm' : '—') + '</td><td>' + esc(f.fecha_medicion) + '</td></tr>';
  }).join('') || '<tr><td colspan="4" class="text-center text-muted py-3">Sin medidas registradas.</td></tr>';
  document.getElementById('tab-fisico-view').innerHTML =
    '<div class="table-responsive table-container"><table class="table table-hover align-middle mb-0">' +
    '<thead class="table-light"><tr><th>Prenda</th><th>Talla</th><th>Medida</th><th>Fecha</th></tr></thead>' +
    '<tbody>' + rows + '</tbody></table></div>';
}

function renderRolesTab(roles) {
  var rows = (roles || []).map(function(r) {
    var badge = r.estado ? '<span class="badge bg-success rounded-pill">Activo</span>' : '<span class="badge bg-secondary rounded-pill">Inactivo</span>';
    return '<tr><td class="fw-semibold">' + esc(r.tipo) + '</td><td>' + esc(r.institucion) + '</td><td>' + badge + '</td></tr>';
  }).join('') || '<tr><td colspan="3" class="text-center text-muted py-3">Sin roles registrados.</td></tr>';
  document.getElementById('tab-roles-view').innerHTML =
    '<div class="table-responsive table-container"><table class="table align-middle mb-0">' +
    '<thead class="table-light"><tr><th>Tipo</th><th>Institución</th><th>Estado</th></tr></thead>' +
    '<tbody>' + rows + '</tbody></table></div>';
}

function renderMatriculasPTab(mats) {
  var rows = (mats || []).map(function(m) {
    return '<tr><td><code>#' + esc(m.id) + '</code></td><td>' + esc(m.fecha_inicio) + '</td><td>' +
      esc(m.fecha_fin) + '</td><td>' + esc(m.institucion) + '</td>' +
      '<td><a href="/matriculas" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Ver</a></td></tr>';
  }).join('') || '<tr><td colspan="5" class="text-center text-muted py-3">Sin matrículas.</td></tr>';
  document.getElementById('tab-matp-view').innerHTML =
    '<div class="table-responsive table-container"><table class="table table-hover align-middle mb-0">' +
    '<thead class="table-light"><tr><th>#</th><th>Inicio</th><th>Fin</th><th>Institución</th><th></th></tr></thead>' +
    '<tbody>' + rows + '</tbody></table></div>';
}

/* ── Helpers de formulario ── */
function setVal(id, v) {
  var el = document.getElementById(id);
  if (el) el.value = (v !== null && v !== undefined) ? v : '';
}
function setSelectVal(id, v) {
  var el = document.getElementById(id);
  if (!el) return;
  var str = String(v === null || v === undefined ? '' : v);
  for (var i = 0; i < el.options.length; i++) {
    if (el.options[i].value === str) { el.selectedIndex = i; return; }
  }
}

/* ── Editar / Cancelar sección ── */
function editSection(section) {
  document.getElementById('tab-' + section + '-view').classList.add('d-none');
  document.getElementById('tab-' + section + '-form').classList.remove('d-none');
}
function cancelEdit(section) {
  document.getElementById('tab-' + section + '-form').classList.add('d-none');
  document.getElementById('tab-' + section + '-view').classList.remove('d-none');
}

/* ── Guardar sección: Personal ── */
document.getElementById('form-personal').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = this.querySelector('[type=submit]');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
  var body = {
    identificacion:  document.getElementById('e-identificacion').value.trim(),
    primer_nombre:   document.getElementById('e-primer-nombre').value.trim(),
    segundo_nombre:  document.getElementById('e-segundo-nombre').value.trim() || null,
    primer_apellido: document.getElementById('e-primer-apellido').value.trim(),
    segundo_apellido:document.getElementById('e-segundo-apellido').value.trim() || null,
    fecha_nacimiento:document.getElementById('e-fecha-nacimiento').value || null,
    genero:          parseInt(document.getElementById('e-genero').value) || null,
    etnia:           parseInt(document.getElementById('e-etnia').value) || null,
    direccion:       document.getElementById('e-direccion').value.trim() || null,
  };
  apiPut(CONFIG.ENDPOINTS.personas, 'save', body, { id: currentPersonaId })
    .then(function() {
      showToast('Datos personales actualizados.', 'success');
      cancelEdit('personal');
      reloadSections();
    })
    .catch(function(err) { showToast(err.message, 'danger'); })
    .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Guardar'; });
});

/* ── Guardar sección: Médico ── */
document.getElementById('form-medico').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = this.querySelector('[type=submit]');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
  var body = {
    grupo_sanguineo:              document.getElementById('e-grupo-sanguineo').value || null,
    alergias:                     document.getElementById('e-alergias').value.trim() || null,
