    '<div class="col-md-3"><select class="form-select" name="tel_op_' + idx + '"><option value="CLARO">Claro</option><option value="MOVISTAR">Movistar</option><option value="CNT">CNT</option><option value="OTRO">Otro</option></select></div>' +
    '<div class="col-md-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest(\'.tel-row\').remove()"><i class="bi bi-trash"></i></button></div>';
