{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'configuracion' %}

{% block title %}Configuración — Huaquillas F.C.{% endblock %}
{% block page_title %}Configuración{% endblock %}

{% block content %}
<div class="row g-4">

  <!-- ===== SECCIÓN 1: Perfil de usuario =====
       Datos cargados via JS fetch a ?api=profile:
       identificacion, primer_nombre, primer_apellido, tipo -->
  <div class="col-12 col-lg-6">
    <div class="card chart-card h-100">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-4"><i class="bi bi-person-fill me-2 text-primary"></i>Perfil de Usuario</h6>
        <div class="mb-3">
          <label class="form-label fw-semibold">Identificación</label>
          <input type="text" class="form-control" id="perfil-identificacion" value="—" readonly>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Primer Nombre</label>
          <input type="text" class="form-control" id="perfil-nombre" value="—" readonly>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Primer Apellido</label>
          <input type="text" class="form-control" id="perfil-apellido" value="—" readonly>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Tipo de usuario</label>
          <input type="text" class="form-control" id="perfil-tipo" value="—" readonly>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Contraseña actual</label>
          <input type="password" class="form-control" placeholder="••••••••">
        </div>
        <div class="mb-4">
          <label class="form-label fw-semibold">Nueva contraseña</label>
          <input type="password" class="form-control" placeholder="Nueva contraseña">
        </div>
        <button class="btn btn-brand"><i class="bi bi-check-lg me-1"></i>Guardar Cambios</button>
      </div>
    </div>
  </div>

  <!-- ===== SECCIÓN 2: Institución =====
       Datos cargados via JS fetch a ?api=institucion: nombre, logo -->
  <div class="col-12 col-lg-6">
    <div class="card chart-card h-100">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-4"><i class="bi bi-building me-2 text-primary"></i>Institución</h6>
        <div class="mb-3">
          <label class="form-label fw-semibold">Nombre de la institución</label>
          <input type="text" class="form-control" id="inst-nombre" value="—" readonly>
        </div>
        <div class="mb-4">
          <label class="form-label fw-semibold">Logo</label>
          <div id="inst-logo-container" class="mb-2">
            <!-- Logo cargado vía JS -->
          </div>
          <input type="file" class="form-control" accept="image/*">
          <div class="form-text">Formatos: PNG, JPG, SVG. Máx. 2 MB.</div>
        </div>

        <!-- Toggle de tema -->
        <h6 class="fw-bold mb-3 mt-4"><i class="bi bi-palette me-2 text-primary"></i>Tema de la interfaz</h6>
        <div class="d-flex gap-4 mb-4">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="tema" id="temaOscuro" value="dark" checked>
            <label class="form-check-label" for="temaOscuro">
              <i class="bi bi-moon-fill me-1"></i>Tema Oscuro
            </label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="tema" id="temaClaro" value="light">
            <label class="form-check-label" for="temaClaro">
              <i class="bi bi-sun-fill me-1"></i>Tema Claro
            </label>
          </div>
        </div>
        <button class="btn btn-brand"><i class="bi bi-check-lg me-1"></i>Guardar Preferencias</button>
      </div>
    </div>
  </div>

</div><!-- /row -->
{% endblock %}

{% block scripts %}
<script>
  // Sincronizar radio buttons de tema con el estado actual del localStorage
  document.addEventListener('DOMContentLoaded', function () {
    var temaActual = localStorage.getItem('theme');
    if (temaActual === 'light') {
      document.getElementById('temaClaro').checked = true;
    } else {
      document.getElementById('temaOscuro').checked = true;
    }

    document.getElementById('temaOscuro').addEventListener('change', function () {
      document.body.classList.remove('theme-light');
      localStorage.setItem('theme', 'dark');
      var icon = document.getElementById('theme-icon');
      if (icon) icon.className = 'bi bi-moon-fill';
    });

    document.getElementById('temaClaro').addEventListener('change', function () {
      document.body.classList.add('theme-light');
      localStorage.setItem('theme', 'light');
      var icon = document.getElementById('theme-icon');
      if (icon) icon.className = 'bi bi-sun-fill';
    });
  });

  /**
   * loadPerfil: llama a ?api=profile y rellena los campos de perfil de usuario.
   * Datos esperados: { identificacion, primer_nombre, primer_apellido, tipo }
   */
  async function loadPerfil() {
    try {
      const data = await window.Cuspide.api.profile();
      if (data && data.identificacion) {
        document.getElementById('perfil-identificacion').value = data.identificacion || '—';
        document.getElementById('perfil-nombre').value    = data.primer_nombre   || '—';
        document.getElementById('perfil-apellido').value  = data.primer_apellido || '—';
        document.getElementById('perfil-tipo').value      = data.tipo            || '—';
      }
    } catch (err) {
      // Silencioso: los campos quedan con el placeholder
    }
  }

  /**
   * loadInstitucionConfig: llama a ?api=institucion y rellena nombre e imagen.
   * Datos esperados: { nombre, logo }
   */
  async function loadInstitucionConfig() {
    try {
      const data = await window.Cuspide.api.institucion();
      if (data && data.nombre) {
        document.getElementById('inst-nombre').value = data.nombre || '—';
        if (data.logo) {
          document.getElementById('inst-logo-container').innerHTML =
            '<img src="' + data.logo + '" alt="Logo institución" style="max-height:60px;border-radius:8px;">';
        }
      }
    } catch (err) {
      // Silencioso
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    loadPerfil();
    loadInstitucionConfig();
  });
</script>
{% endblock %}
