{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'alumnos' %}

{% block title %}Alumnos — Huaquillas F.C.{% endblock %}
{% block page_title %}Alumnos{% endblock %}

{% block content %}

<div class="card chart-card mb-4">
  <div class="card-body p-4">

    <div class="d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-center gap-3 mb-4">
      <div>
        <h6 class="fw-bold mb-1">Buscar Alumno</h6>
        <p class="text-muted small mb-0">
          Busca por nombre, apellido o identificación. Si no existe, podrás registrarlo aquí mismo.
        </p>
      </div>
    </div>

    <!-- Buscador -->
    <div class="row g-3 align-items-end">
      <div class="col-12 col-lg-9">
        <label for="alumno-search" class="form-label fw-semibold">Buscar estudiante</label>
        <div class="input-group">
          <span class="input-group-text">
            <i class="bi bi-search"></i>
          </span>
          <input
            type="search"
            class="form-control"
            id="alumno-search"
            placeholder="Ej: Lionel, Messi, 1798736542"
            autocomplete="off"
          >
        </div>
      </div>

      <div class="col-12 col-lg-3">
        <button type="button" class="btn btn-outline-secondary w-100" id="btn-limpiar-busqueda">
          <i class="bi bi-x-circle me-1"></i>Limpiar
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Tabla de resultados -->
<div class="card chart-card mb-4" id="alumnos-list-card">
  <div class="card-body p-4">

    <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center gap-3 mb-4">
      <div>
        <h6 class="fw-bold mb-1">Lista de Alumnos</h6>
        <p class="text-muted small mb-0" id="alumnos-result-info">
          Ingresa un criterio de búsqueda para filtrar los estudiantes.
        </p>
      </div>
    </div>

    <div class="table-responsive table-container">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Identificación</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="alumnos-tbody">
          <tr>
            <td colspan="7" class="text-center text-muted py-4">
              <i class="bi bi-people me-2"></i>
              Los datos de alumnos se cargarán vía API próximamente.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</div>

<!-- Formulario nuevo estudiante -->
<div class="card chart-card d-none" id="nuevo-alumno-card">
  <div class="card-body p-4">

    <div class="alert alert-warning d-flex align-items-center" role="alert" id="nuevo-alumno-alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <div>
        No se encontraron coincidencias. Puedes registrar un nuevo estudiante.
      </div>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center gap-3 mb-4">
      <div>
        <h6 class="fw-bold mb-1">
          <i class="bi bi-person-plus-fill me-2"></i>Nuevo Estudiante
        </h6>
        <p class="text-muted small mb-0">
          Completa los datos del estudiante para registrarlo.
        </p>
      </div>
    </div>

    <form id="form-nuevo-alumno">
      <div class="row g-3">

        <div class="col-md-6">
          <label class="form-label fw-semibold" for="alumno-nombre">Primer Nombre</label>
          <input
            type="text"
            class="form-control"
            id="alumno-nombre"
            name="primer_nombre"
            placeholder="Ej: Juan"
            required
          >
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold" for="alumno-apellido">Primer Apellido</label>
          <input
            type="text"
            class="form-control"
            id="alumno-apellido"
            name="primer_apellido"
            placeholder="Ej: Pérez"
            required
          >
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold" for="alumno-identificacion">Identificación</label>
          <input
            type="text"
            class="form-control"
            id="alumno-identificacion"
            name="identificacion"
            placeholder="Ej: 0701234567"
            required
          >
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold" for="alumno-tipo">Tipo</label>
          <select class="form-select" id="alumno-tipo" name="tipo" required>
            <option value="">Seleccionar...</option>
            <option value="Alumno Regular">Alumno Regular</option>
            <option value="Socio">Socio</option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold" for="alumno-fecha">Fecha de nacimiento</label>
          <input
            type="date"
            class="form-control"
            id="alumno-fecha"
            name="fecha_nacimiento"
          >
        </div>

        <div class="col-md-6">
          <label class="form-label fw-semibold" for="alumno-estado">Estado</label>
          <select class="form-select" id="alumno-estado" name="estado">
            <option value="Activo">Activo</option>
            <option value="Inactivo">Inactivo</option>
          </select>
        </div>

      </div>

      <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-outline-secondary" id="btn-cancelar-nuevo-alumno">
          <i class="bi bi-arrow-left me-1"></i>Cancelar
        </button>

        <button type="submit" class="btn btn-brand">
          <i class="bi bi-check-lg me-1"></i>Guardar Estudiante
        </button>
      </div>
    </form>

  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
  /**
   * Datos temporales.
   * Cuando tengas API real, reemplaza este arreglo por la respuesta del backend.
   */
  var alumnos = [
    // Ejemplo:
     {
       id: 1,
       primer_nombre: 'Jhony',
       primer_apellido: 'Miñan',
       identificacion: '0987654321',
       tipo: 'Alumno Regular',
       estado: 'Activo'
     },
     {
       id: 2,
       primer_nombre: 'Pepito',
       primer_apellido: 'Andrade',
       identificacion: '0123459876',
       tipo: 'Alumno Regular',
       estado: 'Activo'
     },
     {
       id: 3,
       primer_nombre: 'Lionel',
       primer_apellido: 'Messi',
       identificacion: '0123456789',
       tipo: 'Alumno Regular',
       estado: 'Caducado'
     },
  ];

  document.addEventListener('DOMContentLoaded', function () {
    var searchInput = document.getElementById('alumno-search');
    var clearButton = document.getElementById('btn-limpiar-busqueda');
    var cancelButton = document.getElementById('btn-cancelar-nuevo-alumno');
    var form = document.getElementById('form-nuevo-alumno');

    renderAlumnos(alumnos, '');

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var query = searchInput.value.trim();
        var results = filterAlumnos(query);

        renderAlumnos(results, query);

        if (query.length > 0 && results.length === 0) {
          showNuevoAlumnoForm(query);
        } else if (alumnos.length === 0) {
          showNuevoAlumnoForm(query);
        } else {
          hideNuevoAlumnoForm();
        }
      });
    }

    if (clearButton) {
      clearButton.addEventListener('click', function () {
        searchInput.value = '';
        renderAlumnos(alumnos, '');
        if (alumnos.length === 0) {
          showNuevoAlumnoForm('');
        } else {
          hideNuevoAlumnoForm();
        }
        searchInput.focus();
      });
    }

    if (cancelButton) {
      cancelButton.addEventListener('click', function () {
        hideNuevoAlumnoForm();

        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }

        renderAlumnos(alumnos, '');
      });
    }

    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();

        var nuevoAlumno = {
          id: alumnos.length + 1,
          primer_nombre: document.getElementById('alumno-nombre').value.trim(),
          primer_apellido: document.getElementById('alumno-apellido').value.trim(),
          identificacion: document.getElementById('alumno-identificacion').value.trim(),
          tipo: document.getElementById('alumno-tipo').value,
          estado: document.getElementById('alumno-estado').value
        };

        /**
         * Aquí luego deberías llamar tu API, por ejemplo:
         *
         * await window.Cuspide.api.request('/app/controllers/api/alumnos/', {
         *   method: 'POST',
         *   auth: true,
         *   body: nuevoAlumno
         * });
         */

        alumnos.push(nuevoAlumno);

        form.reset();
        hideNuevoAlumnoForm();

        var searchInput = document.getElementById('alumno-search');
        if (searchInput) {
          searchInput.value = '';
        }

        renderAlumnos(alumnos, '');

        mostrarMensajeTemporal('Estudiante registrado correctamente.', 'success');
      });
    }
  });

  function filterAlumnos(query) {
    if (!query) {
      return alumnos;
    }

    var normalizedQuery = normalizeText(query);

    return alumnos.filter(function (alumno) {
      var searchable = [
        alumno.id,
        alumno.primer_nombre,
        alumno.primer_apellido,
        alumno.identificacion,
        alumno.tipo,
        alumno.estado
      ]
        .filter(Boolean)
        .join(' ');

      return normalizeText(searchable).includes(normalizedQuery);
    });
  }

  function renderAlumnos(items, query) {
    var tbody = document.getElementById('alumnos-tbody');
    var info = document.getElementById('alumnos-result-info');

    if (!tbody) return;

    if (!items || items.length === 0) {
      var message = query
        ? 'No se encontraron alumnos con "' + escapeHtml(query) + '".'
        : 'No hay alumnos registrados todavía.';

      tbody.innerHTML =
        '<tr>' +
          '<td colspan="7" class="text-center text-muted py-4">' +
            '<i class="bi bi-search me-2"></i>' +
            message +
          '</td>' +
        '</tr>';

      if (info) {
        info.textContent = query
          ? 'Sin coincidencias para la búsqueda actual.'
          : 'No hay alumnos registrados.';
      }

      showNuevoAlumnoForm(query || '');
      return;
    }

    tbody.innerHTML = items.map(function (alumno) {
      return (
        '<tr>' +
          '<td>' + escapeHtml(alumno.id || '') + '</td>' +
          '<td>' + escapeHtml(alumno.primer_nombre || '') + '</td>' +
          '<td>' + escapeHtml(alumno.primer_apellido || '') + '</td>' +
          '<td>' + escapeHtml(alumno.identificacion || '') + '</td>' +
          '<td>' + escapeHtml(alumno.tipo || '') + '</td>' +
          '<td>' +
            '<span class="badge rounded-pill ' + getEstadoBadgeClass(alumno.estado) + '">' +
              escapeHtml(alumno.estado || '—') +
            '</span>' +
          '</td>' +
          '<td>' +
            '<button type="button" class="btn btn-sm btn-outline-primary">' +
              '<i class="bi bi-eye me-1"></i>Ver' +
            '</button>' +
          '</td>' +
        '</tr>'
      );
    }).join('');

    if (info) {
      info.textContent = query
        ? items.length + ' coincidencia(s) encontrada(s).'
        : items.length + ' alumno(s) registrado(s).';
    }
  }

  function showNuevoAlumnoForm(query) {
    var card = document.getElementById('nuevo-alumno-card');
    var identificacionInput = document.getElementById('alumno-identificacion');

    if (card) {
      card.classList.remove('d-none');
    }

    /**
     * Si el usuario busca una identificación numérica,
     * se precarga en el formulario.
     */
    if (query && /^\d+$/.test(query) && identificacionInput && !identificacionInput.value) {
      identificacionInput.value = query;
    }
  }

  function hideNuevoAlumnoForm() {
    var card = document.getElementById('nuevo-alumno-card');

    if (card) {
      card.classList.add('d-none');
    }
  }

  function normalizeText(value) {
    return String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function getEstadoBadgeClass(estado) {
    var normalized = normalizeText(estado);

    if (normalized === 'activo') {
      return 'bg-success';
    }

    if (normalized === 'inactivo') {
      return 'bg-secondary';
    }

    return 'bg-light text-dark';
  }

  function mostrarMensajeTemporal(message, type) {
    var alert = document.createElement('div');

    alert.className = 'alert alert-' + (type || 'info') + ' alert-dismissible fade show mt-3';
    alert.role = 'alert';
    alert.innerHTML =
      '<i class="bi bi-check-circle-fill me-2"></i>' +
      escapeHtml(message) +
      '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>';

    var cardBody = document.querySelector('.card.chart-card .card-body');
    if (cardBody) {
      cardBody.appendChild(alert);

      setTimeout(function () {
        alert.classList.remove('show');
        setTimeout(function () {
          alert.remove();
        }, 200);
      }, 3000);
    }
  }
</script>
{% endblock %}