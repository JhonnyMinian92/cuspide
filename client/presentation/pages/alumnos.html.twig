{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'alumnos' %}

{% block title %}Alumnos — Huaquillas F.C.{% endblock %}
{% block page_title %}Alumnos{% endblock %}

{% block content %}
<div class="card chart-card">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h6 class="fw-bold mb-0">Lista de Alumnos</h6>
      <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#modalAlumno">
        <i class="bi bi-plus-lg me-1"></i>Añadir Alumno
      </button>
    </div>

    <!-- Los datos se cargarán via API en el futuro; por ahora se muestra tabla vacía -->
    <div class="table-responsive table-container">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Identificación</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="alumnos-tbody">
          <tr>
            <td colspan="7" class="text-center text-muted py-4">
              <i class="bi bi-people me-2"></i>
              Los datos de alumnos se cargarán via API próximamente.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Añadir Alumno -->
<div class="modal fade" id="modalAlumno" tabindex="-1" aria-labelledby="modalAlumnoLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="modalAlumnoLabel"><i class="bi bi-person-plus-fill me-2"></i>Añadir Alumno</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Primer Nombre</label>
            <input type="text" class="form-control" id="alumno-nombre" placeholder="Ej: Juan">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Primer Apellido</label>
            <input type="text" class="form-control" id="alumno-apellido" placeholder="Ej: Pérez">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Identificación</label>
            <input type="text" class="form-control" id="alumno-identificacion" placeholder="Ej: 0701234567">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Tipo</label>
            <select class="form-select" id="alumno-tipo">
              <option value="">Seleccionar...</option>
              <option>Alumno Regular</option>
              <option>Socio</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Fecha de nacimiento</label>
            <input type="date" class="form-control" id="alumno-fecha">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Estado</label>
            <select class="form-select" id="alumno-estado">
              <option>Activo</option>
              <option>Inactivo</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-brand" data-bs-dismiss="modal"><i class="bi bi-check-lg me-1"></i>Guardar</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}
