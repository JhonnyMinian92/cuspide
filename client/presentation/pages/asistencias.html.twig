{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'asistencias' %}
{% block title %}Asistencias y Permisos — SportAdmin{% endblock %}
{% block page_title %}Asistencias y Permisos{% endblock %}

{% block head %}
<style>
.attendance-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1rem;}
.attendance-list-row:hover{background:rgba(var(--bs-primary-rgb),.06);}
.toast-notification{position:fixed;top:1.2rem;right:1.2rem;z-index:9999;padding:.75rem 1rem;border-radius:.5rem;color:#fff;font-size:.9rem;opacity:0;transform:translateX(110%);transition:all .25s ease;max-width:340px;box-shadow:0 4px 20px rgba(0,0,0,.25);}
.toast-notification.show{opacity:1;transform:translateX(0);}
.toast-success{background:#198754;}.toast-error{background:#dc3545;}.toast-info{background:#0dcaf0;color:#212529;}
</style>
{% endblock %}

{% block content %}
<div class="row g-4">
  <div class="col-12">
    <div class="attendance-summary">
      <div class="card chart-card">
        <div class="card-body">
          <p class="text-muted small mb-1">Clases Activas</p>
          <h4 class="fw-bold mb-0" id="count-clases">0</h4>
        </div>
      </div>
      <div class="card chart-card">
        <div class="card-body">
          <p class="text-muted small mb-1">Actividades Activas</p>
          <h4 class="fw-bold mb-0" id="count-actividades">0</h4>
        </div>
      </div>
      <div class="card chart-card">
        <div class="card-body">
          <p class="text-muted small mb-1">Asistencias Registradas</p>
          <h4 class="fw-bold mb-0" id="count-asistencias">0</h4>
        </div>
      </div>
      <div class="card chart-card">
        <div class="card-body">
          <p class="text-muted small mb-1">Faltas Registradas</p>
          <h4 class="fw-bold mb-0" id="count-faltas">0</h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-7">
    <div class="card chart-card">
      <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
          <div>
            <h6 class="fw-bold mb-1">Control por Clase o Actividad</h6>
            <p class="text-muted small mb-0">Selecciona un grupo para registrar asistencia o permiso.</p>
          </div>
          <div class="d-flex gap-2 align-items-center flex-wrap">
            <select class="form-select form-select-sm" id="periodo-select" style="max-width:220px;">
              <option value="">Todos los períodos</option>
            </select>
            <div class="input-group" style="max-width:240px;">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input type="search" class="form-control" id="attendance-search" placeholder="Buscar..." autocomplete="off">
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Tipo</th>
                <th>Nombre</th>
                <th class="text-center">Matriculados</th>
                <th class="text-center">Asist.</th>
                <th class="text-center">Faltas</th>
                <th class="text-end">Acción</th>
              </tr>
            </thead>
            <tbody id="attendance-tbody">
              <tr>
                <td colspan="6" class="text-center text-muted py-5">
                  <span class="spinner-border spinner-border-sm me-2"></span>Cargando datos...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-5">
    <div class="card chart-card border-primary d-none" id="attendance-form-card">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-1" id="attendance-form-title">Registrar Asistencia</h6>
        <p class="text-muted small mb-3" id="attendance-form-subtitle">Seleccione una clase o actividad.</p>

        <form id="attendance-form" novalidate>
          <input type="hidden" id="attendance-target-id">
          <input type="hidden" id="attendance-target-type">
          <div class="row g-3">
            <div class="col-12 col-sm-6">
              <label class="form-label fw-semibold" for="attendance-matricula">Matrícula <span class="text-danger">*</span></label>
              <input type="number" class="form-control" id="attendance-matricula" min="1" required>
              <div class="invalid-feedback">Ingrese el ID de matrícula.</div>
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label fw-semibold" for="attendance-fecha">Fecha <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="attendance-fecha" required>
              <div class="invalid-feedback">Seleccione una fecha.</div>
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label fw-semibold" for="attendance-estado">Estado</label>
              <select class="form-select" id="attendance-estado">
                <option value="1">Presente</option>
                <option value="2">Falta</option>
                <option value="3">Permiso / Justificado</option>
              </select>
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label fw-semibold" for="attendance-horario">Horario</label>
              <input type="number" class="form-control" id="attendance-horario" min="1" placeholder="Opcional">
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label fw-semibold" for="attendance-entrada">Entrada</label>
              <input type="time" class="form-control" id="attendance-entrada">
            </div>
            <div class="col-12 col-sm-6">
              <label class="form-label fw-semibold" for="attendance-salida">Salida</label>
              <input type="time" class="form-control" id="attendance-salida">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold" for="attendance-observacion">Observación</label>
              <textarea class="form-control" id="attendance-observacion" rows="3" maxlength="250" placeholder="Motivo del permiso o detalle de la asistencia"></textarea>
            </div>
          </div>
          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check2-circle me-1"></i>Registrar
            </button>
            <button type="button" class="btn btn-outline-warning" id="btn-abrir-permiso">
              <i class="bi bi-calendar-x me-1"></i>Permiso
            </button>
            <button type="button" class="btn btn-outline-secondary" id="attendance-cancel">
              <i class="bi bi-x-lg me-1"></i>Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="alert alert-info mb-0" id="attendance-empty-form">
      Seleccione una clase o actividad para registrar asistencia, falta o permiso justificado.
    </div>
  </div>
</div>

<!-- Modal: Registrar Permiso -->
<div class="modal fade" id="modal-permiso" tabindex="-1" aria-labelledby="modal-permiso-label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-permiso-label">
          <i class="bi bi-calendar-x me-2 text-warning"></i>Registrar Permiso / Ausencia Justificada
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-3" id="permiso-context-label">Clase / Actividad seleccionada.</p>
        <form id="form-permiso" novalidate>
          <input type="hidden" id="permiso-target-id">
          <input type="hidden" id="permiso-target-type">

          <div class="row g-3 mb-3">
            <div class="col-12">
              <label class="form-label fw-semibold">Buscar Estudiante <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" id="permiso-search" placeholder="Nombre o cédula..." autocomplete="off">
                <span class="input-group-text d-none" id="permiso-search-spinner">
                  <span class="spinner-border spinner-border-sm"></span>
                </span>
              </div>
              <div id="permiso-search-results" class="d-none mt-1">
                <div class="list-group" id="permiso-search-list"></div>
              </div>
            </div>
            <div class="col-12">
              <div id="permiso-persona-info" class="d-none p-2 rounded" style="background:var(--app-surface-soft);border:1px solid var(--app-border);">
                <span class="fw-semibold" id="permiso-persona-nombre">—</span>
                <code class="ms-2 small" id="permiso-persona-ced">—</code>
                <input type="hidden" id="permiso-persona-id">
                <input type="hidden" id="permiso-matricula-id">
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label fw-semibold" for="permiso-fecha-inicio">Fecha Inicio <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="permiso-fecha-inicio" required>
              <div class="invalid-feedback">Seleccione la fecha de inicio.</div>
            </div>
            <div class="col-sm-6">
              <label class="form-label fw-semibold" for="permiso-fecha-fin">Fecha Fin <span class="text-danger">*</span></label>
              <input type="date" class="form-control" id="permiso-fecha-fin" required>
              <div class="invalid-feedback">Seleccione la fecha de fin.</div>
            </div>
            <div class="col-sm-6">
              <label class="form-label fw-semibold" for="permiso-horas">Horas por día <span class="text-muted small">(opcional)</span></label>
              <input type="number" class="form-control" id="permiso-horas" min="0.5" max="24" step="0.5" placeholder="Ej: 4.0">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold" for="permiso-motivo">Motivo <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="permiso-motivo" maxlength="250" required placeholder="Razón del permiso">
              <div class="invalid-feedback">El motivo es obligatorio.</div>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold" for="permiso-observacion">Observación <span class="text-muted small">(opcional)</span></label>
              <textarea class="form-control" id="permiso-observacion" rows="2" maxlength="500" placeholder="Detalles adicionales"></textarea>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-warning text-white fw-semibold" id="btn-guardar-permiso">
          <i class="bi bi-calendar-check me-1"></i>Registrar Permiso
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var records = [];
  var currentInstitution = null;

  function checkAuth() {
    if (!localStorage.getItem(CONFIG.STORAGE_KEYS.token)) {
      window.location.href = CONFIG.ROUTES.login;
    }
  }

  function toast(message, type) {
    var el = document.createElement('div');
    el.className = 'toast-notification toast-' + (type || 'info');
    el.textContent = message;
    document.body.appendChild(el);
    requestAnimationFrame(function () { el.classList.add('show'); });
    setTimeout(function () {
      el.classList.remove('show');
      setTimeout(function () { el.remove(); }, 250);
    }, 2600);
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function api(method, endpoint, action, body, params) {
    return Cuspide.api.call(method, CONFIG.ENDPOINTS[endpoint], action, body, params);
  }

  function render() {
    var query = document.getElementById('attendance-search').value.trim().toLowerCase();
    var tbody = document.getElementById('attendance-tbody');
    var filtered = records.filter(function (item) {
      return !query || item.nombre.toLowerCase().indexOf(query) !== -1 || item.tipo.toLowerCase().indexOf(query) !== -1;
    });

    if (!filtered.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-5">No se encontraron clases o actividades.</td></tr>';
      return;
    }

    tbody.innerHTML = filtered.map(function (item) {
      return '<tr class="attendance-list-row">' +
        '<td><span class="badge ' + (item.tipo === 'Clase' ? 'bg-primary' : 'bg-success') + '">' + item.tipo + '</span></td>' +
        '<td class="fw-semibold">' + escapeHtml(item.nombre) + '</td>' +
        '<td class="text-center">' + (item.matriculados || 0) + '</td>' +
        '<td class="text-center text-success fw-semibold">' + (item.asistencias || 0) + '</td>' +
        '<td class="text-center text-danger fw-semibold">' + (item.faltas || 0) + '</td>' +
        '<td class="text-end"><button class="btn btn-sm btn-outline-primary" data-attendance-id="' + item.id + '" data-attendance-type="' + item.apiType + '"><i class="bi bi-pencil-square me-1"></i>Registrar</button></td>' +
        '</tr>';
    }).join('');
  }

  function updateSummary() {
    var clases = records.filter(function (item) { return item.apiType === 'clase'; });
    var actividades = records.filter(function (item) { return item.apiType === 'actividad'; });
    var asistencias = records.reduce(function (sum, item) { return sum + (parseInt(item.asistencias || 0, 10) || 0); }, 0);
    var faltas = records.reduce(function (sum, item) { return sum + (parseInt(item.faltas || 0, 10) || 0); }, 0);
    document.getElementById('count-clases').textContent = clases.length;
    document.getElementById('count-actividades').textContent = actividades.length;
    document.getElementById('count-asistencias').textContent = asistencias;
    document.getElementById('count-faltas').textContent = faltas;
  }

  function openForm(id, type) {
    var item = records.find(function (record) { return String(record.id) === String(id) && record.apiType === type; });
    if (!item) return;
    document.getElementById('attendance-target-id').value = item.id;
    document.getElementById('attendance-target-type').value = item.apiType;
    document.getElementById('attendance-form-title').textContent = 'Registrar ' + item.tipo;
    document.getElementById('attendance-form-subtitle').textContent = item.nombre;
    document.getElementById('attendance-form-card').classList.remove('d-none');
    document.getElementById('attendance-empty-form').classList.add('d-none');
  }

  function closeForm() {
    document.getElementById('attendance-form').reset();
    document.getElementById('attendance-form').classList.remove('was-validated');
    document.getElementById('attendance-fecha').valueAsDate = new Date();
    document.getElementById('attendance-form-card').classList.add('d-none');
    document.getElementById('attendance-empty-form').classList.remove('d-none');
  }

  function loadInstitution() {
    if (currentInstitution) return Promise.resolve(currentInstitution);
    return api('GET', 'dashboard', 'stats', null, null).then(function (stats) {
      var instId = parseInt((stats && stats.institucion_id) || 0, 10);
      if (!instId) throw new Error('No se pudo determinar la institución.');
      currentInstitution = instId;
      return instId;
    });
  }

  function loadPeriodos() {
    return api('GET', 'periodos', 'list', null, null).then(function (items) {
      var sel = document.getElementById('periodo-select');
      var existing = sel.querySelectorAll('option:not([value=""])');
      existing.forEach(function (o) { o.remove(); });
      var list = Array.isArray(items) ? items : [];
      list.forEach(function (p) {
        var opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = escapeHtml(p.nombre);
        sel.appendChild(opt);
      });
    }).catch(function () {});
  }

  function loadData() {
    var periodoId = document.getElementById('periodo-select').value;
    var params = {};
    if (periodoId) params.periodo = periodoId;

    return loadInstitution().then(function (instId) {
      params.institucion = instId;
      return Promise.all([
        api('GET', 'clases', 'list', null, params),
        api('GET', 'actividades', 'list', null, params),
      ]);
    }).then(function (responses) {
      var clases = Array.isArray(responses[0]) ? responses[0] : (responses[0] && responses[0].items ? responses[0].items : []);
      var actividades = Array.isArray(responses[1]) ? responses[1] : (responses[1] && responses[1].items ? responses[1].items : []);
      records = clases.map(function (item) {
        return Object.assign({}, item, { tipo: 'Clase', apiType: 'clase' });
      }).concat(actividades.map(function (item) {
        return Object.assign({}, item, { tipo: 'Actividad', apiType: 'actividad' });
      }));
      updateSummary();
      render();
    }).catch(function (error) {
      document.getElementById('attendance-tbody').innerHTML = '<tr><td colspan="6" class="text-center text-danger py-5">' + escapeHtml(error.message || 'No se pudo cargar asistencias.') + '</td></tr>';
    });
  }

  document.addEventListener('click', function (event) {
    var btn = event.target.closest('[data-attendance-id]');
    if (btn) openForm(btn.getAttribute('data-attendance-id'), btn.getAttribute('data-attendance-type'));
  });

  document.getElementById('attendance-search').addEventListener('input', render);
  document.getElementById('periodo-select').addEventListener('change', loadData);
  document.getElementById('attendance-cancel').addEventListener('click', closeForm);

  document.getElementById('attendance-form').addEventListener('submit', function (event) {
    event.preventDefault();
    var form = event.currentTarget;
    form.classList.add('was-validated');
    if (!form.checkValidity()) return;

    var type = document.getElementById('attendance-target-type').value;
    var targetId = parseInt(document.getElementById('attendance-target-id').value, 10);
    var body = {
      matricula: parseInt(document.getElementById('attendance-matricula').value, 10),
      fecha: document.getElementById('attendance-fecha').value,
      estado: parseInt(document.getElementById('attendance-estado').value, 10),
      observacion: document.getElementById('attendance-observacion').value.trim(),
    };

    var horario = document.getElementById('attendance-horario').value;
    var entrada = document.getElementById('attendance-entrada').value;
    var salida = document.getElementById('attendance-salida').value;
    if (horario) body.horario = parseInt(horario, 10);
    if (entrada) body.hora_entrada = entrada;
    if (salida) body.hora_salida = salida;

    var endpoint = type === 'actividad' ? 'actividades' : 'clases';
    body[type === 'actividad' ? 'actividad' : 'clase'] = targetId;

    api('POST', endpoint, 'attendance', body, null)
      .then(function () {
        toast('Asistencia registrada correctamente.', 'success');
        closeForm();
        loadData();
      })
      .catch(function (error) {
        toast(error.message || 'No se pudo registrar la asistencia.', 'error');
      });
  });

  document.getElementById('attendance-fecha').valueAsDate = new Date();

  /* ── Permiso modal ── */
  var bsPermisoModal = null;
  var permisoSearchTimeout = null;

  function getPermisoModal() {
    if (!bsPermisoModal) bsPermisoModal = new bootstrap.Modal(document.getElementById('modal-permiso'));
    return bsPermisoModal;
  }

  document.getElementById('btn-abrir-permiso').addEventListener('click', function () {
    var targetId   = document.getElementById('attendance-target-id').value;
    var targetType = document.getElementById('attendance-target-type').value;
    var targetName = document.getElementById('attendance-form-subtitle').textContent;
    if (!targetId) { toast('Selecciona primero una clase o actividad.', 'error'); return; }

    document.getElementById('form-permiso').reset();
    document.getElementById('form-permiso').classList.remove('was-validated');
    document.getElementById('permiso-persona-info').classList.add('d-none');
    document.getElementById('permiso-search-results').classList.add('d-none');
    document.getElementById('permiso-target-id').value   = targetId;
    document.getElementById('permiso-target-type').value = targetType;
    document.getElementById('permiso-context-label').textContent =
      (targetType === 'actividad' ? 'Actividad' : 'Clase') + ': ' + targetName;
    document.getElementById('permiso-fecha-inicio').valueAsDate = new Date();
    document.getElementById('permiso-fecha-fin').valueAsDate    = new Date();
    getPermisoModal().show();
  });

  function permisoSearchPersona(q) {
    if (q.length < 2) {
      document.getElementById('permiso-search-results').classList.add('d-none');
      return;
    }
    document.getElementById('permiso-search-spinner').classList.remove('d-none');
    api('GET', 'personas', 'search', null, { q: q })
      .then(function (data) {
        var items = Array.isArray(data) ? data : [];
        var wrap  = document.getElementById('permiso-search-results');
        var list  = document.getElementById('permiso-search-list');
        if (!items.length) { wrap.classList.add('d-none'); return; }
        wrap.classList.remove('d-none');
        list.innerHTML = items.map(function (p) {
          return '<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between py-2" ' +
            'data-pid="' + p.id + '" data-pnombre="' + escapeHtml(p.nombre_completo) + '" data-pced="' + escapeHtml(p.identificacion) + '">' +
            '<span class="fw-semibold small">' + escapeHtml(p.nombre_completo) + '</span>' +
            '<code class="small">' + escapeHtml(p.identificacion) + '</code>' +
            '</button>';
        }).join('');
      })
      .catch(function () {})
      .finally(function () {
        document.getElementById('permiso-search-spinner').classList.add('d-none');
      });
  }

  document.getElementById('permiso-search').addEventListener('input', function () {
    clearTimeout(permisoSearchTimeout);
    permisoSearchTimeout = setTimeout(function () {
      permisoSearchPersona(document.getElementById('permiso-search').value.trim());
    }, 300);
  });

  document.getElementById('permiso-search-list').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-pid]');
    if (!btn) return;
    document.getElementById('permiso-persona-id').value      = btn.getAttribute('data-pid');
    document.getElementById('permiso-persona-nombre').textContent = btn.getAttribute('data-pnombre');
    document.getElementById('permiso-persona-ced').textContent   = btn.getAttribute('data-pced');
    document.getElementById('permiso-persona-info').classList.remove('d-none');
    document.getElementById('permiso-search-results').classList.add('d-none');
    document.getElementById('permiso-search').value = '';
  });

  document.getElementById('btn-guardar-permiso').addEventListener('click', function () {
    var form = document.getElementById('form-permiso');
    form.classList.add('was-validated');
    if (!form.checkValidity()) return;

    var personaId = document.getElementById('permiso-persona-id').value;
    if (!personaId) { toast('Selecciona un estudiante.', 'error'); return; }

    var targetId   = document.getElementById('permiso-target-id').value;
    var targetType = document.getElementById('permiso-target-type').value;
    var horas      = document.getElementById('permiso-horas').value;

    var body = {
      persona:      parseInt(personaId, 10),
      fecha_inicio: document.getElementById('permiso-fecha-inicio').value,
      fecha_fin:    document.getElementById('permiso-fecha-fin').value,
      motivo:       document.getElementById('permiso-motivo').value.trim(),
      observacion:  document.getElementById('permiso-observacion').value.trim() || null,
      horas_por_dia: horas ? parseFloat(horas) : null,
    };
    if (targetType === 'actividad') body.actividad = parseInt(targetId, 10);
    else body.clase = parseInt(targetId, 10);

    var btn = document.getElementById('btn-guardar-permiso');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

    api('POST', 'permisos', 'save', body, null)
      .then(function () {
        toast('Permiso registrado correctamente.', 'success');
        getPermisoModal().hide();
      })
      .catch(function (err) {
        toast(err.message || 'Error al registrar permiso.', 'error');
      })
      .finally(function () {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-calendar-check me-1"></i>Registrar Permiso';
      });
  });

  checkAuth();
  loadPeriodos();
  loadData();
})();
</script>
{% endblock %}
