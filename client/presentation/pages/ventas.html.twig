{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'ventas' %}
{% block title %}SportAdmin - Gestion Educativa{% endblock %}
{% block page_title %}Ventas{% endblock %}

{% block content %}
<style>
.toast-notification{position:fixed;top:1.2rem;right:1.2rem;z-index:1060;padding:.75rem 1.25rem;border-radius:.5rem;color:#fff;font-size:.9rem;opacity:0;transform:translateX(110%);transition:all .3s ease;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.4);}
.toast-notification.show{opacity:1;transform:translateX(0);}
.toast-success{background:#198754;}.toast-error{background:#dc3545;}.toast-warning{background:#ffc107;color:#212529;}
</style>

<div class="row g-4">
  <div class="col-12">

    <!-- Tabs de navegación -->
    <ul class="nav nav-pills mb-3 gap-1" id="ventas-tabs">
      <li class="nav-item">
        <button class="nav-link active" data-vtab="regulares">
          <i class="bi bi-receipt me-1"></i>Ventas Regulares
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link" data-vtab="externas">
          <i class="bi bi-bag-heart me-1"></i>Ventas Externas
        </button>
      </li>
    </ul>

    <!-- ── TAB: REGULARES ── -->
    <div id="vtab-regulares">
    <!-- Filtros y acciones -->
    <div class="card chart-card mb-4">
      <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
          <div>
            <h6 class="fw-bold mb-1">Gestión de Ventas</h6>
            <p class="text-muted small mb-0">Consulta el historial de ventas y registra nuevas transacciones.</p>
          </div>
          <button class="btn btn-brand flex-shrink-0" data-bs-toggle="modal" data-bs-target="#modal-venta">
            <i class="bi bi-plus-lg me-1"></i>Registrar Venta
          </button>
        </div>
        <div class="row g-3 align-items-end">
          <div class="col-12 col-md-5 col-lg-4">
            <label for="venta-search" class="form-label small">Buscar</label>
            <input type="search" class="form-control" id="venta-search" placeholder="Factura, cliente o cédula...">
          </div>
          <div class="col-md-3 col-lg-2">
            <label for="filtro-fecha-inicio" class="form-label small">Desde</label>
            <input type="date" class="form-control" id="filtro-fecha-inicio">
          </div>
          <div class="col-md-3 col-lg-2">
            <label for="filtro-fecha-fin" class="form-label small">Hasta</label>
            <input type="date" class="form-control" id="filtro-fecha-fin">
          </div>
        </div>
      </div>
    </div>

    <!-- Lista de ventas -->
    <div class="card chart-card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6 class="fw-bold mb-0">Historial de Ventas</h6>
          <small class="text-muted" id="ventas-info">Cargando...</small>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Tipo</th>
                <th class="text-end">Total</th>
                <th class="text-end">Saldo</th>
                <th class="text-center">Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody id="ventas-tbody">
              <!-- Filas se insertan con JS -->
            </tbody>
          </table>
        </div>
        <!-- Pagination -->
        <nav id="pagination-nav" class="mt-4 d-flex justify-content-center" aria-label="Navegación de ventas"></nav>
      </div>
    </div>
    </div><!-- /vtab-regulares -->

    <!-- ── TAB: EXTERNAS ── -->
    <div id="vtab-externas" class="d-none">

      <!-- Filtros y acciones externas -->
      <div class="card chart-card mb-4">
        <div class="card-body p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h6 class="fw-bold mb-1"><i class="bi bi-bag-heart me-2" style="color:var(--brand-color);"></i>Ventas Externas</h6>
              <p class="text-muted small mb-0">Ventas a clientes no registrados: fanáticos, visitantes y público en general.</p>
            </div>
            <button class="btn btn-brand flex-shrink-0" data-bs-toggle="modal" data-bs-target="#modal-venta-externa">
              <i class="bi bi-plus-lg me-1"></i>Nueva Venta Externa
            </button>
          </div>
          <div class="row g-3 align-items-end">
            <div class="col-12 col-md-5 col-lg-4">
              <label class="form-label small">Buscar</label>
              <input type="search" class="form-control" id="vext-search" placeholder="Factura o nombre de cliente...">
            </div>
            <div class="col-md-3 col-lg-2">
              <label class="form-label small">Desde</label>
              <input type="date" class="form-control" id="vext-desde">
            </div>
            <div class="col-md-3 col-lg-2">
              <label class="form-label small">Hasta</label>
              <input type="date" class="form-control" id="vext-hasta">
            </div>
          </div>
        </div>
      </div>

      <!-- Lista externas -->
      <div class="card chart-card">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Historial de Ventas Externas</h6>
            <small class="text-muted" id="vext-info">Cargando...</small>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Factura</th>
                  <th>Cliente</th>
                  <th class="text-end">Total</th>
                  <th class="text-end">Saldo</th>
                  <th class="text-center">Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody id="vext-tbody"></tbody>
            </table>
          </div>
          <nav id="vext-pagination" class="mt-4 d-flex justify-content-center"></nav>
        </div>
      </div>
    </div><!-- /vtab-externas -->

  </div>

</div>

<!-- Modal para ver detalle de venta -->
<div class="modal fade" id="modal-venta-detalle" tabindex="-1" aria-labelledby="modal-detalle-label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-detalle-label">Detalle de Venta</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="modal-detalle-body">
        <!-- Contenido inyectado por JS -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-outline-secondary" id="btn-imprimir-ticket" onclick="imprimirTicket()" disabled>
          <i class="bi bi-printer me-1"></i>Imprimir Ticket
        </button>
        <button type="button" class="btn btn-brand" id="btn-descargar-pdf" onclick="descargarPDF()" disabled>
          <i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Detalle Venta Externa -->
<div class="modal fade" id="modal-venta-ext-detalle" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-vext-detalle-label">Detalle Venta Externa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="modal-vext-detalle-body"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-outline-secondary" id="btn-imprimir-vext" onclick="imprimirTicketVext()" disabled>
          <i class="bi bi-printer me-1"></i>Imprimir Ticket
        </button>
        <button type="button" class="btn btn-brand" id="btn-pdf-vext" onclick="descargarPDFVext()" disabled>
          <i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Nueva Venta Externa -->
<div class="modal fade" id="modal-venta-externa" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-bag-heart me-2"></i>Nueva Venta Externa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- Cliente externo -->
        <h6 class="fw-bold mb-3">1. Datos del cliente <span class="text-muted fw-normal small">(opcional)</span></h6>
        <div class="row g-3 mb-4">
          <div class="col-12 col-sm-5">
            <label class="form-label fw-semibold">Nombre</label>
            <input type="text" class="form-control" id="vext-cliente-nombre" placeholder="Ej: Juan Pérez (opcional)">
          </div>
          <div class="col-12 col-sm-4">
            <label class="form-label fw-semibold">Cédula / ID</label>
            <input type="text" class="form-control" id="vext-cliente-cedula" placeholder="Opcional">
          </div>
          <div class="col-12 col-sm-3">
            <label class="form-label fw-semibold">Teléfono</label>
            <input type="text" class="form-control" id="vext-cliente-telefono" placeholder="Opcional">
          </div>
        </div>

        <!-- Productos -->
        <h6 class="fw-bold mb-3">2. Buscar producto</h6>
        <div class="input-group mb-2">
          <span class="input-group-text"><i class="bi bi-bag"></i></span>
          <input type="search" class="form-control" id="vext-producto-search" placeholder="Código o nombre del producto">
        </div>
        <div class="list-group mb-3 d-none" id="vext-producto-results"></div>

        <!-- Carrito externo -->
        <h6 class="fw-bold mb-3">3. Carrito</h6>
        <div class="table-responsive border rounded">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr><th class="ps-3">Producto</th><th style="width:90px;">Cant.</th><th class="text-end">Total</th><th class="pe-3"></th></tr>
            </thead>
            <tbody id="vext-cart-tbody"></tbody>
          </table>
        </div>
        <div class="d-flex justify-content-end align-items-center border-top pt-3 mt-3">
          <span class="fw-semibold me-3">Total</span>
          <span class="fs-4 fw-bold" id="vext-cart-total">$0.00</span>
        </div>

        <!-- Finalizar -->
        <h6 class="fw-bold mt-4 mb-3">4. Forma de pago</h6>
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Estado</label>
            <select class="form-select" id="vext-estado-pago">
              <option value="pendiente">Pendiente de Pago</option>
              <option value="pagada">Pagada</option>
            </select>
          </div>
          <div class="col-12 col-sm-6 d-none" id="vext-forma-group">
            <label class="form-label fw-semibold">Forma de Pago</label>
            <select class="form-select" id="vext-forma-pago"></select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Referencia</label>
            <input type="text" class="form-control" id="vext-referencia" placeholder="Ej: Efectivo, transferencia #123">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-brand" id="btn-registrar-vext">
          <i class="bi bi-check-lg me-1"></i>Registrar Venta Externa
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal para generar venta -->
<div class="modal fade" id="modal-venta" tabindex="-1" aria-labelledby="modal-venta-label" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-venta-label"><i class="bi bi-receipt me-2"></i>Generar Venta</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-4">
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">1. Buscar cliente</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person-search"></i></span>
              <input type="search" class="form-control" id="cliente-search" placeholder="Cédula o nombre">
            </div>
            <div class="list-group mt-2 d-none" id="cliente-results"></div>
            <div class="alert alert-success py-2 mt-2 mb-0 d-none" id="cliente-selected"></div>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">2. Buscar producto</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-bag"></i></span>
              <input type="search" class="form-control" id="producto-search" placeholder="Código o nombre">
            </div>
            <div class="list-group mt-2 d-none" id="producto-results"></div>
          </div>
        </div>

        <h6 class="fw-bold mt-4 mb-3">3. Carrito de Compra</h6>
        <div class="table-responsive border rounded">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr><th class="ps-3">Producto</th><th style="width:90px;">Cant.</th><th class="text-end">Total</th><th class="pe-3"></th></tr>
            </thead>
            <tbody id="cart-tbody">
              <!-- Filas del carrito se insertan con JS -->
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-end align-items-center border-top pt-3 mt-3">
          <span class="fw-semibold me-3">Total</span>
          <span class="fs-4 fw-bold" id="cart-total">$0.00</span>
        </div>

        <h6 class="fw-bold mt-4 mb-3">4. Finalizar Venta</h6>
        <div class="row g-3">
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Estado de la Venta</label>
            <select class="form-select" id="venta-estado-pago">
              <option value="pendiente">Pendiente de Pago</option>
              <option value="pagada">Pagada</option>
            </select>
          </div>
          <div class="col-12 col-sm-6" id="forma-pago-group" style="display: none;">
            <label class="form-label fw-semibold">Forma de Pago</label>
            <select class="form-select" id="venta-forma-pago">
              <!-- Opciones cargadas dinámicamente -->
            </select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Referencia</label>
            <input class="form-control" id="venta-referencia" placeholder="Ej: Transferencia #123">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-brand" id="btn-registrar-venta">
          <i class="bi bi-check-lg me-1"></i>Confirmar y Registrar Venta
        </button>
      </div>
    </div>
  </div>
</div>

<script>
var detalleVentaModal;
var currentDetalleData = null;
var instNombre = '';

/* --- Global Helper Functions --- */
function esc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]; }); }
function money(v) { return '$' + (parseFloat(v || 0)).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
function api(m, e, a, b, p) { return Cuspide.api.call(m, CONFIG.ENDPOINTS[e], a, b, p); }
function showToast(msg, type) { type = type || 'success'; var t = document.createElement('div'); t.className = 'toast-notification toast-' + type; t.textContent = msg; document.body.appendChild(t); setTimeout(function() { t.classList.add('show'); }, 10); setTimeout(function() { t.classList.remove('show'); setTimeout(function() { t.remove(); }, 300); }, 3200); }
var debounce = function(fn, ms) { var t; return function() { var a = arguments, ctx = this; clearTimeout(t); t = setTimeout(function() { fn.apply(ctx, a); }, ms); }; };

document.addEventListener('DOMContentLoaded', function() {
  Cuspide.api.institucion().then(function(d) { if (d && d.nombre) instNombre = d.nombre; }).catch(function() {});
  var institucionId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;
  var allProducts = [], cliente = null, cart = [], formasPagoList = [];
  var ventaModal = new bootstrap.Modal(document.getElementById('modal-venta'));
  var currentFilters = { page: 1, limit: 20, q: null, desde: null, hasta: null };

  function loadVentas(page = 1) {
    currentFilters.page = page;
    var tbody = document.getElementById('ventas-tbody');
    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>';
    var params = { institucion: institucionId, tipo: 'VENTA', ...currentFilters };
    api('GET', 'ventas', 'list', null, params).then(function(response) {
      renderVentas(response.items);
      renderPagination(response.currentPage, response.totalPages, response.totalItems);
    }).catch(function(err) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-danger text-center py-4">' + esc(err.message || 'Error al cargar ventas') + '</td></tr>';
    });
  }

  async function loadInitialData() {
    try {
      // Load products
      const productsData = await api('GET', 'productos', 'list', null, { institucion: institucionId });
      allProducts = Array.isArray(productsData) ? productsData : [];

      // Load payment methods (formas_pago)
      const formasPagoData = await api('GET', 'ventas', 'formas_pago', null, null);
      formasPagoList = Array.isArray(formasPagoData) ? formasPagoData : [];
      populateFormasPagoSelect();

    } catch (err) {
      showToast('Error al cargar datos iniciales: ' + (err.message || 'Desconocido'), 'error');
    }
  }

  function populateFormasPagoSelect() {
    var select = document.getElementById('venta-forma-pago');
    select.innerHTML = formasPagoList.map(fp => `<option value="${fp.id}">${esc(fp.nombre)}</option>`).join('');
    if (select.options.length > 0) select.value = formasPagoList[0].id; // Select first by default
  }

  function renderVentas(ventas) {
    var tbody = document.getElementById('ventas-tbody');
    if (!ventas.length) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No se encontraron ventas con los filtros aplicados.</td></tr>';
      return;
    }
    tbody.innerHTML = ventas.map(function(v) {
      let estadoBadgeHtml = '';
      let accionesHtml = '';

      if (v.estado === 2) { // Anulada
        estadoBadgeHtml = '<span class="badge bg-danger">Anulada</span>';
        accionesHtml = '<button type="button" class="btn btn-sm btn-outline-info" onclick="verDetalleVenta(' + v.id + ')"><i class="bi bi-eye me-1"></i>Ver</button>';
      } else { // Activa (Pagada o Pendiente)
        const pagada = parseFloat(v.saldo || 0) <= 0;
        estadoBadgeHtml = '<span class="badge ' + (pagada ? 'bg-success' : 'bg-warning text-dark') + '">' + (pagada ? 'Pagada' : 'Pendiente') + '</span>';
        accionesHtml = '<button type="button" class="btn btn-sm btn-outline-info" onclick="verDetalleVenta(' + v.id + ')"><i class="bi bi-eye me-1"></i>Ver</button> ' +
                       '<button type="button" class="btn btn-sm btn-outline-danger" onclick="anularVenta(' + v.id + ')"><i class="bi bi-trash me-1"></i>Anular</button>';
      }

      return '<tr>' +
        '<td><code>' + esc(v.numero) + '</code><br><small class="text-muted">' + esc(v.fecha.substring(0, 10)) + '</small></td>' +
        '<td>' + esc(v.nombre) + '<br><small class="text-muted">' + esc(v.identificacion) + '</small></td>' +
        '<td>' + esc(v.tipo) + '</td>' +
        '<td class="text-end fw-bold">' + money(v.total) + '</td>' +
        '<td class="text-end ' + (parseFloat(v.saldo || 0) <= 0 ? 'text-success' : 'text-warning') + '">' + money(v.saldo) + '</td>' +
        '<td class="text-center">' + estadoBadgeHtml + '</td>' +
        '<td class="text-end">' + accionesHtml + '</td>' +
      '</tr>';
    }).join('');
  }

  function renderPagination(currentPage, totalPages, totalItems) {
    var nav = document.getElementById('pagination-nav');
    var ventasInfo = document.getElementById('ventas-info');

    if (totalPages <= 1) {
      nav.innerHTML = '';
      ventasInfo.textContent = totalItems + ' registro(s)';
      return;
    }

    var startItem = (currentPage - 1) * currentFilters.limit + 1;
    var endItem = Math.min(startItem + currentFilters.limit - 1, totalItems);
    ventasInfo.textContent = 'Mostrando ' + startItem + '-' + endItem + ' de ' + totalItems + ' registros';

    var html = '<ul class="pagination">';

    html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="event.preventDefault(); loadVentas(' + (currentPage - 1) + ')">Anterior</a>' +
            '</li>';

    let startPage, endPage;
    if (totalPages <= 5) {
      startPage = 1;
      endPage = totalPages;
    } else {
      if (currentPage <= 3) {
        startPage = 1;
        endPage = 5;
      } else if (currentPage + 2 >= totalPages) {
        startPage = totalPages - 4;
        endPage = totalPages;
      } else {
        startPage = currentPage - 2;
        endPage = currentPage + 2;
      }
    }

    if (startPage > 1) {
      html += '<li class="page-item"><a class="page-link" href="#" onclick="event.preventDefault(); loadVentas(1)">1</a></li>';
      if (startPage > 2) {
        html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
      }
    }

    for (let i = startPage; i <= endPage; i++) {
      html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">' +
              '<a class="page-link" href="#" onclick="event.preventDefault(); loadVentas(' + i + ')">' + i + '</a>' +
              '</li>';
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) {
        html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
      }
      html += '<li class="page-item"><a class="page-link" href="#" onclick="event.preventDefault(); loadVentas(' + totalPages + ')">' + totalPages + '</a></li>';
    }

    html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="event.preventDefault(); loadVentas(' + (currentPage + 1) + ')">Siguiente</a>' +
            '</li>';

    html += '</ul>';
    nav.innerHTML = html;
  }

  var searchCliente = debounce(function(q) {
    var box=document.getElementById('cliente-results');
    if(q.length<2){box.classList.add('d-none');return;}
    api('GET','personas','search',null,{q:q}).then(function(items){
      box.classList.remove('d-none');
      box.innerHTML=(items||[]).slice(0,6).map(function(p){return '<button class="list-group-item list-group-item-action" data-cliente-id="'+p.id+'" data-cliente-name="'+esc(p.nombre_completo)+'">'+esc(p.nombre_completo)+'<br><small>'+esc(p.identificacion)+'</small></button>';}).join('')||'<div class="list-group-item text-muted">Sin resultados.</div>';
    });
  }, 350);

  var searchProducto = debounce(function(q) {
    var box=document.getElementById('producto-results');
    if(q.length<1){box.classList.add('d-none');return;}
    var rows=allProducts.filter(function(p){return [p.codigo,p.nombre].join(' ').toLowerCase().indexOf(q.toLowerCase())>-1;}).slice(0,8);
    box.classList.remove('d-none');
    box.innerHTML=rows.map(function(p){return '<button class="list-group-item list-group-item-action d-flex justify-content-between" data-prod-id="'+p.id+'"><span>'+esc(p.codigo)+' - '+esc(p.nombre)+'</span><strong>'+money(p.precio)+'</strong></button>';}).join('')||'<div class="list-group-item text-muted">Sin resultados.</div>';
  }, 300);

  function renderCart() {
    var total=cart.reduce(function(s,i){return s+(i.cantidad*i.precio_unitario);},0);
    document.getElementById('cart-total').textContent=money(total);
    document.getElementById('cart-tbody').innerHTML=cart.length?cart.map(function(i,idx){
      return '<tr><td class="ps-3">'+esc(i.descripcion)+'</td><td><input class="form-control form-control-sm" type="number" min="1" value="'+i.cantidad+'" data-cart-qty="'+idx+'"></td><td class="text-end">'+money(i.cantidad*i.precio_unitario)+'</td><td class="pe-3"><button class="btn btn-sm btn-outline-danger py-0 px-1" data-cart-del="'+idx+'"><i class="bi bi-x"></i></button></td></tr>';
    }).join(''):'<tr><td colspan="4" class="text-center text-muted py-3">Sin productos agregados.</td></tr>';
  }

  var doFilter = debounce(function() { loadVentas(1); }, 400);
  document.getElementById('venta-search').addEventListener('input', function() { currentFilters.q = this.value.trim(); doFilter(); });
  document.getElementById('filtro-fecha-inicio').addEventListener('change', function() { currentFilters.desde = this.value; doFilter(); });
  document.getElementById('filtro-fecha-fin').addEventListener('change', function() { currentFilters.hasta = this.value; doFilter(); });

  document.getElementById('cliente-search').addEventListener('input', function() { searchCliente(this.value.trim()); });
  document.getElementById('producto-search').addEventListener('input', function() { searchProducto(this.value.trim()); });

  document.getElementById('modal-venta').addEventListener('click', function(e) {
    var c = e.target.closest('[data-cliente-id]');
    if (c) {
      cliente = { id: parseInt(c.dataset.clienteId, 10), nombre: c.dataset.clienteName };
      document.getElementById('cliente-selected').innerHTML = '<i class="bi bi-person-check-fill me-2"></i>' + esc(cliente.nombre);
      document.getElementById('cliente-selected').classList.remove('d-none');
      document.getElementById('cliente-results').classList.add('d-none');
      document.getElementById('cliente-search').value = '';
    }
    var p = e.target.closest('[data-prod-id]');
    if (p) {
      var prod = allProducts.find(function(x) { return String(x.id) === String(p.dataset.prodId); });
      if (prod) {
        var existing = cart.find(function(item) { return item.producto_id === prod.id; });
        if (existing) { existing.cantidad++; }
        else { cart.push({ producto_id: prod.id, descripcion: prod.nombre, cantidad: 1, precio_unitario: parseFloat(prod.precio || 0), descuento: 0 }); }
        renderCart();
        document.getElementById('producto-results').classList.add('d-none');
        document.getElementById('producto-search').value = '';
      }
    }
  });

  document.getElementById('modal-venta').addEventListener('input', function(e) {
    if (e.target.matches('[data-cart-qty]')) { cart[parseInt(e.target.dataset.cartQty, 10)].cantidad = Math.max(1, parseFloat(e.target.value || 1)); renderCart(); }
  });
  document.getElementById('cart-tbody').addEventListener('click', function(e) {
    var del = e.target.closest('[data-cart-del]');
    if (del) { cart.splice(parseInt(del.dataset.cartDel, 10), 1); renderCart(); }
  });

  document.getElementById('btn-registrar-venta').addEventListener('click', function() {
    if (!cliente) { showToast('Debes seleccionar un cliente.', 'warning'); return; }
    if (!cart.length) { showToast('Debes agregar al menos un producto al carrito.', 'warning'); return; }
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Registrando...';

    var ventaEstadoPago = document.getElementById('venta-estado-pago').value;
    var ventaFormaPago = document.getElementById('venta-forma-pago').value;

    var body = {
      persona: cliente.id,
      institucion: institucionId,
      tipo: 'VENTA',
      items: cart,
      referencia: document.getElementById('venta-referencia').value.trim() || null
    };

    if (ventaEstadoPago === 'pagada') {
      if (!ventaFormaPago || formasPagoList.length === 0) {
        showToast('Debe seleccionar una forma de pago válida.', 'warning');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirmar y Registrar Venta';
        return;
      }
      body.forma_pago = parseInt(ventaFormaPago, 10);
    }

    api('POST', 'ventas', 'create', body, null).then(function() {
      showToast('Venta registrada exitosamente.', 'success');
      cart = []; cliente = null;
      renderCart();
      document.getElementById('cliente-selected').classList.add('d-none');
      document.getElementById('cliente-search').value = '';
      document.getElementById('venta-referencia').value = '';
      document.getElementById('venta-estado-pago').value = 'pendiente';
      document.getElementById('forma-pago-group').style.display = 'none';
      ventaModal.hide();
      loadVentas(1);
      loadInitialData(); // Recargar productos para actualizar stock si es necesario
    }).catch(function(err) {
      showToast(err.message || 'Error al registrar la venta.', 'error');
    }).finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirmar y Registrar Venta';
    });
  });

  document.getElementById('venta-estado-pago').addEventListener('change', function() {
    document.getElementById('forma-pago-group').style.display = (this.value === 'pagada') ? 'block' : 'none';
  });

  // Initialize the modal instance
  detalleVentaModal = new bootstrap.Modal(document.getElementById('modal-venta-detalle'));
  console.log('detalleVentaModal initialized:', detalleVentaModal); // Debug log
  checkAuth();
  loadVentas();
  loadInitialData();
  renderCart();
});

async function anularVenta(ventaId) {
  var r = await swConfirm(
    '¿Anular venta?',
    'Esta acción no se puede deshacer. Se anularán los pagos asociados y se revertirá el stock de los productos.',
    'Sí, anular'
  );
  if (!r.isConfirmed) return;
  try {
    showToast('Anulando venta...', 'info');
    await api('POST', 'ventas', 'cancel', null, { id: ventaId });
    showToast('Venta anulada correctamente.', 'success');
    loadVentas(currentFilters.page); // Recargar la página actual
  } catch (err) {
    showToast(err.message || 'Error al anular la venta.', 'error');
  }
}

async function verDetalleVenta(ventaId) {
  var modalBody = document.getElementById('modal-detalle-body');
  var modalTitle = document.getElementById('modal-detalle-label');
  modalBody.innerHTML = '<div class="text-center py-5"><span class="spinner-border text-primary"></span><p class="mt-2">Cargando detalle...</p></div>';
  modalTitle.innerHTML = 'Detalle de Venta';
  currentDetalleData = null;
  document.getElementById('btn-imprimir-ticket').disabled = true;
  document.getElementById('btn-descargar-pdf').disabled = true;

  if (!detalleVentaModal) {
    console.error("El modal de detalle no está inicializado.");
    return;
  }
  detalleVentaModal.show();

  try {
    const data = await Cuspide.api.call('GET', CONFIG.ENDPOINTS.ventas, 'detail', null, { id: ventaId });
    
    modalTitle.innerHTML = `Detalle de Venta: <code>${esc(data.venta.numero)}</code>`;

    let html = `
      <div class="row mb-3">
        <div class="col-md-6">
          <strong>Cliente:</strong><br> ${esc(data.cliente.nombre)}<br>
          <small class="text-muted">CI: ${esc(data.cliente.identificacion)}</small>
        </div>
        <div class="col-md-6 text-md-end">
          <strong>Fecha:</strong><br> ${esc(new Date(data.venta.fecha).toLocaleDateString())}
        </div>
      </div>
      
      <h6 class="fw-bold">Items de la Venta</h6>
      <div class="table-responsive border rounded mb-3">
        <table class="table table-sm table-striped mb-0">
          <thead class="table-light"><tr><th class="ps-3">Descripción</th><th>Cant.</th><th class="text-end">P. Unit.</th><th class="text-end pe-3">Subtotal</th></tr></thead>
          <tbody>
            ${data.detalles.map(d => `
              <tr>
                <td class="ps-3">${esc(d.descripcion)}</td>
                <td>${d.cantidad}</td>
                <td class="text-end">${money(d.precio_unitario)}</td>
                <td class="text-end pe-3">${money(d.subtotal)}</td>
              </tr>
            `).join('') || '<tr><td colspan="4" class="text-center text-muted">No hay items.</td></tr>'}
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-end mt-1">
        <table class="table table-sm mb-0" style="width:auto;min-width:260px;">
          <tbody>
            <tr><td class="text-muted">Subtotal:</td><td class="text-end ps-4">${money(data.venta.subtotal)}</td></tr>
            <tr><td class="text-muted">Descuento:</td><td class="text-end ps-4 text-danger">-${money(data.venta.descuento)}</td></tr>
            <tr><td class="text-muted">Impuesto:</td><td class="text-end ps-4">${money(data.venta.impuesto)}</td></tr>
            <tr style="border-top:2px solid var(--app-border);"><td class="fw-bold fs-5 pt-2">Total:</td><td class="text-end ps-4 fw-bold fs-5 pt-2">${money(data.venta.total)}</td></tr>
            <tr><td class="fw-semibold">Saldo Pendiente:</td><td class="text-end ps-4 fw-semibold ${parseFloat(data.venta.saldo) > 0 ? 'text-warning' : 'text-success'}">${parseFloat(data.venta.saldo) > 0 ? money(data.venta.saldo) : '✓ Pagado'}</td></tr>
          </tbody>
        </table>
      </div>
    `;

    if (data.pagos_aplicados && data.pagos_aplicados.length > 0) {
      html += `
        <hr>
        <h6 class="fw-bold mt-4">Pagos Aplicados</h6>
        <div class="table-responsive border rounded">
          <table class="table table-sm table-striped mb-0">
            <thead class="table-light"><tr><th class="ps-3">N° Pago</th><th>Fecha</th><th>Forma de Pago</th><th class="text-end pe-3">Monto</th></tr></thead>
            <tbody>
              ${data.pagos_aplicados.map(p => `
                <tr>
                  <td class="ps-3"><code>${esc(p.numero)}</code></td>
                  <td>${esc(new Date(p.fecha).toLocaleDateString())}</td>
                  <td>${esc(p.forma_pago)}</td>
                  <td class="text-end pe-3">${money(p.monto)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
    }
    currentDetalleData = data;
    document.getElementById('btn-imprimir-ticket').disabled = false;
    document.getElementById('btn-descargar-pdf').disabled = false;
    modalBody.innerHTML = html;
  } catch (err) {
    modalBody.innerHTML = '<div class="alert alert-danger">' + esc(err.message || 'Error al cargar el detalle.') + '</div>';
  }
}

function buildTicketHTML(d, isPDF) {
  var e2 = function(v) { return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];}); };
  var m2 = function(v) { return '$'+parseFloat(v||0).toFixed(2); };

  var itemsRows = (d.detalles||[]).map(function(it) {
    return '<tr><td class="desc">'+e2(it.descripcion)+'</td><td class="qty">x'+it.cantidad+'</td><td class="amt">'+m2(it.subtotal)+'</td></tr>';
  }).join('');

  var descLine = parseFloat(d.venta.descuento) > 0
    ? '<tr><td class="lbl">Descuento</td><td class="val">-'+m2(d.venta.descuento)+'</td></tr>' : '';

  var saldoLine = parseFloat(d.venta.saldo) > 0
    ? '<tr><td class="lbl warn">Saldo Pendiente</td><td class="val warn">'+m2(d.venta.saldo)+'</td></tr>'
    : '<tr><td colspan="2" style="text-align:center;color:#166534;font-weight:bold;padding-top:4px;">&#10003; PAGADO</td></tr>';

  var pagosHTML = '';
  if (d.pagos_aplicados && d.pagos_aplicados.length) {
    pagosHTML = '<hr class="div">'
      + d.pagos_aplicados.map(function(p) {
          return '<div class="row2"><span>'+e2(new Date(p.fecha).toLocaleDateString())+' · '+e2(p.forma_pago)+'</span><span>'+m2(p.monto)+'</span></div>';
        }).join('');
  }

  var fs = isPDF ? '15px' : '13px';
  var w  = isPDF ? '180mm' : '80mm';
  var pg = isPDF ? '@page{size:A4 portrait;margin:15mm;}' : '@page{size:88mm auto;margin:4mm;}';

  return '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>'+e2(d.venta.numero)+'</title>'
    +'<style>*{box-sizing:border-box;margin:0;padding:0;}'
    +'body{font-family:"Courier New",Courier,monospace;font-size:'+fs+';background:#fff;color:#111;}'
    +'.ticket{width:'+w+';margin:0 auto;padding:'+(isPDF?'10mm 8mm':'5mm 4mm')+';}'
    +'.center{text-align:center;} .title{font-size:'+(isPDF?'26px':'16px')+';font-weight:bold;letter-spacing:2px;}'
    +'.sub{font-size:'+(isPDF?'13px':'11px')+';letter-spacing:1px;margin-top:3px;}'
    +'hr.div{border:none;border-top:1px dashed #777;margin:'+(isPDF?'8px 0':'6px 0')+';}'
    +'.row2{display:flex;justify-content:space-between;margin:'+(isPDF?'4px 0':'2px 0')+';}'
    +'table{width:100%;border-collapse:collapse;}'
    +'.desc{width:55%;} .qty{width:12%;text-align:center;} .amt{width:33%;text-align:right;}'
    +'td{padding:'+(isPDF?'4px 0':'2px 0')+';vertical-align:top;}'
    +'.lbl{text-align:left;} .val{text-align:right;}'
    +'.total-row td{font-size:'+(isPDF?'20px':'14px')+';font-weight:bold;border-top:1px solid #000;padding-top:5px;}'
    +'.warn{color:#92400e;font-weight:bold;}'
    +'.footer{text-align:center;margin-top:12px;font-size:'+(isPDF?'13px':'11px')+';}'
    +pg+'@media print{button{display:none!important;}}</style>'
    +'</head><body><div class="ticket">'
    +'<div class="center"><div class="title">'+e2(String(instNombre).toUpperCase())+'</div><div class="sub">TICKET DE VENTA</div></div>'
    +'<hr class="div">'
    +'<div class="row2"><span><b>N°:</b></span><span>'+e2(d.venta.numero)+'</span></div>'
    +'<div class="row2"><span><b>Fecha:</b></span><span>'+e2(new Date(d.venta.fecha).toLocaleDateString())+'</span></div>'
    +'<div class="row2"><span><b>Cliente:</b></span><span>'+e2(d.cliente.nombre)+'</span></div>'
    +'<div class="row2"><span><b>CI:</b></span><span>'+e2(d.cliente.identificacion)+'</span></div>'
    +'<hr class="div">'
    +'<table><tbody>'+itemsRows+'</tbody></table>'
    +'<hr class="div">'
    +'<table><tbody>'
    +'<tr><td class="lbl">Subtotal</td><td class="val">'+m2(d.venta.subtotal)+'</td></tr>'
    +descLine
    +'<tr><td class="lbl">Impuesto</td><td class="val">'+m2(d.venta.impuesto)+'</td></tr>'
    +'<tr class="total-row"><td class="lbl">TOTAL</td><td class="val">'+m2(d.venta.total)+'</td></tr>'
    +saldoLine
    +'</tbody></table>'
    +pagosHTML
    +'<div class="footer">&#9474; ¡Gracias por su compra! &#9474;</div>'
    +'</div></body></html>';
}

function imprimirTicket() {
  if (!currentDetalleData) return;
  var win = window.open('', '_blank', 'width=420,height=700,scrollbars=yes');
  win.document.write(buildTicketHTML(currentDetalleData, false));
  win.document.close();
  win.focus();
  setTimeout(function() { win.print(); }, 350);
}

function descargarPDF() {
  if (!currentDetalleData) return;
  var win = window.open('', '_blank', 'width=700,height=900,scrollbars=yes');
  win.document.write(buildTicketHTML(currentDetalleData, true));
  win.document.close();
  win.focus();
  setTimeout(function() { win.print(); }, 350);
}

/* ═══════════════════════════════════════════════════
   VENTAS EXTERNAS
═══════════════════════════════════════════════════ */
var vextCart = [];
var vextFilters = { page: 1, limit: 20, q: null, desde: null, hasta: null };
var currentVextData = null;
var vextDetalleModal;

/* Tabs de navegación */
document.querySelectorAll('[data-vtab]').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('[data-vtab]').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var tab = btn.getAttribute('data-vtab');
    document.getElementById('vtab-regulares').classList.toggle('d-none', tab !== 'regulares');
    document.getElementById('vtab-externas').classList.toggle('d-none', tab !== 'externas');
    if (tab === 'externas') loadVentasExternas(1);
  });
});

/* Cargar lista externa */
function loadVentasExternas(page) {
  vextFilters.page = page || 1;
  var institucionId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;
  var tbody = document.getElementById('vext-tbody');
  tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>';
  var params = Object.assign({ institucion: institucionId }, vextFilters);
  api('GET', 'ventas', 'list_externas', null, params)
    .then(function(res) { renderVentasExternas(res.items); renderVextPagination(res.currentPage, res.totalPages, res.totalItems); })
    .catch(function(err) { tbody.innerHTML = '<tr><td colspan="6" class="text-danger text-center py-4">' + esc(err.message) + '</td></tr>'; });
}

function renderVentasExternas(items) {
  var tbody = document.getElementById('vext-tbody');
  document.getElementById('vext-info').textContent = (items.length ? '' : 'Sin registros');
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No se encontraron ventas externas.</td></tr>';
    return;
  }
  tbody.innerHTML = items.map(function(v) {
    var pagada = parseFloat(v.saldo || 0) <= 0;
    var estadoBadge = v.estado === 2
      ? '<span class="badge bg-danger">Anulada</span>'
      : '<span class="badge ' + (pagada ? 'bg-success' : 'bg-warning text-dark') + '">' + (pagada ? 'Pagada' : 'Pendiente') + '</span>';
    var acciones = v.estado === 2
      ? '<button class="btn btn-sm btn-outline-info" onclick="verDetalleVentaExterna(' + v.id + ')"><i class="bi bi-eye me-1"></i>Ver</button>'
      : '<button class="btn btn-sm btn-outline-info me-1" onclick="verDetalleVentaExterna(' + v.id + ')"><i class="bi bi-eye me-1"></i>Ver</button>'
        + '<button class="btn btn-sm btn-outline-danger" onclick="anularVentaExterna(' + v.id + ')"><i class="bi bi-trash me-1"></i>Anular</button>';
    return '<tr>'
      + '<td><code>' + esc(v.numero) + '</code><br><small class="text-muted">' + esc((v.fecha||'').substring(0,10)) + '</small></td>'
      + '<td>' + esc(v.cliente_nombre) + (v.cliente_identificacion ? '<br><small class="text-muted">' + esc(v.cliente_identificacion) + '</small>' : '') + '</td>'
      + '<td class="text-end fw-bold">' + money(v.total) + '</td>'
      + '<td class="text-end ' + (parseFloat(v.saldo||0) <= 0 ? 'text-success' : 'text-warning') + '">' + money(v.saldo) + '</td>'
      + '<td class="text-center">' + estadoBadge + '</td>'
      + '<td class="text-end">' + acciones + '</td>'
      + '</tr>';
  }).join('');
}

function renderVextPagination(currentPage, totalPages, totalItems) {
  var nav = document.getElementById('vext-pagination');
  document.getElementById('vext-info').textContent = totalItems + ' registro(s)';
  if (totalPages <= 1) { nav.innerHTML = ''; return; }
  var html = '<ul class="pagination">';
  html += '<li class="page-item ' + (currentPage===1?'disabled':'') + '"><a class="page-link" href="#" onclick="event.preventDefault();loadVentasExternas(' + (currentPage-1) + ')">Anterior</a></li>';
  for (var i = 1; i <= totalPages; i++) {
    html += '<li class="page-item ' + (i===currentPage?'active':'') + '"><a class="page-link" href="#" onclick="event.preventDefault();loadVentasExternas(' + i + ')">' + i + '</a></li>';
  }
  html += '<li class="page-item ' + (currentPage===totalPages?'disabled':'') + '"><a class="page-link" href="#" onclick="event.preventDefault();loadVentasExternas(' + (currentPage+1) + ')">Siguiente</a></li>';
  nav.innerHTML = html + '</ul>';
}

/* Filtros externos */
var doVextFilter = debounce(function() { loadVentasExternas(1); }, 400);
document.getElementById('vext-search').addEventListener('input', function() { vextFilters.q = this.value.trim() || null; doVextFilter(); });
document.getElementById('vext-desde').addEventListener('change', function() { vextFilters.desde = this.value || null; doVextFilter(); });
document.getElementById('vext-hasta').addEventListener('change', function() { vextFilters.hasta = this.value || null; doVextFilter(); });

/* Carrito externo */
function renderVextCart() {
  var total = vextCart.reduce(function(s, i) { return s + i.cantidad * i.precio_unitario; }, 0);
  document.getElementById('vext-cart-total').textContent = money(total);
  var tbody = document.getElementById('vext-cart-tbody');
  tbody.innerHTML = vextCart.length
    ? vextCart.map(function(i, idx) {
        return '<tr><td class="ps-3">' + esc(i.descripcion) + '</td>'
          + '<td><input class="form-control form-control-sm" type="number" min="1" value="' + i.cantidad + '" data-vext-qty="' + idx + '"></td>'
          + '<td class="text-end">' + money(i.cantidad * i.precio_unitario) + '</td>'
          + '<td class="pe-3"><button class="btn btn-sm btn-outline-danger py-0 px-1" data-vext-del="' + idx + '"><i class="bi bi-x"></i></button></td></tr>';
      }).join('')
    : '<tr><td colspan="4" class="text-center text-muted py-3">Sin productos.</td></tr>';
}

/* Búsqueda de productos para carrito externo */
document.addEventListener('DOMContentLoaded', function() {
  vextDetalleModal = new bootstrap.Modal(document.getElementById('modal-venta-ext-detalle'));

  /* Populate formas_pago en modal externo */
  api('GET', 'ventas', 'formas_pago', null, null).then(function(fps) {
    var sel = document.getElementById('vext-forma-pago');
    sel.innerHTML = (fps || []).map(function(f) { return '<option value="' + f.id + '">' + esc(f.nombre) + '</option>'; }).join('');
  });

  var allProds = [];
  api('GET', 'productos', 'list', null, { institucion: (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1 })
    .then(function(d) { allProds = Array.isArray(d) ? d : []; });

  var searchVextProd = debounce(function(q) {
    var box = document.getElementById('vext-producto-results');
    if (q.length < 1) { box.classList.add('d-none'); return; }
    var rows = allProds.filter(function(p) { return [p.codigo||'', p.nombre||''].join(' ').toLowerCase().indexOf(q.toLowerCase()) > -1; }).slice(0, 8);
    box.classList.remove('d-none');
    box.innerHTML = rows.map(function(p) {
      return '<button class="list-group-item list-group-item-action d-flex justify-content-between" data-vext-prod-id="' + p.id + '">'
        + '<span>' + esc(p.codigo) + ' - ' + esc(p.nombre) + '</span><strong>' + money(p.precio) + '</strong></button>';
    }).join('') || '<div class="list-group-item text-muted">Sin resultados.</div>';
  }, 300);

  document.getElementById('vext-producto-search').addEventListener('input', function() { searchVextProd(this.value.trim()); });

  document.getElementById('modal-venta-externa').addEventListener('click', function(e) {
    var p = e.target.closest('[data-vext-prod-id]');
    if (p) {
      var prod = allProds.find(function(x) { return String(x.id) === String(p.dataset.vextProdId); });
      if (prod) {
        var ex = vextCart.find(function(i) { return i.producto_id === prod.id; });
        if (ex) { ex.cantidad++; } else { vextCart.push({ producto_id: prod.id, descripcion: prod.nombre, cantidad: 1, precio_unitario: parseFloat(prod.precio || 0), descuento: 0 }); }
        renderVextCart();
        document.getElementById('vext-producto-results').classList.add('d-none');
        document.getElementById('vext-producto-search').value = '';
      }
    }
  });

  document.getElementById('vext-cart-tbody').addEventListener('input', function(e) {
    if (e.target.matches('[data-vext-qty]')) { vextCart[parseInt(e.target.dataset.vextQty)].cantidad = Math.max(1, parseFloat(e.target.value || 1)); renderVextCart(); }
  });
  document.getElementById('vext-cart-tbody').addEventListener('click', function(e) {
    var del = e.target.closest('[data-vext-del]');
    if (del) { vextCart.splice(parseInt(del.dataset.vextDel), 1); renderVextCart(); }
  });

  document.getElementById('vext-estado-pago').addEventListener('change', function() {
    document.getElementById('vext-forma-group').classList.toggle('d-none', this.value !== 'pagada');
  });

  /* Modal reset al abrir */
  document.getElementById('modal-venta-externa').addEventListener('show.bs.modal', function() {
    vextCart = [];
    renderVextCart();
    document.getElementById('vext-cliente-nombre').value = '';
    document.getElementById('vext-cliente-cedula').value = '';
    document.getElementById('vext-cliente-telefono').value = '';
    document.getElementById('vext-referencia').value = '';
    document.getElementById('vext-estado-pago').value = 'pendiente';
    document.getElementById('vext-forma-group').classList.add('d-none');
  });

  /* Registrar venta externa */
  document.getElementById('btn-registrar-vext').addEventListener('click', function() {
    var institucionId = (window.CUSPIDE_STATE && window.CUSPIDE_STATE.currentInstitucionId) || 1;
    if (!vextCart.length) { showToast('Agrega al menos un producto.', 'warning'); return; }
    var estadoPago = document.getElementById('vext-estado-pago').value;
    var formaPago  = estadoPago === 'pagada' ? parseInt(document.getElementById('vext-forma-pago').value) : null;
    var body = {
      institucion:            institucionId,
      cliente_nombre:         document.getElementById('vext-cliente-nombre').value.trim() || 'Anónimo',
      cliente_identificacion: document.getElementById('vext-cliente-cedula').value.trim()    || null,
      cliente_telefono:       document.getElementById('vext-cliente-telefono').value.trim() || null,
      items:       vextCart,
      forma_pago:  formaPago,
      referencia:  document.getElementById('vext-referencia').value.trim() || null,
    };
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Registrando...';
    api('POST', 'ventas', 'create_externa', body, null)
      .then(function(res) {
        showToast('Venta externa ' + res.numero + ' registrada correctamente.', 'success');
        bootstrap.Modal.getInstance(document.getElementById('modal-venta-externa')).hide();
        loadVentasExternas(1);
      })
      .catch(function(err) { showToast(err.message || 'Error al registrar.', 'error'); })
      .finally(function() { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Registrar Venta Externa'; });
  });
});

/* Ver detalle externa */
async function verDetalleVentaExterna(id) {
  var body  = document.getElementById('modal-vext-detalle-body');
  var label = document.getElementById('modal-vext-detalle-label');
  currentVextData = null;
  document.getElementById('btn-imprimir-vext').disabled = true;
  document.getElementById('btn-pdf-vext').disabled = true;
  body.innerHTML = '<div class="text-center py-5"><span class="spinner-border text-primary"></span></div>';
  vextDetalleModal.show();
  try {
    const d = await api('GET', 'ventas', 'detail_externa', null, { id: id });
    label.innerHTML = 'Venta Externa: <code>' + esc(d.venta.numero) + '</code>';
    var estadoBadge = d.venta.estado === 2
      ? '<span class="badge bg-danger ms-2">Anulada</span>'
      : parseFloat(d.venta.saldo) <= 0 ? '<span class="badge bg-success ms-2">Pagada</span>' : '<span class="badge bg-warning text-dark ms-2">Pendiente</span>';
    var html = '<div class="row mb-3">'
      + '<div class="col-md-6"><strong>Cliente:</strong><br>' + esc(d.cliente.nombre) + estadoBadge + (d.cliente.identificacion !== '—' ? '<br><small class="text-muted">CI: ' + esc(d.cliente.identificacion) + '</small>' : '') + (d.cliente.telefono !== '—' ? '<br><small class="text-muted"><i class="bi bi-telephone me-1"></i>' + esc(d.cliente.telefono) + '</small>' : '') + '</div>'
      + '<div class="col-md-6 text-md-end"><strong>Fecha:</strong><br>' + esc(new Date(d.venta.fecha).toLocaleDateString()) + (d.venta.forma_pago ? '<br><small class="text-muted">' + esc(d.venta.forma_pago) + '</small>' : '') + '</div>'
      + '</div>'
      + '<h6 class="fw-bold">Items</h6>'
      + '<div class="table-responsive border rounded mb-3"><table class="table table-sm table-striped mb-0">'
      + '<thead class="table-light"><tr><th class="ps-3">Descripción</th><th>Cant.</th><th class="text-end">P.Unit.</th><th class="text-end pe-3">Subtotal</th></tr></thead><tbody>'
      + (d.detalles || []).map(function(det) {
          return '<tr><td class="ps-3">' + esc(det.descripcion) + '</td><td>' + det.cantidad + '</td><td class="text-end">' + money(det.precio_unitario) + '</td><td class="text-end pe-3">' + money(det.subtotal) + '</td></tr>';
        }).join('') + '</tbody></table></div>'
      + '<div class="d-flex justify-content-end mt-1"><table class="table table-sm mb-0" style="width:auto;min-width:260px;"><tbody>'
      + '<tr><td class="text-muted">Subtotal:</td><td class="text-end ps-4">' + money(d.venta.subtotal) + '</td></tr>'
      + (parseFloat(d.venta.descuento) > 0 ? '<tr><td class="text-muted">Descuento:</td><td class="text-end ps-4 text-danger">-' + money(d.venta.descuento) + '</td></tr>' : '')
      + '<tr style="border-top:2px solid var(--app-border);"><td class="fw-bold fs-5 pt-2">Total:</td><td class="text-end ps-4 fw-bold fs-5 pt-2">' + money(d.venta.total) + '</td></tr>'
      + '<tr><td class="fw-semibold">Saldo:</td><td class="text-end ps-4 fw-semibold ' + (parseFloat(d.venta.saldo)>0?'text-warning':'text-success') + '">' + (parseFloat(d.venta.saldo)>0 ? money(d.venta.saldo) : '✓ Pagado') + '</td></tr>'
      + '</tbody></table></div>';
    currentVextData = d;
    document.getElementById('btn-imprimir-vext').disabled = false;
    document.getElementById('btn-pdf-vext').disabled = false;
    body.innerHTML = html;
  } catch (err) {
    body.innerHTML = '<div class="alert alert-danger">' + esc(err.message || 'Error al cargar.') + '</div>';
  }
}

/* Anular externa */
async function anularVentaExterna(id) {
  var r = await swConfirm('¿Anular venta externa?', 'El stock de los productos se restaurará.', 'Sí, anular');
  if (!r.isConfirmed) return;
  try {
    await api('POST', 'ventas', 'cancel_externa', { id: id }, null);
    showToast('Venta externa anulada.', 'success');
    loadVentasExternas(vextFilters.page);
  } catch (err) {
    showToast(err.message || 'Error al anular.', 'error');
  }
}

/* Ticket / PDF para venta externa */
function buildTicketVext(d, isPDF) {
  var e2 = function(v) { return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];}); };
  var m2 = function(v) { return '$'+parseFloat(v||0).toFixed(2); };
  var rows = (d.detalles||[]).map(function(it) { return '<tr><td class="desc">'+e2(it.descripcion)+'</td><td class="qty">x'+it.cantidad+'</td><td class="amt">'+m2(it.subtotal)+'</td></tr>'; }).join('');
  var fs = isPDF?'15px':'13px', w = isPDF?'180mm':'80mm', pg = isPDF?'@page{size:A4 portrait;margin:15mm;}':'@page{size:88mm auto;margin:4mm;}';
  return '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>'+e2(d.venta.numero)+'</title>'
    +'<style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:"Courier New",Courier,monospace;font-size:'+fs+';background:#fff;color:#111;}'
    +'.ticket{width:'+w+';margin:0 auto;padding:'+(isPDF?'10mm 8mm':'5mm 4mm')+';}.center{text-align:center;}'
    +'.title{font-size:'+(isPDF?'26px':'16px')+';font-weight:bold;letter-spacing:2px;}.sub{font-size:'+(isPDF?'13px':'11px')+';letter-spacing:1px;margin-top:3px;}'
    +'hr.div{border:none;border-top:1px dashed #777;margin:'+(isPDF?'8px 0':'6px 0')+';}.row2{display:flex;justify-content:space-between;margin:'+(isPDF?'4px 0':'2px 0')+';}'
    +'table{width:100%;border-collapse:collapse;}.desc{width:55%;}.qty{width:12%;text-align:center;}.amt{width:33%;text-align:right;}'
    +'td{padding:'+(isPDF?'4px 0':'2px 0')+';vertical-align:top;}.total-row td{font-size:'+(isPDF?'20px':'14px')+';font-weight:bold;border-top:1px solid #000;padding-top:5px;}'
    +'.footer{text-align:center;margin-top:12px;font-size:'+(isPDF?'13px':'11px')+';}'
    +pg+'@media print{button{display:none!important;}}</style></head><body><div class="ticket">'
    +'<div class="center"><div class="title">'+e2(String(instNombre).toUpperCase())+'</div><div class="sub">TICKET DE VENTA</div></div>'
    +'<hr class="div">'
    +'<div class="row2"><span><b>N°:</b></span><span>'+e2(d.venta.numero)+'</span></div>'
    +'<div class="row2"><span><b>Fecha:</b></span><span>'+e2(new Date(d.venta.fecha).toLocaleDateString())+'</span></div>'
    +'<div class="row2"><span><b>Cliente:</b></span><span>'+e2(d.cliente.nombre)+'</span></div>'
    +(d.cliente.identificacion!=='—'?'<div class="row2"><span><b>CI:</b></span><span>'+e2(d.cliente.identificacion)+'</span></div>':'')
    +(d.cliente.telefono!=='—'?'<div class="row2"><span><b>Tel:</b></span><span>'+e2(d.cliente.telefono)+'</span></div>':'')
    +'<hr class="div"><table><tbody>'+rows+'</tbody></table><hr class="div">'
    +'<table><tbody>'
    +(parseFloat(d.venta.descuento)>0?'<tr><td>Descuento</td><td style="text-align:right;">-'+m2(d.venta.descuento)+'</td></tr>':'')
    +'<tr class="total-row"><td>TOTAL</td><td style="text-align:right;">'+m2(d.venta.total)+'</td></tr>'
    +(parseFloat(d.venta.saldo)>0?'<tr><td style="color:#92400e;font-weight:bold;">Saldo</td><td style="text-align:right;color:#92400e;font-weight:bold;">'+m2(d.venta.saldo)+'</td></tr>':'<tr><td colspan="2" style="text-align:center;color:#166534;font-weight:bold;padding-top:4px;">✓ PAGADO</td></tr>')
    +'</tbody></table><div class="footer">| ¡Gracias por su compra! |</div></div></body></html>';
}

function imprimirTicketVext() {
  if (!currentVextData) return;
  var win = window.open('', '_blank', 'width=420,height=700,scrollbars=yes');
  win.document.write(buildTicketVext(currentVextData, false));
  win.document.close(); win.focus();
  setTimeout(function() { win.print(); }, 350);
}
function descargarPDFVext() {
  if (!currentVextData) return;
  var win = window.open('', '_blank', 'width=700,height=900,scrollbars=yes');
  win.document.write(buildTicketVext(currentVextData, true));
  win.document.close(); win.focus();
  setTimeout(function() { win.print(); }, 350);
}
</script>
{% endblock %}
