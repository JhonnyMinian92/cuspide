{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'ventas' %}
{% block title %}Ventas — Huaquillas F.C.{% endblock %}
{% block page_title %}Ventas{% endblock %}

{% block content %}
<div class="row g-4">
  <div class="col-12 col-xl-7">
    <div class="card chart-card mb-4">
      <div class="card-body p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
          <div>
            <h6 class="fw-bold mb-1">Ventas Registradas</h6>
            <p class="text-muted small mb-0" id="ventas-info">Cargando ventas...</p>
          </div>
          <div class="input-group" style="max-width:340px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" id="venta-search" placeholder="Factura, cliente o cédula">
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Tipo</th>
                <th class="text-end">Total</th>
                <th class="text-end">Saldo</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody id="ventas-tbody">
              <tr><td colspan="6" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-5">
    <div class="card chart-card">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-3">Generar Venta</h6>
        <div class="mb-3">
          <label class="form-label fw-semibold">Buscar cliente</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person-search"></i></span>
            <input type="search" class="form-control" id="cliente-search" placeholder="Cédula o nombre">
          </div>
          <div class="list-group mt-2 d-none" id="cliente-results"></div>
          <div class="alert alert-secondary py-2 mt-2 mb-0 d-none" id="cliente-selected"></div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Buscar producto</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-bag"></i></span>
            <input type="search" class="form-control" id="producto-search" placeholder="Código o nombre">
          </div>
          <div class="list-group mt-2 d-none" id="producto-results"></div>
        </div>

        <div class="table-responsive mb-3">
          <table class="table table-sm align-middle">
            <thead class="table-light">
              <tr><th>Producto</th><th style="width:86px;">Cant.</th><th class="text-end">Total</th><th></th></tr>
            </thead>
            <tbody id="cart-tbody">
              <tr><td colspan="4" class="text-center text-muted py-3">Sin productos agregados.</td></tr>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-between align-items-center border-top pt-3 mb-3">
          <span class="fw-semibold">Total</span>
          <span class="fs-5 fw-bold" id="cart-total">$0.00</span>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Estado de pago</label>
            <select class="form-select" id="venta-pago">
              <option value="pendiente">Pendiente</option>
              <option value="pagada">Pagada</option>
            </select>
          </div>
          <div class="col-12 col-sm-6">
            <label class="form-label fw-semibold">Referencia</label>
            <input class="form-control" id="venta-referencia" placeholder="Opcional">
          </div>
        </div>

        <button class="btn btn-brand w-100" id="btn-registrar-venta">
          <i class="bi bi-receipt me-1"></i>Registrar Venta
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var institucionId=(window.CUSPIDE_STATE&&window.CUSPIDE_STATE.currentInstitucionId)||1;
  var ventas=[], productos=[], cliente=null, cart=[];
  function money(v){return '$'+(parseFloat(v||0)).toFixed(2);}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];});}
  function api(m,e,a,b,p){return Cuspide.api.call(m,CONFIG.ENDPOINTS[e],a,b,p);}
  function toast(m){alert(m);}

  function loadVentas(){
    api('GET','ventas','list',null,{institucion:institucionId}).then(function(data){
      ventas=Array.isArray(data)?data:[]; renderVentas();
    }).catch(function(err){
      document.getElementById('ventas-tbody').innerHTML='<tr><td colspan="6" class="text-danger text-center py-4">'+esc(err.message||'Error al cargar ventas')+'</td></tr>';
    });
  }
  function renderVentas(){
    var q=document.getElementById('venta-search').value.toLowerCase();
    var rows=ventas.filter(function(v){return !q||[v.numero,v.nombre,v.identificacion,v.tipo].join(' ').toLowerCase().indexOf(q)>-1;});
    document.getElementById('ventas-info').textContent=rows.length+' venta(s).';
    document.getElementById('ventas-tbody').innerHTML=rows.length?rows.map(function(v){
      var pagada=parseFloat(v.saldo||0)<=0;
      return '<tr><td><code>'+esc(v.numero)+'</code></td><td>'+esc(v.nombre)+'<br><small class="text-muted">'+esc(v.identificacion)+'</small></td><td>'+esc(v.tipo)+'</td><td class="text-end">'+money(v.total)+'</td><td class="text-end">'+money(v.saldo)+'</td><td><span class="badge '+(pagada?'bg-success':'bg-warning text-dark')+'">'+(pagada?'Pagada':'Pendiente')+'</span></td></tr>';
    }).join(''):'<tr><td colspan="6" class="text-center text-muted py-4">Sin ventas.</td></tr>';
  }
  function loadProductos(){api('GET','productos','list',null,{institucion:institucionId}).then(function(data){productos=Array.isArray(data)?data:[];});}
  function searchCliente(q){
    var box=document.getElementById('cliente-results');
    if(q.length<2){box.classList.add('d-none');return;}
    api('GET','personas','search',null,{q:q}).then(function(items){
      box.classList.remove('d-none');
      box.innerHTML=(items||[]).slice(0,6).map(function(p){return '<button class="list-group-item list-group-item-action" data-cliente-id="'+p.id+'" data-cliente-name="'+esc(p.nombre_completo)+'">'+esc(p.nombre_completo)+'<br><small>'+esc(p.identificacion)+'</small></button>';}).join('')||'<div class="list-group-item text-muted">Sin resultados.</div>';
    });
  }
  function searchProducto(q){
    var box=document.getElementById('producto-results');
    if(q.length<1){box.classList.add('d-none');return;}
    var rows=productos.filter(function(p){return [p.codigo,p.nombre].join(' ').toLowerCase().indexOf(q.toLowerCase())>-1;}).slice(0,8);
    box.classList.remove('d-none');
    box.innerHTML=rows.map(function(p){return '<button class="list-group-item list-group-item-action d-flex justify-content-between" data-prod-id="'+p.id+'"><span>'+esc(p.codigo)+' - '+esc(p.nombre)+'</span><strong>'+money(p.precio)+'</strong></button>';}).join('')||'<div class="list-group-item text-muted">Sin resultados.</div>';
  }
  function renderCart(){
    var total=cart.reduce(function(s,i){return s+(i.cantidad*i.precio_unitario);},0);
    document.getElementById('cart-total').textContent=money(total);
    document.getElementById('cart-tbody').innerHTML=cart.length?cart.map(function(i,idx){
      return '<tr><td>'+esc(i.descripcion)+'</td><td><input class="form-control form-control-sm" type="number" min="1" value="'+i.cantidad+'" data-cart-qty="'+idx+'"></td><td class="text-end">'+money(i.cantidad*i.precio_unitario)+'</td><td><button class="btn btn-sm btn-outline-danger" data-cart-del="'+idx+'"><i class="bi bi-x"></i></button></td></tr>';
    }).join(''):'<tr><td colspan="4" class="text-center text-muted py-3">Sin productos agregados.</td></tr>';
  }
  document.getElementById('venta-search').addEventListener('input',renderVentas);
  document.getElementById('cliente-search').addEventListener('input',function(){searchCliente(this.value.trim());});
  document.getElementById('producto-search').addEventListener('input',function(){searchProducto(this.value.trim());});
  document.addEventListener('click',function(e){
    var c=e.target.closest('[data-cliente-id]'); if(c){cliente={id:parseInt(c.dataset.clienteId,10),nombre:c.dataset.clienteName};document.getElementById('cliente-selected').textContent='Cliente: '+cliente.nombre;document.getElementById('cliente-selected').classList.remove('d-none');document.getElementById('cliente-results').classList.add('d-none');}
    var p=e.target.closest('[data-prod-id]'); if(p){var prod=productos.find(function(x){return String(x.id)===String(p.dataset.prodId);}); if(prod){cart.push({producto_id:prod.id,descripcion:prod.nombre,cantidad:1,precio_unitario:parseFloat(prod.precio||0),descuento:0});renderCart();document.getElementById('producto-results').classList.add('d-none');document.getElementById('producto-search').value='';}}
    var del=e.target.closest('[data-cart-del]'); if(del){cart.splice(parseInt(del.dataset.cartDel,10),1);renderCart();}
  });
  document.addEventListener('input',function(e){if(e.target.matches('[data-cart-qty]')){cart[parseInt(e.target.dataset.cartQty,10)].cantidad=parseFloat(e.target.value||1);renderCart();}});
  document.getElementById('btn-registrar-venta').addEventListener('click',function(){
    if(!cliente){toast('Selecciona un cliente.');return;} if(!cart.length){toast('Agrega al menos un producto.');return;}
    var body={persona:cliente.id,institucion:institucionId,tipo:'VENTA',items:cart,referencia:document.getElementById('venta-referencia').value.trim()||null};
    if(document.getElementById('venta-pago').value==='pagada') body.forma_pago=1;
    api('POST','ventas','create',body,null).then(function(){toast('Venta registrada.');cart=[];cliente=null;renderCart();document.getElementById('cliente-selected').classList.add('d-none');loadVentas();loadProductos();}).catch(function(err){toast(err.message||'Error al registrar venta.');});
  });
  loadVentas(); loadProductos(); renderCart();
})();
</script>
{% endblock %}
