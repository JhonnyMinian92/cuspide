{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'inventario' %}

{% block title %}Inventario — Huaquillas F.C.{% endblock %}
{% block page_title %}Inventario{% endblock %}

{% block content %}
<div class="card chart-card">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h6 class="fw-bold mb-0">Lista de Inventario</h6>
      <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#modalInventario">
        <i class="bi bi-plus-lg me-1"></i>Añadir Ítem
      </button>
    </div>

    <!-- Los datos se cargarán via API en el futuro; por ahora se muestra tabla vacía -->
    <div class="table-responsive table-container">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Cantidad</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="inventario-tbody">
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              <i class="bi bi-box-seam me-2"></i>
              Los datos de inventario se cargarán via API próximamente.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Añadir Ítem -->
<div class="modal fade" id="modalInventario" tabindex="-1" aria-labelledby="modalInventarioLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="modalInventarioLabel"><i class="bi bi-box-seam-fill me-2"></i>Añadir Ítem</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Nombre del ítem</label>
          <input type="text" class="form-control" placeholder="Ej: Balones de fútbol">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Categoría</label>
          <select class="form-select">
            <option value="">Seleccionar...</option>
            <option>Equipamiento</option>
            <option>Entrenamiento</option>
            <option>Uniforme</option>
            <option>Salud</option>
            <option>Otros</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Cantidad</label>
          <input type="number" class="form-control" placeholder="0" min="0">
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Estado</label>
          <select class="form-select">
            <option>Disponible</option>
            <option>Bajo stock</option>
            <option>Agotado</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-brand" data-bs-dismiss="modal"><i class="bi bi-check-lg me-1"></i>Guardar</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}
