{% extends 'layouts/base.html.twig' %}
{% set currentPage = 'inventario' %}
{% block title %}Inventario — Huaquillas F.C.{% endblock %}
{% block page_title %}Inventario{% endblock %}

{% block content %}
<div class="row g-4">
  <div class="col-12 col-xl-8">
    <div class="card chart-card">
      <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
          <div class="d-flex align-items-center gap-3">
            <div>
              <h6 class="fw-bold mb-1">Control de Inventario</h6>
              <p class="text-muted small mb-0" id="inv-info">Cargando inventario...</p>
            </div>
            <a href="/productos" class="btn btn-sm btn-outline-primary" title="Ir al Catálogo de Productos">
              <i class="bi bi-box-seam me-1"></i> Catálogo
            </a>
          </div>
          <div class="input-group" style="max-width:340px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" id="inv-search" placeholder="Producto, código o categoría">
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr><th>Código</th><th>Producto</th><th>Categoría</th><th class="text-end">Stock</th><th class="text-end">Mínimo</th><th>Alerta</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody id="inventario-tbody">
              <tr><td colspan="7" class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm me-2"></span>Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-xl-4">
    <div class="card chart-card d-none" id="inv-form-card">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-1">Ajustar Stock</h6>
        <p class="text-muted small" id="inv-product-label">Seleccione un producto.</p>
        <form id="inv-form">
          <input type="hidden" id="inv-producto">
          <div class="mb-3">
            <label class="form-label fw-semibold">Movimiento</label>
            <select class="form-select" id="inv-tipo">
              <option value="ENTRADA">Entrada</option>
              <option value="SALIDA">Salida</option>
              <option value="AJUSTE">Ajuste exacto</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Cantidad</label>
            <input type="number" min="1" step="1" class="form-control" id="inv-cantidad" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Referencia</label>
            <input class="form-control" id="inv-referencia" placeholder="Compra, conteo, devolución...">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Observación</label>
            <textarea class="form-control" id="inv-observacion" rows="3"></textarea>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-brand" type="submit"><i class="bi bi-check-lg me-1"></i>Guardar</button>
            <button class="btn btn-outline-secondary" type="button" id="inv-cancel">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
    <div class="alert alert-info" id="inv-empty-form">Usa el botón ajustar de un producto para registrar entradas, salidas o conteos.</div>
  </div>
</div>

<script>
(function(){
  var institucionId=(window.CUSPIDE_STATE&&window.CUSPIDE_STATE.currentInstitucionId)||1, items=[];
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];});}
  function api(m,e,a,b,p){return Cuspide.api.call(m,CONFIG.ENDPOINTS[e],a,b,p);}
  function render(){
    var q=document.getElementById('inv-search').value.toLowerCase();
    var rows=items.filter(function(i){return !q||[i.codigo,i.nombre,i.categoria].join(' ').toLowerCase().indexOf(q)>-1;});
    document.getElementById('inv-info').textContent=rows.length+' producto(s) con control de stock.';
    document.getElementById('inventario-tbody').innerHTML=rows.length?rows.map(function(i){
      return '<tr><td><code>'+esc(i.codigo)+'</code></td><td class="fw-semibold">'+esc(i.nombre)+'</td><td>'+esc(i.categoria||'—')+'</td><td class="text-end">'+esc(i.stock_actual)+'</td><td class="text-end">'+esc(i.stock_minimo)+'</td><td>'+(i.alerta_stock?'<span class="badge bg-warning text-dark">Bajo stock</span>':'<span class="badge bg-success">OK</span>')+'</td><td class="text-end"><button class="btn btn-sm btn-outline-primary" data-adjust="'+i.id+'" data-name="'+esc(i.nombre)+'"><i class="bi bi-pencil-square me-1"></i>Ajustar</button></td></tr>';
    }).join(''):'<tr><td colspan="7" class="text-center text-muted py-4">Sin resultados.</td></tr>';
  }
  function load(){
    api('GET','inventario','list',null,{institucion:institucionId}).then(function(data){items=Array.isArray(data)?data:[];render();}).catch(function(err){document.getElementById('inventario-tbody').innerHTML='<tr><td colspan="7" class="text-center text-danger py-4">'+esc(err.message||'Error al cargar inventario')+'</td></tr>';});
  }
  document.getElementById('inv-search').addEventListener('input',render);
  document.addEventListener('click',function(e){var b=e.target.closest('[data-adjust]');if(!b)return;document.getElementById('inv-producto').value=b.dataset.adjust;document.getElementById('inv-product-label').textContent=b.dataset.name;document.getElementById('inv-form-card').classList.remove('d-none');document.getElementById('inv-empty-form').classList.add('d-none');});
  document.getElementById('inv-cancel').addEventListener('click',function(){document.getElementById('inv-form-card').classList.add('d-none');document.getElementById('inv-empty-form').classList.remove('d-none');document.getElementById('inv-form').reset();});
  document.getElementById('inv-form').addEventListener('submit',function(e){e.preventDefault();var body={producto:parseInt(document.getElementById('inv-producto').value,10),tipo_movimiento:document.getElementById('inv-tipo').value,cantidad:parseInt(document.getElementById('inv-cantidad').value,10),institucion:institucionId,referencia:document.getElementById('inv-referencia').value.trim()||null,observacion:document.getElementById('inv-observacion').value.trim()};api('POST','inventario','adjust',body,null).then(function(){alert('Inventario actualizado.');document.getElementById('inv-cancel').click();load();}).catch(function(err){alert(err.message||'Error al ajustar inventario.');});});
  load();
})();
</script>
{% endblock %}
