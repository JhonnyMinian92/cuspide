});

/* ── Init ── */
document.addEventListener('DOMContentLoaded', function() {
  if (!requireAuth()) return;
  loadRecentMatriculas();
  document.getElementById('mat-search').addEventListener('input', function() { doSearch(this.value.trim()); });
});
</script>
